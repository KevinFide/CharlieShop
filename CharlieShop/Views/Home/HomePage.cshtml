@{
    ViewData["Title"] = "Inicio";
    Layout = null;

    var nombreUsuario =
        User.FindFirst("NombreCompleto")?.Value
        ?? User.Identity?.Name
        ?? "Usuario";

    var rolUsuario =
        User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value
        ?? "GUEST";

    bool esAdministrador =
        User.IsInRole("ADMINISTRADOR");

    bool esVendedor =
        User.IsInRole("VENDEDOR");

    bool esGuest =
        User.IsInRole("GUEST");
}

<!DOCTYPE html>
<html lang="es">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>Charlie Shop - Inicio</title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

    <link rel="stylesheet"
          href="~/css/homepage.css"
          asp-append-version="true" />

</head>

<body>

    <div class="app-shell">

        <!-- ================================================= -->
        <!-- SIDEBAR -->
        <!-- ================================================= -->

        <aside class="sidebar">

            <!-- ================================================= -->
            <!-- BRAND -->
            <!-- ================================================= -->

            <div class="sidebar-brand">

                <div class="brand-logo">

                    <img src="~/images/charlie_shop_logo.png"
                         alt="Charlie Shop" />

                </div>

                <div class="brand-text">

                    <strong>
                        Charlie Shop
                    </strong>

                    <span>
                        Sistema Integral de Gestión Comercial
                    </span>

                </div>

            </div>


            <!-- ================================================= -->
            <!-- MENU TITLE -->
            <!-- ================================================= -->

            <div class="sidebar-title">
                MENÚ PRINCIPAL
            </div>


            <!-- ================================================= -->
            <!-- MENU -->
            <!-- ================================================= -->

            <nav class="sidebar-menu">

                <!-- INICIO - TODOS -->
                <a href="#"
                   class="menu-item active">

                    <i class="bi bi-house"></i>

                    <span>
                        Inicio
                    </span>

                </a>


                <!-- ================================================= -->
                <!-- ADMINISTRADOR -->
                <!-- ================================================= -->

                @if (esAdministrador)
                {

                    <!-- DASHBOARD -->

                    <a href="#"
                       class="menu-item">

                        <i class="bi bi-grid-1x2"></i>

                        <span>
                            Dashboard
                        </span>

                    </a>


                    <!-- USUARIOS -->

                    <a href="#"
                       class="menu-item">

                        <i class="bi bi-people"></i>

                        <span>
                            Usuarios
                        </span>

                    </a>


                    <!-- PRODUCTOS -->

                    <a href="#"
                       class="menu-item">

                        <i class="bi bi-box-seam"></i>

                        <span>
                            Productos
                        </span>

                    </a>


                    <!-- INVENTARIO -->

                    <a href="#"
                       class="menu-item">

                        <i class="bi bi-boxes"></i>

                        <span>
                            Inventario
                        </span>

                    </a>

                }


                <!-- ================================================= -->
                <!-- ADMINISTRADOR + VENDEDOR -->
                <!-- ================================================= -->

                @if (esAdministrador || esVendedor)
                {

                    <!-- VENTAS -->

                    <a href="#"
                       class="menu-item">

                        <i class="bi bi-cart3"></i>

                        <span>
                            Ventas
                        </span>

                    </a>


                    <!-- CLIENTES -->

                    <a href="#"
                       class="menu-item">

                        <i class="bi bi-person-vcard"></i>

                        <span>
                            Clientes
                        </span>

                    </a>


                    <!-- CUENTAS POR COBRAR -->

                    <a href="#"
                       class="menu-item">

                        <i class="bi bi-wallet2"></i>

                        <span>
                            Cuentas por cobrar
                        </span>

                    </a>

                }


                <!-- ================================================= -->
                <!-- ADMINISTRADOR -->
                <!-- ================================================= -->

                @if (esAdministrador)
                {

                    <!-- REPORTES -->

                    <a href="#"
                       class="menu-item">

                        <i class="bi bi-bar-chart"></i>

                        <span>
                            Reportes
                        </span>

                    </a>


                    <!-- ASISTENTE -->

                    <a href="#"
                       class="menu-item">

                        <i class="bi bi-stars"></i>

                        <span>
                            Asistente virtual
                        </span>

                        <span class="ai-badge">
                            IA
                        </span>

                    </a>

                }

            </nav>


            <!-- ================================================= -->
            <!-- SIDEBAR BOTTOM -->
            <!-- ================================================= -->

            <div class="sidebar-bottom">

                <div class="sidebar-divider"></div>


                <form asp-controller="Account"
                      asp-action="Logout"
                      method="post">

                    @Html.AntiForgeryToken()

                    <button type="submit"
                            class="menu-item logout"
                            style="width: 100%; border: none; background: transparent; text-align: left; cursor: pointer;">

                        <i class="bi bi-box-arrow-left"></i>

                        <span>
                            Cerrar sesión
                        </span>

                    </button>

                </form>

            </div>

        </aside>


        <!-- ================================================= -->
        <!-- CONTENIDO -->
        <!-- ================================================= -->

        <main class="main-content">


            <!-- ================================================= -->
            <!-- TOPBAR -->
            <!-- ================================================= -->

            <header class="topbar">

                <div class="breadcrumb">

                    <span>
                        Charlie Shop
                    </span>

                    <i class="bi bi-chevron-right"></i>

                    <strong>
                        Inicio
                    </strong>

                </div>


                <div class="topbar-right">

                    <button class="notification-button"
                            type="button">

                        <i class="bi bi-bell"></i>

                        <span></span>

                    </button>


                    <div class="topbar-line"></div>


                    <!-- ================================================= -->
                    <!-- USUARIO -->
                    <!-- ================================================= -->

                    <div class="user-profile">

                        <div class="user-avatar">

                            <i class="bi bi-person-fill"></i>

                        </div>


                        <div class="user-details">

                            <strong>
                                @nombreUsuario
                            </strong>

                            <span>
                                @rolUsuario
                            </span>

                        </div>


                        <i class="bi bi-chevron-down"></i>

                    </div>

                </div>

            </header>


            <!-- ================================================= -->
            <!-- PAGE -->
            <!-- ================================================= -->

            <div class="home-content">


                <!-- ================================================= -->
                <!-- HERO -->
                <!-- ================================================= -->

                <section class="hero">

                    <div class="hero-content">

                        <span class="hero-label">
                            SISTEMA DE GESTIÓN COMERCIAL
                        </span>


                        <h1>

                            Todo tu negocio,

                            <br />

                            <span>
                                en un solo lugar.
                            </span>

                        </h1>


                        <p>

                            Bienvenido a Charlie Shop. Administra tus ventas,
                            productos, clientes e inventario desde una
                            plataforma centralizada.

                        </p>


                        <div class="hero-actions">


                            <!-- SOLO ADMINISTRADOR -->

                            @if (esAdministrador)
                            {

                                <a href="#"
                                   class="primary-button">

                                    <i class="bi bi-grid-1x2"></i>

                                    Ir al Dashboard

                                </a>

                            }


                            <!-- ADMINISTRADOR + VENDEDOR -->

                            @if (esAdministrador || esVendedor)
                            {

                                <a href="#"
                                   class="secondary-button">

                                    Explorar sistema

                                    <i class="bi bi-arrow-right"></i>

                                </a>

                            }

                        </div>

                    </div>


                    <!-- ================================================= -->
                    <!-- HERO VISUAL -->
                    <!-- ================================================= -->

                    <div class="hero-visual">

                        <div class="hero-circle circle-one"></div>

                        <div class="hero-circle circle-two"></div>


                        <div class="dashboard-preview">

                            <div class="preview-top">

                                <div class="preview-dots">

                                    <span></span>
                                    <span></span>
                                    <span></span>

                                </div>

                                <span>
                                    Charlie Shop
                                </span>

                            </div>


                            <div class="preview-content">

                                <div class="preview-title">
                                    Resumen comercial
                                </div>


                                <div class="preview-number">
                                    ₡1.250.000
                                </div>


                                <div class="preview-label">
                                    Ventas del mes
                                </div>


                                <div class="preview-bars">

                                    <span style="height: 40%;"></span>

                                    <span style="height: 55%;"></span>

                                    <span style="height: 45%;"></span>

                                    <span style="height: 70%;"></span>

                                    <span style="height: 62%;"></span>

                                    <span style="height: 88%;"></span>

                                </div>

                            </div>

                        </div>

                    </div>

                </section>


                <!-- ================================================= -->
                <!-- QUICK ACCESS -->
                <!-- ================================================= -->

                @if (esAdministrador || esVendedor)
                {

                    <section class="section">

                        <div class="section-heading">

                            <div>

                                <span>
                                    ACCESO RÁPIDO
                                </span>

                                <h2>
                                    ¿Qué deseas hacer?
                                </h2>

                            </div>

                            <p>
                                Accede rápidamente a las funciones principales
                                del sistema.
                            </p>

                        </div>


                        <div class="quick-grid">


                            <!-- NUEVA VENTA -->

                            <a href="#"
                               class="quick-card">

                                <div class="quick-icon blue">

                                    <i class="bi bi-cart-plus"></i>

                                </div>

                                <div>

                                    <strong>
                                        Nueva venta
                                    </strong>

                                    <span>
                                        Registrar una nueva venta
                                    </span>

                                </div>

                                <i class="bi bi-arrow-up-right"></i>

                            </a>


                            <!-- NUEVO CLIENTE -->

                            <a href="#"
                               class="quick-card">

                                <div class="quick-icon green">

                                    <i class="bi bi-person-plus"></i>

                                </div>

                                <div>

                                    <strong>
                                        Nuevo cliente
                                    </strong>

                                    <span>
                                        Agregar un cliente
                                    </span>

                                </div>

                                <i class="bi bi-arrow-up-right"></i>

                            </a>


                            <!-- NUEVO PRODUCTO - SOLO ADMIN -->

                            @if (esAdministrador)
                            {

                                <a href="#"
                                   class="quick-card">

                                    <div class="quick-icon purple">

                                        <i class="bi bi-box-seam"></i>

                                    </div>

                                    <div>

                                        <strong>
                                            Nuevo producto
                                        </strong>

                                        <span>
                                            Agregar al inventario
                                        </span>

                                    </div>

                                    <i class="bi bi-arrow-up-right"></i>

                                </a>


                                <!-- REPORTE - SOLO ADMIN -->

                                <a href="#"
                                   class="quick-card">

                                    <div class="quick-icon orange">

                                        <i class="bi bi-file-earmark-bar-graph"></i>

                                    </div>

                                    <div>

                                        <strong>
                                            Generar reporte
                                        </strong>

                                        <span>
                                            Consultar información
                                        </span>

                                    </div>

                                    <i class="bi bi-arrow-up-right"></i>

                                </a>

                            }

                        </div>

                    </section>

                }


                <!-- ================================================= -->
                <!-- MODULES -->
                <!-- ================================================= -->

                @if (esAdministrador || esVendedor)
                {

                    <section class="modules-section">

                        <div class="section-heading">

                            <div>

                                <span>
                                    MÓDULOS
                                </span>

                                <h2>
                                    Administra tu operación
                                </h2>

                            </div>

                        </div>


                        <div class="module-grid">


                            <!-- DASHBOARD - ADMIN -->

                            @if (esAdministrador)
                            {

                                <div class="module-card">

                                    <div class="module-icon">

                                        <i class="bi bi-bar-chart-line"></i>

                                    </div>

                                    <div>

                                        <h3>
                                            Dashboard
                                        </h3>

                                        <p>
                                            Visualiza el rendimiento general
                                            de tu negocio.
                                        </p>

                                    </div>

                                    <i class="bi bi-arrow-right module-arrow"></i>

                                </div>

                            }


                            <!-- INVENTARIO - ADMIN -->

                            @if (esAdministrador)
                            {

                                <div class="module-card">

                                    <div class="module-icon">

                                        <i class="bi bi-boxes"></i>

                                    </div>

                                    <div>

                                        <h3>
                                            Inventario
                                        </h3>

                                        <p>
                                            Controla productos, existencias
                                            y movimientos.
                                        </p>

                                    </div>

                                    <i class="bi bi-arrow-right module-arrow"></i>

                                </div>

                            }


                            <!-- CLIENTES - ADMIN + VENDEDOR -->

                            <div class="module-card">

                                <div class="module-icon">

                                    <i class="bi bi-people"></i>

                                </div>

                                <div>

                                    <h3>
                                        Clientes
                                    </h3>

                                    <p>
                                        Gestiona la información de tus
                                        clientes.
                                    </p>

                                </div>

                                <i class="bi bi-arrow-right module-arrow"></i>

                            </div>


                            <!-- VENTAS - ADMIN + VENDEDOR -->

                            <div class="module-card">

                                <div class="module-icon">

                                    <i class="bi bi-cart3"></i>

                                </div>

                                <div>

                                    <h3>
                                        Ventas
                                    </h3>

                                    <p>
                                        Registra y administra las ventas
                                        realizadas.
                                    </p>

                                </div>

                                <i class="bi bi-arrow-right module-arrow"></i>

                            </div>


                            <!-- CUENTAS POR COBRAR - ADMIN + VENDEDOR -->

                            <div class="module-card">

                                <div class="module-icon">

                                    <i class="bi bi-wallet2"></i>

                                </div>

                                <div>

                                    <h3>
                                        Cuentas por cobrar
                                    </h3>

                                    <p>
                                        Controla los saldos y cuentas
                                        pendientes de pago.
                                    </p>

                                </div>

                                <i class="bi bi-arrow-right module-arrow"></i>

                            </div>


                            <!-- REPORTES - ADMIN -->

                            @if (esAdministrador)
                            {

                                <div class="module-card">

                                    <div class="module-icon">

                                        <i class="bi bi-graph-up-arrow"></i>

                                    </div>

                                    <div>

                                        <h3>
                                            Reportes
                                        </h3>

                                        <p>
                                            Obtén información para apoyar
                                            tus decisiones.
                                        </p>

                                    </div>

                                    <i class="bi bi-arrow-right module-arrow"></i>

                                </div>

                            }

                        </div>

                    </section>

                }


                <!-- ================================================= -->
                <!-- INFO BANNER
                <!-- ADMINISTRADOR Y VENDEDOR -->
                <!-- ================================================= -->

                @if (esAdministrador || esVendedor)
                {

                    <section class="info-banner">

                        <div class="info-icon">

                            <i class="bi bi-stars"></i>

                        </div>


                        <div>

                            <span>
                                ASISTENTE CHARLIE
                            </span>

                            <h3>
                                ¿Necesitas ayuda con el sistema?
                            </h3>

                            <p>
                                Charlie puede ayudarte a encontrar información
                                y navegar por las funciones del sistema.
                            </p>

                        </div>


                        <button type="button">

                            Pregúntale a Charlie

                            <i class="bi bi-arrow-right"></i>

                        </button>

                    </section>

                }


                <!-- ================================================= -->
                <!-- FOOTER -->
                <!-- ================================================= -->

                <footer class="home-footer">

                    <span>
                        © @DateTime.Now.Year Charlie Shop
                    </span>

                    <span>
                        Sistema Integral de Gestión Comercial
                    </span>

                </footer>

            </div>

        </main>

    </div>

</body>

</html>