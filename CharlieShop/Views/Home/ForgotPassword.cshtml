@model CharlieShop.Models.ForgotPasswordViewModel

@{
    ViewData["Title"] = "Recuperar contraseña";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>Charlie Shop - Recuperar contraseña</title>


    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">


    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">


    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />


    <style>

        /* =====================================================
           VALIDATION
           ===================================================== */

        .validation-summary {
            margin-bottom: 20px;
            padding: 13px 16px;

            border: 1px solid #efb5b5;
            border-radius: 9px;

            background-color: #fff7f7;

            color: #c62828 !important;

            font-size: 13px;
            font-weight: 500;
            line-height: 1.4;

            animation: validationAppear 0.2s ease-out;
        }


        .validation-summary:empty {
            display: none;
        }


        .validation-summary ul {
            margin: 0;
            padding-left: 0;
            list-style: none;
        }


        .validation-summary li {
            display: flex;
            align-items: center;
            color: #c62828 !important;
        }


        .validation-summary li::before {
            content: "!";

            width: 18px;
            height: 18px;

            flex-shrink: 0;

            display: inline-flex;
            align-items: center;
            justify-content: center;

            margin-right: 8px;

            border-radius: 50%;

            background-color: #c62828;

            color: white;

            font-size: 11px;
            font-weight: 700;
        }


        /* =====================================================
           ERRORES INDIVIDUALES
           ===================================================== */

        .charlie-validation {
            display: block !important;

            margin-top: 7px;
            padding-left: 2px;

            color: #c62828 !important;

            font-size: 13px;
            font-weight: 500;
            line-height: 1.4;

            animation: validationAppear 0.2s ease-out;
        }


        .charlie-validation.field-validation-error::before {
            content: "!";

            display: inline-flex;
            align-items: center;
            justify-content: center;

            width: 15px;
            height: 15px;

            margin-right: 6px;

            border-radius: 50%;

            background-color: #c62828;

            color: white;

            font-size: 10px;
            font-weight: 700;

            vertical-align: -1px;
        }


        .charlie-validation.field-validation-valid {
            display: none !important;
        }


        /* =====================================================
           CAMPOS CON ERROR
           ===================================================== */

        .input-validation-error {
            border-color: #c62828 !important;

            box-shadow:
                0 0 0 3px rgba(198, 40, 40, 0.08) !important;
        }


        .input-validation-error:focus {
            border-color: #c62828 !important;

            box-shadow:
                0 0 0 3px rgba(198, 40, 40, 0.13) !important;
        }


        /* =====================================================
           MENSAJE DE ÉXITO
           ===================================================== */

        .success-message {
            width: 100%;

            display: flex;
            align-items: center;

            gap: 11px;

            margin: 22px 0 24px 0;

            padding: 12px 14px;

            border: 1px solid #b9e7c8;

            border-radius: 9px;

            background: #f1fbf4;

            color: #176b3a;

            font-size: 12.5px;

            font-weight: 500;

            line-height: 1.45;

            box-sizing: border-box;

            animation: successAppear 0.25s ease-out;
        }


        .success-message-icon {
            width: 28px;
            height: 28px;

            flex-shrink: 0;

            display: flex;
            align-items: center;
            justify-content: center;

            border-radius: 50%;

            background: #20a464;

            color: #ffffff;

            font-size: 14px;
        }


        .success-message-content {
            flex: 1;
        }


        .success-message-content strong {
            display: block;

            margin-bottom: 1px;

            color: #176b3a;

            font-size: 12.5px;

            font-weight: 600;
        }


        .success-message-content span {
            display: block;

            color: #397653;

            font-size: 12px;

            font-weight: 400;
        }


        /* =====================================================
           MENSAJE INFORMATIVO
           ===================================================== */

        .forgot-description {
            margin-bottom: 25px;

            color: #7b8494;

            font-size: 13px;
            line-height: 1.6;

            text-align: center;
        }


        /* =====================================================
           BOTÓN SECUNDARIO
           ===================================================== */

        .back-login {
            display: flex;
            justify-content: center;

            margin-top: 22px;
        }


        .back-login a {
            display: inline-flex;
            align-items: center;

            gap: 7px;

            color: #626b78 !important;

            font-size: 13px;

            font-weight: 500;

            text-decoration: none;

            transition: .18s ease;
        }


        .back-login a:hover {
            color: #171717 !important;
        }


        /* =====================================================
           ANIMACIONES
           ===================================================== */

        @@keyframes validationAppear {

            from {
                opacity: 0;
                transform: translateY(-3px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }

        }


        @@keyframes successAppear {

            from {
                opacity: 0;
                transform: translateY(-5px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }

        }


        /* =====================================================
           RESPONSIVE
           ===================================================== */

        @@media (max-width: 700px) {

            .success-message {
                margin-top: 18px;
                margin-bottom: 20px;
            }

        }

    </style>

</head>


<body>

    <main class="login-page">

        <section class="login-container">


            <!-- =================================================
                 LADO IZQUIERDO
                 ================================================= -->

            <div class="login-brand">

                <div class="brand-content">

                    <img src="~/images/charlie_shop_logo.png"
                         alt="Charlie Shop"
                         class="brand-logo" />


                    <h1>
                        Charlie Shop
                    </h1>


                    <p>
                        Sistema Integral de<br />
                        Gestión Comercial
                    </p>

                </div>


                <div class="brand-footer">

                    © @DateTime.Now.Year Charlie Shop

                </div>

            </div>


            <!-- =================================================
                 LADO DERECHO
                 ================================================= -->

            <div class="login-form-container">


                <div class="login-form">


                    <!-- =================================================
                         ENCABEZADO
                         ================================================= -->

                    <div class="form-header">

                        <span class="welcome-icon">

                            <i class="bi bi-key"></i>

                        </span>


                        <h2>
                            Recuperar contraseña
                        </h2>


                        <p>
                            Restablezca el acceso a su cuenta
                        </p>

                    </div>


                    <!-- =================================================
                         DESCRIPCIÓN
                         ================================================= -->

                    <p class="forgot-description">

                        Ingrese el correo electrónico asociado
                        a su cuenta y le enviaremos las instrucciones
                        para restablecer su contraseña.

                    </p>


                    <!-- =================================================
                         MENSAJE DE ÉXITO
                         ================================================= -->

                    @if (TempData["Mensaje"] != null)
                    {
                        <div class="success-message">

                            <div class="success-message-icon">

                                <i class="bi bi-check-lg"></i>

                            </div>


                            <div class="success-message-content">

                                <strong>
                                    Solicitud enviada
                                </strong>

                                <span>
                                    @TempData["Mensaje"]
                                </span>

                            </div>

                        </div>
                    }


                    <!-- =================================================
                         FORMULARIO
                         ================================================= -->

                    <form asp-controller="Account"
                          asp-action="ForgotPassword"
                          method="post"
                          novalidate>

                        @Html.AntiForgeryToken()


                        <!-- VALIDATION SUMMARY -->

                        <div asp-validation-summary="ModelOnly"
                             class="validation-summary">
                        </div>


                        <!-- =================================================
                             CORREO
                             ================================================= -->

                        <div class="form-group">

                            <label asp-for="Email">
                                Correo electrónico
                            </label>


                            <div class="input-wrapper">

                                <i class="bi bi-envelope"></i>


                                <input asp-for="Email"
                                       class="form-control"
                                       placeholder="Ingrese su correo electrónico"
                                       autocomplete="email" />

                            </div>


                            <span asp-validation-for="Email"
                                  class="charlie-validation">
                            </span>

                        </div>


                        <!-- =================================================
                             BOTÓN
                             ================================================= -->

                        <button type="submit"
                                class="login-button">

                            <span>
                                Enviar instrucciones
                            </span>

                            <i class="bi bi-arrow-right"></i>

                        </button>


                    </form>


                    <!-- =================================================
                         VOLVER
                         ================================================= -->

                    <div class="back-login">

                        <a asp-controller="Account"
                           asp-action="Login">

                            <i class="bi bi-arrow-left"></i>

                            <span>
                                Volver al inicio de sesión
                            </span>

                        </a>

                    </div>


                </div>

            </div>

        </section>

    </main>


    <!-- =====================================================
         VALIDACIÓN DE ASP.NET
         ===================================================== -->

    <partial name="_ValidationScriptsPartial" />


</body>

</html>