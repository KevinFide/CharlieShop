@{
    ViewData["Title"] = "Reporte de clientes";
}

<div class="d-flex justify-content-between align-items-start mb-4">
    <div><div class="page-title">Reporte de clientes</div><div class="page-subtitle">Comportamiento de compra, saldos y segmentación de la cartera.</div></div>
    <div class="d-flex gap-2"><a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i> Reportes</a><button class="btn btn-outline-primary"><i class="bi bi-file-earmark-pdf me-1"></i> Exportar PDF</button><button class="btn btn-primary"><i class="bi bi-download me-1"></i> Exportar datos</button></div>
</div>

<div class="card p-3 mb-4"><div class="row g-3 align-items-end"><div class="col-md-3"><label class="form-label">Período desde</label><input type="date" class="form-control" value="2026-01-01" /></div><div class="col-md-3"><label class="form-label">Hasta</label><input type="date" class="form-control" value="2026-08-09" /></div><div class="col-md-3"><label class="form-label">Segmento</label><select class="form-select"><option>Todos los clientes</option><option>Frecuentes</option><option>Con saldo</option><option>Nuevos</option></select></div><div class="col-md-2"><button class="btn btn-primary w-100"><i class="bi bi-funnel me-1"></i> Aplicar</button></div></div></div>

<div class="row g-3 mb-4"><div class="col-md-3"><div class="card metric"><div class="label">Clientes registrados</div><div class="value">86</div></div></div><div class="col-md-3"><div class="card metric"><div class="label">Clientes nuevos</div><div class="value text-primary">12</div></div></div><div class="col-md-3"><div class="card metric"><div class="label">Clientes con saldo</div><div class="value text-warning">12</div></div></div><div class="col-md-3"><div class="card metric"><div class="label">Ticket promedio</div><div class="value">₡28.400</div></div></div></div>

<div class="row g-4">
    <div class="col-lg-8"><div class="card p-4"><div class="d-flex justify-content-between align-items-center mb-3"><h5 class="mb-0">Clientes con mayor volumen de compra</h5><span class="badge bg-primary-subtle text-primary">Top 5</span></div><table class="table align-middle mb-0"><thead><tr><th>Cliente</th><th>Compras</th><th>Última compra</th><th>Total comprado</th><th>Saldo</th><th>Segmento</th></tr></thead><tbody><tr><td><strong>María López</strong></td><td>18</td><td>08/08/2026</td><td>₡485.000</td><td>₡0</td><td><span class="badge bg-success">Preferente</span></td></tr><tr><td><strong>Carlos Mora</strong></td><td>14</td><td>08/08/2026</td><td>₡397.500</td><td class="text-warning">₡52.500</td><td><span class="badge bg-primary">Frecuente</span></td></tr><tr><td><strong>Andrea Solís</strong></td><td>11</td><td>07/08/2026</td><td>₡286.000</td><td>₡0</td><td><span class="badge bg-primary">Frecuente</span></td></tr><tr><td><strong>Sofía Vargas</strong></td><td>8</td><td>06/08/2026</td><td>₡194.000</td><td class="text-danger">₡35.000</td><td><span class="badge bg-secondary">Regular</span></td></tr></tbody></table></div></div>
    <div class="col-lg-4"><div class="card p-4 h-100"><h5 class="mb-4">Segmentación</h5><div class="segment-stat"><span><i class="legend-dot bg-success"></i> Preferentes</span><strong>18</strong></div><div class="segment-stat"><span><i class="legend-dot bg-primary"></i> Frecuentes</span><strong>31</strong></div><div class="segment-stat"><span><i class="legend-dot bg-info"></i> Nuevos</span><strong>12</strong></div><div class="segment-stat"><span><i class="legend-dot bg-secondary"></i> Regulares</span><strong>25</strong></div><hr/><div class="alert alert-warning mb-0"><i class="bi bi-exclamation-triangle me-2"></i><strong>4 clientes</strong> presentan cuentas vencidas.</div></div></div>
</div>
