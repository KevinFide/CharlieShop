@model CharlieShop.Models.EditarUsuarioViewModel

@{
    ViewData["Title"] = "Editar usuario";
}

@section Styles {

    <style>

        /* =========================================
           ENCABEZADO
        ========================================= */

        .edit-page-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 26px;
        }

        .edit-page-heading {
            display: flex;
            align-items: center;
            gap: 14px;
        }

        .edit-page-icon {
            width: 46px;
            height: 46px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 10px;
            background: #f0f4f8;
            color: #1f2937;
            font-size: 20px;
        }

        .edit-page-title {
            margin: 0;
            font-size: 22px;
            font-weight: 600;
            color: #111827;
        }

        .edit-page-subtitle {
            margin-top: 4px;
            font-size: 13px;
            color: #6b7280;
        }


        /* =========================================
           BOTÓN VOLVER
        ========================================= */

        .edit-back-button {
            height: 40px;
            padding: 0 16px;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            border: 1px solid #d7dce2;
            border-radius: 8px;
            background: #ffffff;
            color: #374151;
            text-decoration: none;
            font-size: 13px;
            font-weight: 500;
            transition: all 0.2s ease;
        }

        .edit-back-button:hover {
            background: #f8f9fa;
            border-color: #bfc5cc;
            color: #111827;
            transform: translateY(-1px);
        }


        /* =========================================
           TARJETA PRINCIPAL
        ========================================= */

        .edit-card {
            background: #ffffff;
            border: 1px solid #d9dde3;
            border-radius: 10px;
            overflow: hidden;
        }

        .edit-card-header {
            padding: 22px 25px;
            border-bottom: 1px solid #e5e7eb;
            background: #fcfcfd;
        }

        .edit-card-header-title {
            display: flex;
            align-items: center;
            gap: 10px;
            margin: 0;
            color: #1f2937;
            font-size: 15px;
            font-weight: 600;
        }

        .edit-card-header-title i {
            color: #6b7280;
            font-size: 16px;
        }

        .edit-card-header-description {
            margin-top: 5px;
            margin-left: 26px;
            color: #8a8f98;
            font-size: 12.5px;
        }

        .edit-card-body {
            padding: 28px 25px;
        }


        /* =========================================
           CAMPOS
        ========================================= */

        .edit-field {
            margin-bottom: 23px;
        }

        .edit-label {
            display: block;
            margin-bottom: 8px;
            color: #374151;
            font-size: 13px;
            font-weight: 500;
        }

        .edit-label i {
            margin-right: 5px;
            color: #6b7280;
        }

        .edit-input-wrapper {
            position: relative;
        }

        .edit-input-icon {
            position: absolute;
            left: 13px;
            top: 50%;
            transform: translateY(-50%);
            color: #9ca3af;
            font-size: 15px;
            pointer-events: none;
            z-index: 2;
        }

        .edit-input {
            height: 43px;
            padding-left: 39px;
            border: 1px solid #d9dde3;
            border-radius: 7px;
            color: #1f2937;
            font-size: 13.5px;
            transition: all 0.2s ease;
        }

        .edit-input:focus {
            border-color: #8fb5e8;
            box-shadow: 0 0 0 3px rgba(13, 110, 253, 0.08);
        }

        .edit-select {
            height: 43px;
            padding-left: 39px;
            border: 1px solid #d9dde3;
            border-radius: 7px;
            color: #1f2937;
            font-size: 13.5px;
            transition: all 0.2s ease;
        }

        .edit-select:focus {
            border-color: #8fb5e8;
            box-shadow: 0 0 0 3px rgba(13, 110, 253, 0.08);
        }


        /* =========================================
           ESTADO
        ========================================= */

        .edit-status-box {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 16px 17px;
            border: 1px solid #e1e5ea;
            border-radius: 8px;
            background: #fafbfc;
        }

        .edit-status-content {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .edit-status-icon {
            width: 36px;
            height: 36px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
            background: #e8f7ef;
            color: #198754;
            font-size: 16px;
        }

        .edit-status-title {
            color: #374151;
            font-size: 13px;
            font-weight: 600;
        }

        .edit-status-description {
            margin-top: 2px;
            color: #8a8f98;
            font-size: 11.5px;
        }

        .edit-status-box .form-check-input {
            width: 2.5em;
            height: 1.3em;
            cursor: pointer;
        }


        /* =========================================
           VALIDACIÓN GENERAL
        ========================================= */

        .edit-validation-summary {
            display: flex;
            align-items: flex-start;
            gap: 11px;
            margin-bottom: 25px;
            padding: 13px 15px;
            border: 1px solid #f0c2c2;
            border-radius: 8px;
            background: #fff5f5;
            color: #8f3a3a;
            font-size: 12.5px;
            line-height: 1.45;
        }

        .edit-validation-icon {
            width: 28px;
            height: 28px;
            flex-shrink: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
            background: #dc3545;
            color: #ffffff;
            font-size: 13px;
        }

        .edit-validation-content {
            flex: 1;
        }

        .edit-validation-title {
            display: block;
            margin-bottom: 2px;
            color: #a52828;
            font-size: 12.5px;
            font-weight: 600;
        }

        .edit-validation-summary ul {
            margin: 3px 0 0 17px;
            padding: 0;
        }

        .edit-validation-summary li {
            margin-bottom: 2px;
        }


        /* =========================================
           VALIDACIÓN DE CAMPOS
        ========================================= */

        .edit-validation {
            display: block;
            margin-top: 5px;
            font-size: 11.5px;
        }

        .input-validation-error {
            border-color: #dc3545 !important;
        }

        .input-validation-error:focus {
            border-color: #dc3545 !important;
            box-shadow: 0 0 0 3px rgba(220, 53, 69, 0.08) !important;
        }


        /* =========================================
           FOOTER / BOTONES
        ========================================= */

        .edit-card-footer {
            display: flex;
            justify-content: flex-end;
            align-items: center;
            gap: 10px;
            padding: 18px 25px;
            border-top: 1px solid #e5e7eb;
            background: #fcfcfd;
        }

        .edit-cancel-button {
            height: 40px;
            padding: 0 17px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border: 1px solid #d7dce2;
            border-radius: 8px;
            background: #ffffff;
            color: #4b5563;
            text-decoration: none;
            font-size: 13px;
            font-weight: 500;
            transition: all 0.2s ease;
        }

        .edit-cancel-button:hover {
            background: #f8f9fa;
            color: #111827;
        }

        .edit-save-button {
            height: 40px;
            padding: 0 18px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            border: 1px solid #171717;
            border-radius: 8px;
            background: #171717;
            color: #ffffff;
            font-size: 13px;
            font-weight: 500;
            transition: all 0.2s ease;
        }

        .edit-save-button:hover {
            background: #2b2b2b;
            border-color: #2b2b2b;
            color: #ffffff;
            transform: translateY(-1px);
        }

    </style>
}


<!-- =========================================
     ENCABEZADO
========================================= -->

<div class="edit-page-header">

    <div class="edit-page-heading">

        <div class="edit-page-icon">
            <i class="bi bi-person-gear"></i>
        </div>

        <div>

            <h1 class="edit-page-title">
                Editar usuario
            </h1>

            <div class="edit-page-subtitle">
                Actualiza la información, rol y estado de acceso de la cuenta.
            </div>

        </div>

    </div>


    <a asp-action="Index"
       class="edit-back-button">

        <i class="bi bi-arrow-left"></i>

        Volver a usuarios

    </a>

</div>


<!-- =========================================
     FORMULARIO
========================================= -->

<div class="edit-card">

    <div class="edit-card-header">

        <div class="edit-card-header-title">

            <i class="bi bi-person-vcard"></i>

            Información de la cuenta

        </div>

        <div class="edit-card-header-description">
            Modifica los datos generales del usuario seleccionado.
        </div>

    </div>


    <form asp-action="Editar"
          method="post">

        @Html.AntiForgeryToken()

        <input type="hidden"
               asp-for="IdUsuario" />


        <div class="edit-card-body">

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="edit-validation-summary">

                    <div class="edit-validation-icon">
                        <i class="bi bi-exclamation-lg"></i>
                    </div>

                    <div class="edit-validation-content">

                        <span class="edit-validation-title">
                            No se pudieron guardar los cambios
                        </span>

                        <div asp-validation-summary="ModelOnly">
                        </div>

                    </div>

                </div>
            }


            <div class="row">


                <!-- NOMBRE -->

                <div class="col-md-6">

                    <div class="edit-field">

                        <label asp-for="Nombre"
                               class="edit-label">

                            <i class="bi bi-person"></i>

                            Nombre completo

                        </label>

                        <div class="edit-input-wrapper">

                            <i class="bi bi-person edit-input-icon"></i>

                            <input asp-for="Nombre"
                                   class="form-control edit-input"
                                   placeholder="Ingrese el nombre completo" />

                        </div>

                        <span asp-validation-for="Nombre"
                              class="text-danger edit-validation">
                        </span>

                    </div>

                </div>


                <!-- USUARIO -->

                <div class="col-md-6">

                    <div class="edit-field">

                        <label asp-for="Usuario"
                               class="edit-label">

                            <i class="bi bi-at"></i>

                            Nombre de usuario

                        </label>

                        <div class="edit-input-wrapper">

                            <i class="bi bi-at edit-input-icon"></i>

                            <input asp-for="Usuario"
                                   class="form-control edit-input"
                                   placeholder="Ingrese el nombre de usuario" />

                        </div>

                        <span asp-validation-for="Usuario"
                              class="text-danger edit-validation">
                        </span>

                    </div>

                </div>


                <!-- CORREO -->

                <div class="col-md-6">

                    <div class="edit-field">

                        <label asp-for="Email"
                               class="edit-label">

                            <i class="bi bi-envelope"></i>

                            Correo electrónico

                        </label>

                        <div class="edit-input-wrapper">

                            <i class="bi bi-envelope edit-input-icon"></i>

                            <input asp-for="Email"
                                   type="email"
                                   class="form-control edit-input"
                                   placeholder="correo@ejemplo.com" />

                        </div>

                        <span asp-validation-for="Email"
                              class="text-danger edit-validation">
                        </span>

                    </div>

                </div>


                <!-- ROL -->

                <div class="col-md-6">

                    <div class="edit-field">

                        <label asp-for="RolId"
                               class="edit-label">

                            <i class="bi bi-shield-check"></i>

                            Rol de acceso

                        </label>

                        <div class="edit-input-wrapper">

                            <i class="bi bi-shield-check edit-input-icon"></i>

                            <select asp-for="RolId"
                                    class="form-select edit-select">

                                <option value="">
                                    Seleccione un rol
                                </option>

                                @foreach (var rol in Model.Roles)
                                {
                                    <option value="@rol.IdRol">
                                        @rol.Nombre
                                    </option>
                                }

                            </select>

                        </div>

                        <span asp-validation-for="RolId"
                              class="text-danger edit-validation">
                        </span>

                    </div>

                </div>


                <!-- ESTADO -->

                <div class="col-12">

                    <div class="edit-status-box">

                        <div class="edit-status-content">

                            <div class="edit-status-icon">
                                <i class="bi bi-person-check"></i>
                            </div>

                            <div>

                                <div class="edit-status-title">
                                    Estado de la cuenta
                                </div>

                                <div class="edit-status-description">
                                    Los usuarios inactivos no podrán iniciar sesión en el sistema.
                                </div>

                            </div>

                        </div>


                        <div class="form-check form-switch mb-0">

                            <input asp-for="Estado"
                                   class="form-check-input"
                                   type="checkbox" />

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- =========================================
             FOOTER
        ========================================= -->

        <div class="edit-card-footer">

            <a asp-action="Index"
               class="edit-cancel-button">

                Cancelar

            </a>

            <button type="submit"
                    class="edit-save-button">

                <i class="bi bi-check-lg"></i>

                Guardar cambios

            </button>

        </div>

    </form>

</div>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}