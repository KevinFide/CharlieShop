@model IEnumerable<CharlieShop.Models.Usuario>

@{
    ViewData["Title"] = "Usuarios";
}

<style>
    .usuarios-page {
        padding: 10px 0 30px;
    }

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        margin-bottom: 25px;
    }

    .page-title-wrapper {
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .page-icon {
        width: 48px;
        height: 48px;
        border-radius: 12px;
        background: #111;
        color: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 21px;
    }

    .page-title {
        margin: 0;
        font-size: 28px;
        font-weight: 700;
        color: #111;
    }

    .page-subtitle {
        margin: 3px 0 0;
        color: #777;
        font-size: 14px;
    }

    .btn-primary-custom {
        background: #111;
        border: 1px solid #111;
        color: #fff;
        border-radius: 9px;
        padding: 10px 16px;
        font-weight: 600;
        font-size: 14px;
        text-decoration: none;
        transition: .2s ease;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

    .btn-primary-custom:hover {
        background: #333;
        border-color: #333;
        color: #fff;
    }

    .summary-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 16px;
        margin-bottom: 22px;
    }

    .summary-card {
        background: #fff;
        border: 1px solid #e7e7e7;
        border-radius: 14px;
        padding: 18px;
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .summary-icon {
        width: 42px;
        height: 42px;
        border-radius: 10px;
        background: #f3f3f3;
        color: #111;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 18px;
    }

    .summary-label {
        color: #777;
        font-size: 13px;
        margin-bottom: 2px;
    }

    .summary-value {
        font-size: 23px;
        font-weight: 700;
        color: #111;
    }

    .alert-custom {
        border-radius: 10px;
        border: none;
        margin-bottom: 18px;
        font-size: 14px;
    }

    .users-card {
        background: #fff;
        border: 1px solid #e7e7e7;
        border-radius: 14px;
        overflow: hidden;
    }

    .users-card-header {
        padding: 20px 22px;
        border-bottom: 1px solid #ededed;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
    }

    .users-card-title {
        margin: 0;
        font-size: 18px;
        font-weight: 700;
        color: #111;
    }

    .users-card-subtitle {
        margin: 4px 0 0;
        color: #888;
        font-size: 13px;
    }

    .search-wrapper {
        position: relative;
        width: 260px;
    }

    .search-wrapper i {
        position: absolute;
        left: 12px;
        top: 50%;
        transform: translateY(-50%);
        color: #999;
    }

    .search-input {
        width: 100%;
        border: 1px solid #ddd;
        border-radius: 9px;
        padding: 9px 12px 9px 36px;
        font-size: 13px;
        outline: none;
    }

    .search-input:focus {
        border-color: #999;
        box-shadow: 0 0 0 3px rgba(0,0,0,.05);
    }

    .table-responsive {
        overflow-x: auto;
    }

    .users-table {
        width: 100%;
        border-collapse: collapse;
        margin: 0;
    }

    .users-table thead th {
        background: #fafafa;
        color: #777;
        font-size: 12px;
        text-transform: uppercase;
        letter-spacing: .4px;
        font-weight: 700;
        padding: 13px 20px;
        border-bottom: 1px solid #ededed;
        white-space: nowrap;
    }

    .users-table tbody td {
        padding: 15px 20px;
        border-bottom: 1px solid #f0f0f0;
        vertical-align: middle;
        font-size: 14px;
        color: #333;
    }

    .users-table tbody tr:last-child td {
        border-bottom: none;
    }

    .users-table tbody tr:hover {
        background: #fafafa;
    }

    .user-info {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .user-avatar {
        width: 38px;
        height: 38px;
        min-width: 38px;
        border-radius: 50%;
        background: #111;
        color: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        font-size: 14px;
    }

    .user-name {
        font-weight: 600;
        color: #111;
        margin-bottom: 2px;
    }

    .username {
        font-size: 12px;
        color: #888;
    }

    .role-badge {
        display: inline-flex;
        align-items: center;
        padding: 5px 9px;
        border-radius: 7px;
        background: #f1f1f1;
        color: #333;
        font-size: 12px;
        font-weight: 600;
    }

    .status-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 5px 9px;
        border-radius: 7px;
        font-size: 12px;
        font-weight: 600;
    }

    .status-active {
        background: #eaf7ee;
        color: #217a3a;
    }

    .status-inactive {
        background: #f0f0f0;
        color: #777;
    }

    .status-dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: currentColor;
    }

    .actions {
        display: flex;
        gap: 7px;
        flex-wrap: wrap;
    }

    .action-btn {
        width: 34px;
        height: 34px;
        border: 1px solid #ddd;
        background: #fff;
        border-radius: 8px;
        color: #444;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        text-decoration: none;
        transition: .2s ease;
        cursor: pointer;
    }

    .action-btn:hover {
        background: #f5f5f5;
        color: #111;
        border-color: #bbb;
    }

    .action-btn.password:hover {
        background: #f5f5f5;
    }

    .action-btn.status:hover {
        background: #111;
        color: #fff;
        border-color: #111;
    }

    .empty-state {
        text-align: center;
        padding: 55px 20px;
        color: #777;
    }

    .empty-state i {
        font-size: 38px;
        color: #bbb;
        margin-bottom: 12px;
    }

    .empty-state h5 {
        color: #333;
        margin-bottom: 5px;
        font-weight: 600;
    }

    .empty-state p {
        margin: 0;
        font-size: 14px;
    }


    /* =====================================================
       MODALES ANTERIORES
    ===================================================== */

    .estado-modal {
        position: fixed;
        inset: 0;
        display: none;
        align-items: center;
        justify-content: center;
        z-index: 9999;
    }

    .estado-modal.active {
        display: flex;
    }

    .estado-modal-overlay {
        position: absolute;
        inset: 0;
        background: rgba(15, 23, 42, 0.45);
        backdrop-filter: blur(2px);
    }

    .estado-modal-content {
        position: relative;
        width: 420px;
        max-width: calc(100% - 32px);
        padding: 30px;
        background: #ffffff;
        border-radius: 14px;
        box-shadow: 0 20px 50px rgba(0, 0, 0, 0.18);
        text-align: center;
        animation: estadoModalAppear 0.2s ease-out;
    }

    .estado-modal-icon {
        width: 52px;
        height: 52px;
        margin: 0 auto 18px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background: #fff1f2;
        color: #dc3545;
        font-size: 21px;
    }

    .estado-modal-icon.activar {
        background: #ecfdf3;
        color: #198754;
    }

    .estado-modal-content h5 {
        margin-bottom: 10px;
        font-size: 18px;
        font-weight: 600;
        color: #111827;
    }

    .estado-modal-content p {
        margin-bottom: 25px;
        font-size: 13px;
        line-height: 1.6;
        color: #6b7280;
    }

    .estado-modal-actions {
        display: flex;
        justify-content: center;
        gap: 10px;
    }

    .estado-modal-cancel,
    .estado-modal-confirm {
        height: 38px;
        padding: 0 17px;
        border-radius: 8px;
        font-size: 13px;
        font-weight: 500;
        transition: all 0.2s ease;
    }

    .estado-modal-cancel {
        background: #ffffff;
        border: 1px solid #dee2e6;
        color: #495057;
    }

    .estado-modal-cancel:hover {
        background: #f8f9fa;
    }

    .estado-modal-confirm {
        background: #171717;
        border: 1px solid #171717;
        color: #ffffff;
    }

    .estado-modal-confirm:hover {
        background: #2b2b2b;
        border-color: #2b2b2b;
        transform: translateY(-1px);
    }

    @@keyframes estadoModalAppear {
        from {
            opacity: 0;
            transform: translateY(8px) scale(0.98);
        }

        to {
            opacity: 1;
            transform: translateY(0) scale(1);
        }
    }


    /* =====================================================
       MODAL CONTRASEÑA ANTERIOR
    ===================================================== */

    .password-modal-content {
        text-align: left;
    }

    .password-modal-content h5 {
        text-align: center;
    }

    .password-modal-content > p {
        text-align: center;
    }

    .password-modal-icon {
        background: #f0f4f8;
        color: #1f2937;
    }

    .password-field {
        margin-bottom: 16px;
    }

    .password-field label {
        display: block;
        margin-bottom: 6px;
        font-size: 12px;
        font-weight: 600;
        color: #374151;
    }

    .password-input-wrapper {
        position: relative;
    }

    .password-input-wrapper .form-control {
        height: 40px;
        padding-right: 42px;
        border-radius: 8px;
        font-size: 13px;
    }

    .password-input-wrapper .form-control:focus {
        border-color: #adb5bd;
        box-shadow: 0 0 0 0.15rem rgba(23, 23, 23, 0.08);
    }

    .password-toggle {
        position: absolute;
        top: 50%;
        right: 8px;
        transform: translateY(-50%);
        border: 0;
        background: transparent;
        color: #6b7280;
        width: 30px;
        height: 30px;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
    }

    .password-toggle:hover {
        color: #171717;
    }

    .password-error {
        display: none;
        margin-bottom: 16px;
        padding: 9px 11px;
        border-radius: 7px;
        background: #fff5f5;
        border: 1px solid #f0c2c2;
        color: #a52828;
        font-size: 12px;
    }

    .password-error.active {
        display: block;
    }

    @@media (max-width: 900px) {
        .summary-grid {
            grid-template-columns: 1fr;
        }

        .users-card-header {
            align-items: flex-start;
            flex-direction: column;
        }

        .search-wrapper {
            width: 100%;
        }
    }

    @@media (max-width: 600px) {
        .page-header {
            align-items: flex-start;
            flex-direction: column;
        }

        .btn-primary-custom {
            width: 100%;
            justify-content: center;
        }

        .page-title {
            font-size: 24px;
        }
    }
</style>


<div class="usuarios-page">

    <!-- ENCABEZADO -->
    <div class="page-header">

        <div class="page-title-wrapper">

            <div class="page-icon">
                <i class="bi bi-people-fill"></i>
            </div>

            <div>
                <h1 class="page-title">
                    Usuarios
                </h1>

                <p class="page-subtitle">
                    Administra las cuentas, roles y permisos de acceso a Charlie Shop.
                </p>
            </div>

        </div>

        <a asp-action="Crear"
           class="btn-primary-custom">

            <i class="bi bi-plus-lg"></i>
            Nuevo usuario

        </a>

    </div>


    <!-- MENSAJES -->

    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-success alert-custom">
            <i class="bi bi-check-circle me-2"></i>
            @TempData["Mensaje"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-custom">
            <i class="bi bi-exclamation-circle me-2"></i>
            @TempData["Error"]
        </div>
    }


    <!-- RESUMEN -->

    <div class="summary-grid">

        <div class="summary-card">

            <div class="summary-icon">
                <i class="bi bi-people"></i>
            </div>

            <div>
                <div class="summary-label">
                    Total de usuarios
                </div>

                <div class="summary-value">
                    @Model.Count()
                </div>
            </div>

        </div>


        <div class="summary-card">

            <div class="summary-icon">
                <i class="bi bi-person-check"></i>
            </div>

            <div>
                <div class="summary-label">
                    Usuarios activos
                </div>

                <div class="summary-value">
                    @Model.Count(u => u.Estado)
                </div>
            </div>

        </div>


        <div class="summary-card">

            <div class="summary-icon">
                <i class="bi bi-person-x"></i>
            </div>

            <div>
                <div class="summary-label">
                    Usuarios inactivos
                </div>

                <div class="summary-value">
                    @Model.Count(u => !u.Estado)
                </div>
            </div>

        </div>

    </div>


    <!-- LISTA DE USUARIOS -->

    <div class="users-card">

        <div class="users-card-header">

            <div>

                <h2 class="users-card-title">
                    Lista de usuarios
                </h2>

                <p class="users-card-subtitle">
                    Consulta y administra las cuentas registradas.
                </p>

            </div>

            <div class="search-wrapper">

                <i class="bi bi-search"></i>

                <input type="text"
                       id="buscarUsuario"
                       class="search-input"
                       placeholder="Buscar usuario..." />

            </div>

        </div>


        @if (Model.Any())
        {
            <div class="table-responsive">

                <table class="users-table"
                       id="tablaUsuarios">

                    <thead>

                        <tr>
                            <th>Usuario</th>
                            <th>Correo electrónico</th>
                            <th>Rol</th>
                            <th>Estado</th>
                            <th>Acciones</th>
                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var usuario in Model)
                        {
                            <tr>

                                <td>

                                    <div class="user-info">

                                        <div class="user-avatar">
                                            @(string.IsNullOrWhiteSpace(usuario.Nombre)
                                                ? "?"
                                                : usuario.Nombre.Substring(0, 1).ToUpper())
                                        </div>

                                        <div>

                                            <div class="user-name">
                                                @usuario.Nombre
                                            </div>

                                            <div class="username">
                                                @usuario.UsuarioNombre
                                            </div>

                                        </div>

                                    </div>

                                </td>


                                <td>
                                    @usuario.Email
                                </td>


                                <td>

                                    <span class="role-badge">
                                        <i class="bi bi-shield-check me-1"></i>
                                        @usuario.NombreRol
                                    </span>

                                </td>


                                <td>

                                    @if (usuario.Estado)
                                    {
                                        <span class="status-badge status-active">

                                            <span class="status-dot"></span>

                                            Activo

                                        </span>
                                    }
                                    else
                                    {
                                        <span class="status-badge status-inactive">

                                            <span class="status-dot"></span>

                                            Inactivo

                                        </span>
                                    }

                                </td>


                                <td>

                                    <div class="actions">

                                        <!-- EDITAR -->

                                        <a asp-action="Editar"
                                           asp-route-id="@usuario.IdUsuario"
                                           class="action-btn"
                                           title="Editar usuario">

                                            <i class="bi bi-pencil"></i>

                                        </a>


                                        <!-- CAMBIAR CONTRASEÑA -->

                                        <button type="button"
                                                class="action-btn password"
                                                title="Cambiar contraseña"
                                                onclick="abrirModalContrasena(
                                                    @usuario.IdUsuario,
                                                    '@Html.Raw(usuario.Nombre.Replace("'", "\\'"))'
                                                )">

                                            <i class="bi bi-key"></i>

                                        </button>


                                        <!-- ACTIVAR / DESACTIVAR -->

                                        @if (usuario.Estado)
                                        {
                                            <button type="button"
                                                    class="action-btn status"
                                                    title="Desactivar usuario"
                                                    onclick="abrirModalEstado(
                                                        @usuario.IdUsuario,
                                                        '@Html.Raw(usuario.Nombre.Replace("'", "\\'"))',
                                                        false
                                                    )">

                                                <i class="bi bi-person-x"></i>

                                            </button>
                                        }
                                        else
                                        {
                                            <button type="button"
                                                    class="action-btn status"
                                                    title="Activar usuario"
                                                    onclick="abrirModalEstado(
                                                        @usuario.IdUsuario,
                                                        '@Html.Raw(usuario.Nombre.Replace("'", "\\'"))',
                                                        true
                                                    )">

                                                <i class="bi bi-person-check"></i>

                                            </button>
                                        }

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }
        else
        {
            <div class="empty-state">

                <i class="bi bi-people"></i>

                <h5>
                    No hay usuarios registrados
                </h5>

                <p>
                    Cuando registres usuarios, aparecerán aquí.
                </p>

            </div>
        }

    </div>

</div>


<!-- =====================================================
     MODAL CAMBIAR ESTADO
===================================================== -->

<div id="estadoUsuarioModal"
     class="estado-modal">

    <div class="estado-modal-overlay"
         onclick="cerrarModalEstado()">
    </div>

    <div class="estado-modal-content">

        <div id="estadoModalIcon"
             class="estado-modal-icon">

            <i class="bi bi-person-x"></i>

        </div>

        <h5 id="estadoModalTitulo">
            Desactivar usuario
        </h5>

        <p id="estadoModalMensaje">
            ¿Está seguro de que desea desactivar este usuario?
        </p>

        <div class="estado-modal-actions">

            <button type="button"
                    class="estado-modal-cancel"
                    onclick="cerrarModalEstado()">

                Cancelar

            </button>

            <form id="estadoUsuarioForm"
                  asp-action="CambiarEstado"
                  method="post">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       id="estadoUsuarioId"
                       name="id" />

                <input type="hidden"
                       id="estadoUsuarioEstado"
                       name="estado" />

                <button type="submit"
                        id="estadoModalConfirmar"
                        class="estado-modal-confirm">

                    Desactivar usuario

                </button>

            </form>

        </div>

    </div>

</div>


<!-- =====================================================
     MODAL CAMBIAR CONTRASEÑA
===================================================== -->

<div id="contrasenaUsuarioModal"
     class="estado-modal">

    <div class="estado-modal-overlay"
         onclick="cerrarModalContrasena()">
    </div>

    <div class="estado-modal-content password-modal-content">

        <div class="estado-modal-icon password-modal-icon">

            <i class="bi bi-key"></i>

        </div>

        <h5>
            Cambiar contraseña
        </h5>

        <p id="contrasenaUsuarioNombre">
            Cambiar contraseña del usuario
        </p>


        <form asp-action="CambiarContrasenaUsuario"
              method="post"
              id="cambiarContrasenaForm">

            @Html.AntiForgeryToken()

            <input type="hidden"
                   id="contrasenaUsuarioId"
                   name="IdUsuario" />


            <!-- NUEVA CONTRASEÑA -->

            <div class="password-field">

                <label for="nuevaContrasena">
                    Nueva contraseña
                </label>

                <div class="password-input-wrapper">

                    <input type="password"
                           id="nuevaContrasena"
                           name="NuevaContrasena"
                           class="form-control"
                           autocomplete="new-password" />

                    <button type="button"
                            class="password-toggle"
                            onclick="alternarContrasena('nuevaContrasena', this)"
                            tabindex="-1">

                        <i class="bi bi-eye"></i>

                    </button>

                </div>

            </div>


            <!-- CONFIRMAR CONTRASEÑA -->

            <div class="password-field">

                <label for="confirmarContrasena">
                    Confirmar nueva contraseña
                </label>

                <div class="password-input-wrapper">

                    <input type="password"
                           id="confirmarContrasena"
                           name="ConfirmarContrasena"
                           class="form-control"
                           autocomplete="new-password" />

                    <button type="button"
                            class="password-toggle"
                            onclick="alternarContrasena('confirmarContrasena', this)"
                            tabindex="-1">

                        <i class="bi bi-eye"></i>

                    </button>

                </div>

            </div>


            <!-- ERROR -->

            <div id="contrasenaError"
                 class="password-error">

                Las contraseñas no coinciden.

            </div>


            <!-- BOTONES -->

            <div class="estado-modal-actions">

                <button type="button"
                        class="estado-modal-cancel"
                        onclick="cerrarModalContrasena()">

                    Cancelar

                </button>

                <button type="submit"
                        class="estado-modal-confirm">

                    Cambiar contraseña

                </button>

            </div>

        </form>

    </div>

</div>


<script>

    /* =====================================================
       BUSCAR USUARIO
    ===================================================== */

    document
        .getElementById("buscarUsuario")
        ?.addEventListener("keyup", function () {

            const texto = this.value.toLowerCase();

            const filas =
                document.querySelectorAll("#tablaUsuarios tbody tr");

            filas.forEach(function (fila) {

                const contenido =
                    fila.textContent.toLowerCase();

                fila.style.display =
                    contenido.includes(texto)
                        ? ""
                        : "none";

            });

        });


    /* =====================================================
       MODAL ACTIVAR / DESACTIVAR
    ===================================================== */

    function abrirModalEstado(id, nombre, estado) {

        document.getElementById("estadoUsuarioId").value = id;

        document.getElementById("estadoUsuarioEstado").value = estado;

        const modal =
            document.getElementById("estadoUsuarioModal");

        const icon =
            document.getElementById("estadoModalIcon");

        const titulo =
            document.getElementById("estadoModalTitulo");

        const mensaje =
            document.getElementById("estadoModalMensaje");

        const confirmar =
            document.getElementById("estadoModalConfirmar");


        if (estado) {

            icon.classList.add("activar");

            icon.innerHTML =
                '<i class="bi bi-person-check"></i>';

            titulo.textContent =
                "Activar usuario";

            mensaje.textContent =
                `¿Desea volver a activar a ${nombre}?`;

            confirmar.textContent =
                "Activar usuario";

        }
        else {

            icon.classList.remove("activar");

            icon.innerHTML =
                '<i class="bi bi-person-x"></i>';

            titulo.textContent =
                "Desactivar usuario";

            mensaje.textContent =
                `¿Está seguro de que desea desactivar a ${nombre}?`;

            confirmar.textContent =
                "Desactivar usuario";

        }

        modal.classList.add("active");
    }


    function cerrarModalEstado() {

        document
            .getElementById("estadoUsuarioModal")
            .classList.remove("active");

    }


    /* =====================================================
       MODAL CAMBIAR CONTRASEÑA
    ===================================================== */

    function abrirModalContrasena(id, nombre) {

        document
            .getElementById("contrasenaUsuarioId")
            .value = id;

        document
            .getElementById("contrasenaUsuarioNombre")
            .textContent =
            `Cambiar contraseña de ${nombre}`;

        document
            .getElementById("nuevaContrasena")
            .value = "";

        document
            .getElementById("confirmarContrasena")
            .value = "";

        document
            .getElementById("contrasenaError")
            .classList.remove("active");

        document
            .getElementById("contrasenaUsuarioModal")
            .classList.add("active");

    }


    function cerrarModalContrasena() {

        document
            .getElementById("contrasenaUsuarioModal")
            .classList.remove("active");

    }


    /* =====================================================
       MOSTRAR / OCULTAR CONTRASEÑA
    ===================================================== */

    function alternarContrasena(id, boton) {

        const input =
            document.getElementById(id);

        const icon =
            boton.querySelector("i");


        if (input.type === "password") {

            input.type = "text";

            icon.className =
                "bi bi-eye-slash";

        }
        else {

            input.type = "password";

            icon.className =
                "bi bi-eye";

        }

    }


    /* =====================================================
       VALIDAR CONTRASEÑAS
    ===================================================== */

    document
        .getElementById("cambiarContrasenaForm")
        ?.addEventListener("submit", function (event) {

            const nueva =
                document
                    .getElementById("nuevaContrasena")
                    .value
                    .trim();

            const confirmar =
                document
                    .getElementById("confirmarContrasena")
                    .value
                    .trim();

            const error =
                document.getElementById("contrasenaError");


            if (nueva === "" || confirmar === "") {

                event.preventDefault();

                error.textContent =
                    "Debe completar ambos campos de contraseña.";

                error.classList.add("active");

                return;
            }


            if (nueva !== confirmar) {

                event.preventDefault();

                error.textContent =
                    "Las contraseñas no coinciden.";

                error.classList.add("active");

                return;
            }


            error.classList.remove("active");

        });

</script>