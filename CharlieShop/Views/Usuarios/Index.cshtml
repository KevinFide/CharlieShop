@model IEnumerable<CharlieShop.Models.Usuario>

@{
    ViewData["Title"] = "Usuarios";
}

@section Styles
{
    <style>

        /* =========================================
                           ENCABEZADO
                        ========================================= */

        .users-page-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 28px;
        }

        .users-page-heading {
            display: flex;
            align-items: center;
            gap: 14px;
        }

        .users-page-icon {
            width: 46px;
            height: 46px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 10px;
            background: #f0f4f8;
            color: #1f2937;
            font-size: 20px;
        }

        .users-page-title {
            margin: 0;
            font-size: 22px;
            font-weight: 600;
            color: #111827;
        }

        .users-page-subtitle {
            margin-top: 4px;
            font-size: 13px;
            color: #6b7280;
        }


        /* =========================================
                           BOTÓN NUEVO USUARIO
                        ========================================= */

        .users-primary-button {
            height: 40px;
            padding: 0 17px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            border-radius: 8px;
            background: #171717;
            border: 1px solid #171717;
            color: #ffffff;
            text-decoration: none;
            font-size: 13px;
            font-weight: 500;
            transition: all 0.2s ease;
        }

            .users-primary-button:hover {
                background: #2b2b2b;
                border-color: #2b2b2b;
                color: #ffffff;
                transform: translateY(-1px);
            }


        /* =========================================
                           MENSAJES DEL SISTEMA
                        ========================================= */

        .users-alert {
            width: 100%;
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 22px;
            padding: 13px 16px;
            border-radius: 9px;
            font-size: 13px;
            line-height: 1.4;
            box-sizing: border-box;
            animation: usersAlertAppear 0.25s ease-out;
        }

        .users-alert-icon {
            width: 30px;
            height: 30px;
            flex-shrink: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
            font-size: 14px;
        }

        .users-alert-content {
            flex: 1;
        }

        .users-alert-title {
            display: block;
            margin-bottom: 1px;
            font-size: 13px;
            font-weight: 600;
        }

        .users-alert-message {
            display: block;
            font-size: 12px;
        }


        /* ÉXITO */

        .users-alert-success {
            border: 1px solid #b9e7c8;
            background: #f1fbf4;
            color: #176b3a;
        }

            .users-alert-success .users-alert-icon {
                background: #20a464;
                color: #ffffff;
            }

            .users-alert-success .users-alert-title {
                color: #176b3a;
            }

            .users-alert-success .users-alert-message {
                color: #397653;
            }


        /* ERROR */

        .users-alert-error {
            border: 1px solid #f0c2c2;
            background: #fff5f5;
            color: #a52828;
        }

            .users-alert-error .users-alert-icon {
                background: #dc3545;
                color: #ffffff;
            }

            .users-alert-error .users-alert-title {
                color: #a52828;
            }

            .users-alert-error .users-alert-message {
                color: #8f3a3a;
            }


        @@keyframes usersAlertAppear {

            from {
                opacity: 0;
                transform: translateY(-5px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }


        /* =========================================
                           TABLA
                        ========================================= */

        .users-search {
            width: 300px;
        }

            .users-search .input-group-text {
                background: #ffffff;
                border-right: 0;
            }

            .users-search .form-control {
                border-left: 0;
            }

                .users-search .form-control:focus {
                    border-color: #dee2e6;
                    box-shadow: none;
                }

        .user-avatar {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #eaf2ff;
            color: #0d6efd;
            font-weight: 600;
            flex-shrink: 0;
        }

        .user-name {
            font-weight: 600;
            color: #212529;
        }

        .user-username {
            font-size: 12px;
            color: #8a8f98;
            margin-top: 2px;
        }

        .user-actions {
            display: flex;
            justify-content: flex-end;
            gap: 5px;
        }

        .user-action-button {
            width: 34px;
            height: 34px;
            padding: 0;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 7px;
            background: #ffffff;
            transition: all 0.2s ease;
        }

            .user-action-button:hover {
                transform: translateY(-1px);
            }

        .user-empty {
            padding: 55px 20px;
            text-align: center;
            color: #6c757d;
        }

            .user-empty i {
                font-size: 40px;
                display: block;
                margin-bottom: 12px;
            }


        /* =========================================
                           MODAL CAMBIAR ESTADO
                        ========================================= */

        .estado-modal {
            position: fixed;
            inset: 0;
            display: none;
            align-items: center;
            justify-content: center;
            z-index: 9999;
        }

            .estado-modal.active {
                display: flex;
            }

        .estado-modal-overlay {
            position: absolute;
            inset: 0;
            background: rgba(15, 23, 42, 0.45);
            backdrop-filter: blur(2px);
        }

        .estado-modal-content {
            position: relative;
            width: 420px;
            max-width: calc(100% - 32px);
            padding: 30px;
            background: #ffffff;
            border-radius: 14px;
            box-shadow: 0 20px 50px rgba(0, 0, 0, 0.18);
            text-align: center;
            animation: estadoModalAppear 0.2s ease-out;
        }

        .estado-modal-icon {
            width: 52px;
            height: 52px;
            margin: 0 auto 18px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
            background: #fff1f2;
            color: #dc3545;
            font-size: 21px;
        }

            .estado-modal-icon.activar {
                background: #ecfdf3;
                color: #198754;
            }

        .estado-modal-content h5 {
            margin-bottom: 10px;
            font-size: 18px;
            font-weight: 600;
            color: #111827;
        }

        .estado-modal-content p {
            margin-bottom: 25px;
            font-size: 13px;
            line-height: 1.6;
            color: #6b7280;
        }

        .estado-modal-actions {
            display: flex;
            justify-content: center;
            gap: 10px;
        }

        .estado-modal-cancel,
        .estado-modal-confirm {
            height: 38px;
            padding: 0 17px;
            border-radius: 8px;
            font-size: 13px;
            font-weight: 500;
            transition: all 0.2s ease;
        }

        .estado-modal-cancel {
            background: #ffffff;
            border: 1px solid #dee2e6;
            color: #495057;
        }

            .estado-modal-cancel:hover {
                background: #f8f9fa;
            }

        .estado-modal-confirm {
            background: #171717;
            border: 1px solid #171717;
            color: #ffffff;
        }

            .estado-modal-confirm:hover {
                background: #2b2b2b;
                border-color: #2b2b2b;
                transform: translateY(-1px);
            }

        @@keyframes estadoModalAppear {

            from {
                opacity: 0;
                transform: translateY(8px) scale(0.98);
            }

            to {
                opacity: 1;
                transform: translateY(0) scale(1);
            }
        }


        /* =========================================
                           MODAL CAMBIAR CONTRASEÑA
                        ========================================= */

        .password-modal-content {
            text-align: left;
        }

            .password-modal-content h5 {
                text-align: center;
            }

            .password-modal-content > p {
                text-align: center;
            }

        .password-modal-icon {
            background: #f0f4f8;
            color: #1f2937;
        }

        .password-field {
            margin-bottom: 16px;
        }

            .password-field label {
                display: block;
                margin-bottom: 6px;
                font-size: 12px;
                font-weight: 600;
                color: #374151;
            }

        .password-input-wrapper {
            position: relative;
        }

            .password-input-wrapper .form-control {
                height: 40px;
                padding-right: 42px;
                border-radius: 8px;
                font-size: 13px;
            }

                .password-input-wrapper .form-control:focus {
                    border-color: #adb5bd;
                    box-shadow: 0 0 0 0.15rem rgba(23, 23, 23, 0.08);
                }

        .password-toggle {
            position: absolute;
            top: 50%;
            right: 8px;
            transform: translateY(-50%);
            border: 0;
            background: transparent;
            color: #6b7280;
            width: 30px;
            height: 30px;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
        }

            .password-toggle:hover {
                color: #171717;
            }

        .password-error {
            display: none;
            margin-bottom: 16px;
            padding: 9px 11px;
            border-radius: 7px;
            background: #fff5f5;
            border: 1px solid #f0c2c2;
            color: #a52828;
            font-size: 12px;
        }

            .password-error.active {
                display: block;
            }

    </style>
}


<!-- =========================================
     ENCABEZADO
========================================= -->

<div class="users-page-header">

    <div class="users-page-heading">

        <div class="users-page-icon">
            <i class="bi bi-people"></i>
        </div>

        <div>

            <h1 class="users-page-title">
                Usuarios
            </h1>

            <div class="users-page-subtitle">
                Administra las cuentas, roles y permisos de acceso a Charlie Shop.
            </div>

        </div>

    </div>


    <a asp-action="Crear"
       class="users-primary-button">

        <i class="bi bi-person-plus"></i>

        Nuevo usuario

    </a>

</div>


<!-- =========================================
     MENSAJES
========================================= -->
@if (TempData["Mensaje"] != null)
{
    <div class="users-alert users-alert-success">

        <div class="users-alert-icon">
            <i class="bi bi-check-lg"></i>
        </div>

        <div class="users-alert-content">

            <span class="users-alert-title">
                Operación completada
            </span>

            <span class="users-alert-message">
                @TempData["Mensaje"]
            </span>

        </div>

    </div>
}


@if (TempData["Error"] != null)
{
    <div class="users-alert users-alert-error">

        <div class="users-alert-icon">
            <i class="bi bi-exclamation-lg"></i>
        </div>

        <div class="users-alert-content">

            <span class="users-alert-title">
                No fue posible completar la operación
            </span>

            <span class="users-alert-message">
                @TempData["Error"]
            </span>

        </div>

    </div>
}


<!-- =========================================
     RESUMEN
========================================= -->

<div class="row g-3 mb-4">

    <div class="col-md-4">

        <div class="card p-3 h-100">

            <div class="d-flex align-items-center">

                <div class="rounded-circle bg-primary bg-opacity-10
                    text-primary d-flex align-items-center
                    justify-content-center"
                     style="width:44px;height:44px;">

                    <i class="bi bi-people fs-5"></i>

                </div>

                <div class="ms-3">

                    <div class="text-muted small">
                        Total de usuarios
                    </div>

                    <div class="fs-4 fw-semibold">
                        @(Model?.Count() ?? 0)
                    </div>

                </div>

            </div>

        </div>

    </div>


    <div class="col-md-4">

        <div class="card p-3 h-100">

            <div class="d-flex align-items-center">

                <div class="rounded-circle bg-success bg-opacity-10
                    text-success d-flex align-items-center
                    justify-content-center"
                     style="width:44px;height:44px;">

                    <i class="bi bi-person-check fs-5"></i>

                </div>

                <div class="ms-3">

                    <div class="text-muted small">
                        Usuarios activos
                    </div>

                    <div class="fs-4 fw-semibold">
                        @(Model?.Count(x => x.Estado) ?? 0)
                    </div>

                </div>

            </div>

        </div>

    </div>


    <div class="col-md-4">

        <div class="card p-3 h-100">

            <div class="d-flex align-items-center">

                <div class="rounded-circle bg-secondary bg-opacity-10
                    text-secondary d-flex align-items-center
                    justify-content-center"
                     style="width:44px;height:44px;">

                    <i class="bi bi-person-x fs-5"></i>

                </div>

                <div class="ms-3">

                    <div class="text-muted small">
                        Usuarios inactivos
                    </div>

                    <div class="fs-4 fw-semibold">
                        @(Model?.Count(x => !x.Estado) ?? 0)
                    </div>

                </div>

            </div>

        </div>

    </div>

</div>


<!-- =========================================
     LISTA
========================================= -->

<div class="card p-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h5 class="mb-1">
                Lista de usuarios
            </h5>

            <span class="text-muted small">
                Usuarios registrados en Charlie Shop
            </span>

        </div>


        <div class="users-search">

            <div class="input-group">

                <span class="input-group-text">
                    <i class="bi bi-search"></i>
                </span>

                <input type="text"
                       id="buscarUsuario"
                       class="form-control"
                       placeholder="Buscar usuario..." />

            </div>

        </div>

    </div>


    <div class="table-responsive">

        <table class="table table-hover align-middle"
               id="tablaUsuarios">

            <thead>

                <tr>

                    <th>Usuario</th>

                    <th>Correo electrónico</th>

                    <th>Rol</th>

                    <th>Estado</th>

                    <th class="text-end">Acciones</th>

                </tr>

            </thead>


            <tbody>

                @if (Model != null && Model.Any())
                {
                    foreach (var usuario in Model)
                    {
                        <tr>

                            <td>

                                <div class="d-flex align-items-center">

                                    <div class="user-avatar">

                                        @(string.IsNullOrWhiteSpace(usuario.Nombre)
                                            ? "?"
                                            : usuario.Nombre.Substring(0, 1).ToUpper())

                                    </div>

                                    <div class="ms-3">

                                        <div class="user-name">
                                            @usuario.Nombre
                                        </div>

                                        <div class="user-username">
                                            @usuario.UsuarioNombre
                                        </div>

                                    </div>

                                </div>

                            </td>


                            <td>

                                @if (!string.IsNullOrWhiteSpace(usuario.Email))
                                {
                                    @usuario.Email
                                }
                                else
                                {
                                    <span class="text-muted">
                                        Sin correo
                                    </span>
                                }

                            </td>


                            <td>

                                <span class="badge bg-light text-dark border">
                                    @usuario.NombreRol
                                </span>

                            </td>


                            <td>

                                @if (usuario.Estado)
                                {
                                    <span class="badge bg-success">

                                        <i class="bi bi-check-circle me-1"></i>

                                        Activo

                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">

                                        <i class="bi bi-x-circle me-1"></i>

                                        Inactivo

                                    </span>
                                }

                            </td>


                            <td>

                                <div class="user-actions">

                                    <!-- EDITAR -->

                                    <a asp-action="Editar"
                                       asp-route-id="@usuario.IdUsuario"
                                       class="btn btn-sm btn-outline-primary user-action-button"
                                       title="Editar usuario">

                                        <i class="bi bi-pencil"></i>

                                    </a>


                                    <!-- CAMBIAR CONTRASEÑA -->

                                    <button type="button"
                                            class="btn btn-sm btn-outline-secondary user-action-button"
                                            title="Cambiar contraseña"
                                            onclick="abrirModalContrasena(
                                        @usuario.IdUsuario,
                                        '@Html.Raw(usuario.Nombre.Replace("'", "\\'"))'
                                        )">

                                        <i class="bi bi-key"></i>

                                    </button>


                                    <!-- ACTIVAR / DESACTIVAR -->
                                    @if (usuario.Estado)
                                    {
                                        <button type="button"
                                                class="btn btn-sm btn-outline-danger user-action-button"
                                                title="Desactivar usuario"
                                                onclick="abrirModalEstado(
                                            @usuario.IdUsuario,
                                            '@Html.Raw(usuario.Nombre.Replace("'", "\\'"))',
                                            false
                                            )">

                                            <i class="bi bi-person-x"></i>

                                        </button>
                                    }
                                    else
                                    {
                                        <button type="button"
                                                class="btn btn-sm btn-outline-success user-action-button"
                                                title="Activar usuario"
                                                onclick="abrirModalEstado(
                                            @usuario.IdUsuario,
                                            '@Html.Raw(usuario.Nombre.Replace("'", "\\'"))',
                                            true
                                            )">

                                            <i class="bi bi-person-check"></i>

                                        </button>
                                    }

                                </div>

                            </td>

                        </tr>
                    }
                }
                else
                {
                    <tr>

                        <td colspan="5">

                            <div class="user-empty">

                                <i class="bi bi-people"></i>

                                <div class="fw-semibold">
                                    No hay usuarios registrados
                                </div>

                                <div class="small">
                                    Crea un nuevo usuario para comenzar.
                                </div>

                            </div>

                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>


<!-- =========================================
     MODAL CAMBIAR ESTADO
========================================= -->

<div id="estadoUsuarioModal"
     class="estado-modal">

    <div class="estado-modal-overlay"
         onclick="cerrarModalEstado()"></div>

    <div class="estado-modal-content">

        <div id="estadoModalIcon"
             class="estado-modal-icon">

            <i class="bi bi-person-x"></i>

        </div>

        <h5 id="estadoModalTitulo">
            Desactivar usuario
        </h5>

        <p id="estadoModalMensaje">
            ¿Está seguro de que desea desactivar este usuario?
        </p>

        <div class="estado-modal-actions">

            <button type="button"
                    class="estado-modal-cancel"
                    onclick="cerrarModalEstado()">

                Cancelar

            </button>

            <form id="estadoUsuarioForm"
                  asp-action="CambiarEstado"
                  method="post">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       id="estadoUsuarioId"
                       name="id" />

                <input type="hidden"
                       id="estadoUsuarioEstado"
                       name="estado" />

                <button type="submit"
                        id="estadoModalConfirmar"
                        class="estado-modal-confirm">

                    Desactivar usuario

                </button>

            </form>

        </div>

    </div>

</div>


<!-- =========================================
     MODAL CAMBIAR CONTRASEÑA
========================================= -->

<div id="contrasenaUsuarioModal"
     class="estado-modal">

    <div class="estado-modal-overlay"
         onclick="cerrarModalContrasena()"></div>

    <div class="estado-modal-content password-modal-content">

        <div class="estado-modal-icon password-modal-icon">

            <i class="bi bi-key"></i>

        </div>

        <h5>
            Cambiar contraseña
        </h5>

        <p id="contrasenaUsuarioNombre">
            Cambiar contraseña del usuario
        </p>


        <form asp-action="CambiarContrasenaUsuario"
              method="post"
              id="cambiarContrasenaForm">

            @Html.AntiForgeryToken()

            <input type="hidden"
                   id="contrasenaUsuarioId"
                   name="IdUsuario" />


            <!-- NUEVA CONTRASEÑA -->

            <div class="password-field">

                <label for="nuevaContrasena">
                    Nueva contraseña
                </label>

                <div class="password-input-wrapper">

                    <input type="password"
                           id="nuevaContrasena"
                           name="NuevaContrasena"
                           class="form-control"
                           autocomplete="new-password" />

                    <button type="button"
                            class="password-toggle"
                            onclick="alternarContrasena('nuevaContrasena', this)"
                            tabindex="-1">

                        <i class="bi bi-eye"></i>

                    </button>

                </div>

            </div>


            <!-- CONFIRMAR CONTRASEÑA -->

            <div class="password-field">

                <label for="confirmarContrasena">
                    Confirmar nueva contraseña
                </label>

                <div class="password-input-wrapper">

                    <input type="password"
                           id="confirmarContrasena"
                           name="ConfirmarContrasena"
                           class="form-control"
                           autocomplete="new-password" />

                    <button type="button"
                            class="password-toggle"
                            onclick="alternarContrasena('confirmarContrasena', this)"
                            tabindex="-1">

                        <i class="bi bi-eye"></i>

                    </button>

                </div>

            </div>


            <!-- ERROR DE COINCIDENCIA -->

            <div id="contrasenaError"
                 class="password-error">

                Las contraseñas no coinciden.

            </div>


            <!-- BOTONES -->

            <div class="estado-modal-actions">

                <button type="button"
                        class="estado-modal-cancel"
                        onclick="cerrarModalContrasena()">

                    Cancelar

                </button>

                <button type="submit"
                        class="estado-modal-confirm">

                    Cambiar contraseña

                </button>

            </div>

        </form>

    </div>

</div>


@section Scripts
{
    <script>

        /* =========================================
           BUSCAR USUARIO
        ========================================= */

        document
            .getElementById("buscarUsuario")
            .addEventListener("keyup", function() {

                const texto = this.value.toLowerCase();

                const filas =
                    document.querySelectorAll("#tablaUsuarios tbody tr");

                filas.forEach(function(fila) {

                    const contenido =
                        fila.textContent.toLowerCase();

                    fila.style.display =
                        contenido.includes(texto)
                            ? ""
                            : "none";

                });

            });


        /* =========================================
           MODAL ACTIVAR / DESACTIVAR
        ========================================= */

        function abrirModalEstado(id, nombre, estado) {

            document.getElementById("estadoUsuarioId").value = id;

            document.getElementById("estadoUsuarioEstado").value = estado;

            const modal =
                document.getElementById("estadoUsuarioModal");

            const icon =
                document.getElementById("estadoModalIcon");

            const titulo =
                document.getElementById("estadoModalTitulo");

            const mensaje =
                document.getElementById("estadoModalMensaje");

            const confirmar =
                document.getElementById("estadoModalConfirmar");


            if (estado) {

                icon.classList.add("activar");

                icon.innerHTML =
                    '<i class="bi bi-person-check"></i>';

                titulo.textContent =
                    "Activar usuario";

                mensaje.textContent =
                    `¿Desea volver a activar a ${nombre}?`;

                confirmar.textContent =
                    "Activar usuario";

            }
            else {

                icon.classList.remove("activar");

                icon.innerHTML =
                    '<i class="bi bi-person-x"></i>';

                titulo.textContent =
                    "Desactivar usuario";

                mensaje.textContent =
                    `¿Está seguro de que desea desactivar a ${nombre}?`;

                confirmar.textContent =
                    "Desactivar usuario";

            }

            modal.classList.add("active");
        }


        function cerrarModalEstado() {

            document
                .getElementById("estadoUsuarioModal")
                .classList.remove("active");

        }


        /* =========================================
           MODAL CAMBIAR CONTRASEÑA
        ========================================= */

        function abrirModalContrasena(id, nombre) {

            document
                .getElementById("contrasenaUsuarioId")
                .value = id;

            document
                .getElementById("contrasenaUsuarioNombre")
                .textContent =
                `Cambiar contraseña de ${nombre}`;

            document
                .getElementById("nuevaContrasena")
                .value = "";

            document
                .getElementById("confirmarContrasena")
                .value = "";

            document
                .getElementById("contrasenaError")
                .classList.remove("active");

            document
                .getElementById("contrasenaUsuarioModal")
                .classList.add("active");

        }


        function cerrarModalContrasena() {

            document
                .getElementById("contrasenaUsuarioModal")
                .classList.remove("active");

        }


        /* =========================================
           MOSTRAR / OCULTAR CONTRASEÑA
        ========================================= */

        function alternarContrasena(id, boton) {

            const input =
                document.getElementById(id);

            const icon =
                boton.querySelector("i");


            if (input.type === "password") {

                input.type = "text";

                icon.className =
                    "bi bi-eye-slash";

            }
            else {

                input.type = "password";

                icon.className =
                    "bi bi-eye";

            }

        }


        /* =========================================
           VALIDAR CONTRASEÑAS
        ========================================= */

        document
            .getElementById("cambiarContrasenaForm")
            .addEventListener("submit", function(event) {

                const nueva =
                    document.getElementById("nuevaContrasena").value.trim();

                const confirmar =
                    document.getElementById("confirmarContrasena").value.trim();

                const error =
                    document.getElementById("contrasenaError");


                if (nueva === "" || confirmar === "") {

                    event.preventDefault();

                    error.textContent =
                        "Debe completar ambos campos de contraseña.";

                    error.classList.add("active");

                    return;

                }


                if (nueva !== confirmar) {

                    event.preventDefault();

                    error.textContent =
                        "Las contraseñas no coinciden.";

                    error.classList.add("active");

                    return;

                }

                error.classList.remove("active");

            });


    </script>
}