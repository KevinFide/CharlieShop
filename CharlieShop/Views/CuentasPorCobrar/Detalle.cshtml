
@model CharlieShop.Models.DetalleCuentaPorCobrarViewModel

@{
    ViewData["Title"] = "Detalle de cuenta por cobrar";
    ViewData["Breadcrumbs"] = new List<(string Texto, string? Controlador, string? Accion)>
    {
        ("Inicio", "Home", "Index"),
        ("Cuentas por cobrar", "CuentasPorCobrar", "Index"),
        ("Detalle de cuenta", null, null)
    };

    bool vencida = Model.Estado == "VENCIDA";
    bool pagada = Model.Estado == "PAGADA";
    bool tieneSaldo = Model.SaldoPendiente > 0;
}

<div class="container-fluid cxc-detalle">

    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
        <div>
            <h2 class="fw-bold mb-1">Detalle de cuenta por cobrar</h2>
            <p class="text-muted mb-0">
                Información de la cuenta, saldo pendiente y pagos registrados.
            </p>
        </div>

        <a asp-controller="CuentasPorCobrar"
           asp-action="Index"
           class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>
            Volver a cuentas
        </a>
    </div>

    @if (TempData["ExitoPago"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle me-2"></i>
            @TempData["ExitoPago"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorPago"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle me-2"></i>
            @TempData["ErrorPago"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- INFORMACIÓN PRINCIPAL -->
    <div class="row g-3 mb-4">

        <div class="col-lg-8">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white py-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <h5 class="fw-bold mb-0">
                            <i class="bi bi-receipt me-2 text-primary"></i>
                            Cuenta #@Model.IdCxc
                        </h5>

                        @if (pagada)
                        {
                            <span class="badge bg-success-subtle text-success">PAGADA</span>
                        }
                        else if (vencida)
                        {
                            <span class="badge bg-danger-subtle text-danger">VENCIDA</span>
                        }
                        else if (Model.Estado == "PARCIAL")
                        {
                            <span class="badge bg-warning-subtle text-warning-emphasis">PARCIAL</span>
                        }
                        else
                        {
                            <span class="badge bg-primary-subtle text-primary">PENDIENTE</span>
                        }
                    </div>
                </div>

                <div class="card-body">
                    <div class="row g-4">

                        <div class="col-md-6">
                            <span class="detail-label">Cliente</span>
                            <div class="detail-value">@Model.NombreCliente</div>
                        </div>

                        <div class="col-md-6">
                            <span class="detail-label">Identificación</span>
                            <div class="detail-value">
                                @(string.IsNullOrWhiteSpace(Model.Identificacion)
                                    ? "No disponible"
                                    : Model.Identificacion)
                            </div>
                        </div>

                        <div class="col-md-6">
                            <span class="detail-label">Teléfono</span>
                            <div class="detail-value">
                                @(string.IsNullOrWhiteSpace(Model.Telefono)
                                    ? "No disponible"
                                    : Model.Telefono)
                            </div>
                        </div>

                        <div class="col-md-6">
                            <span class="detail-label">Correo electrónico</span>
                            <div class="detail-value">
                                @(string.IsNullOrWhiteSpace(Model.Email)
                                    ? "No disponible"
                                    : Model.Email)
                            </div>
                        </div>

                        <div class="col-md-6">
                            <span class="detail-label">Venta asociada</span>
                            <div class="detail-value">Venta #@Model.IdVenta</div>
                        </div>

                        <div class="col-md-6">
                            <span class="detail-label">Forma de pago</span>
                            <div class="detail-value">@Model.FormaPago</div>
                        </div>

                        <div class="col-md-6">
                            <span class="detail-label">Fecha de emisión</span>
                            <div class="detail-value">@Model.Fecha.ToString("dd/MM/yyyy")</div>
                        </div>

                        <div class="col-md-6">
                            <span class="detail-label">Fecha de vencimiento</span>
                            <div class="detail-value">@Model.FechaVencimiento.ToString("dd/MM/yyyy")</div>
                        </div>

                    </div>
                </div>
            </div>
        </div>

        <!-- RESUMEN FINANCIERO -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white py-3">
                    <h5 class="fw-bold mb-0">
                        <i class="bi bi-cash-stack me-2 text-primary"></i>
                        Resumen de cuenta
                    </h5>
                </div>

                <div class="card-body">
                    <div class="financial-item">
                        <span>Total original</span>
                        <strong>₡@Model.Total.ToString("N2")</strong>
                    </div>

                    <div class="financial-item">
                        <span>Saldo pendiente</span>
                        <strong class="text-primary fs-5">
                            ₡@Model.SaldoPendiente.ToString("N2")
                        </strong>
                    </div>

                    <div class="financial-item">
                        <span>Total abonado</span>
                        <strong class="text-success">
                            ₡@((Model.Total - Model.SaldoPendiente).ToString("N2"))
                        </strong>
                    </div>

                    <div class="progress mt-3" style="height: 9px;">
                        @{
                            decimal porcentajePagado = Model.Total > 0
                                ? ((Model.Total - Model.SaldoPendiente) / Model.Total) * 100
                                : 0;

                            porcentajePagado = Math.Clamp(porcentajePagado, 0, 100);
                        }
                        <div class="progress-bar bg-success"
                             role="progressbar"
                             style="width: @porcentajePagado.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%"
                             aria-valuenow="@porcentajePagado"
                             aria-valuemin="0"
                             aria-valuemax="100">
                        </div>
                    </div>

                    <small class="text-muted d-block mt-2">
                        @porcentajePagado.ToString("N1")% del total pagado
                    </small>
                </div>
            </div>
        </div>

    </div>

    <!-- REGISTRAR PAGO -->
    @if (tieneSaldo)
    {
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-white py-3">
                <h5 class="fw-bold mb-0">
                    <i class="bi bi-plus-circle me-2 text-primary"></i>
                    Registrar pago
                </h5>
                <small class="text-muted">
                    Registre un abono para actualizar el saldo de esta cuenta.
                </small>
            </div>

            <div class="card-body">
                <form asp-controller="CuentasPorCobrar"
                      asp-action="RegistrarPago"
                      method="post">

                    @Html.AntiForgeryToken()

                    <input type="hidden" name="IdCxc" value="@Model.IdCxc" />

                    <div class="row g-3">

                        <div class="col-md-3">
                            <label for="Monto" class="form-label fw-semibold">
                                Monto del pago *
                            </label>
                            <div class="input-group">
                                <span class="input-group-text">₡</span>
                                <input type="number"
                                       id="Monto"
                                       name="Monto"
                                       class="form-control"
                                       min="0.01"
                                       max="@Model.SaldoPendiente.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                       step="0.01"
                                       required
                                       placeholder="0.00" />
                            </div>
                            <small class="text-muted">
                                Máximo: ₡@Model.SaldoPendiente.ToString("N2")
                            </small>
                        </div>

                        <div class="col-md-3">
                            <label for="MetodoPago" class="form-label fw-semibold">
                                Método de pago *
                            </label>
                            <select id="MetodoPago"
                                    name="MetodoPago"
                                    class="form-select"
                                    required>
                                <option value="">Seleccione...</option>
                                <option value="EFECTIVO">Efectivo</option>
                                <option value="TARJETA">Tarjeta</option>
                                <option value="TRANSFERENCIA">Transferencia</option>
                                <option value="SINPE">SINPE Móvil</option>
                            </select>
                        </div>

                        <div class="col-md-3">
                            <label for="Referencia" class="form-label fw-semibold">
                                Referencia
                            </label>
                            <input type="text"
                                   id="Referencia"
                                   name="Referencia"
                                   class="form-control"
                                   maxlength="100"
                                   placeholder="Número de referencia" />
                        </div>

                        <div class="col-md-3">
                            <label for="Observaciones" class="form-label fw-semibold">
                                Observaciones
                            </label>
                            <input type="text"
                                   id="Observaciones"
                                   name="Observaciones"
                                   class="form-control"
                                   placeholder="Observaciones del pago" />
                        </div>

                    </div>

                    <div class="d-flex justify-content-end mt-4">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-check-circle me-1"></i>
                            Registrar pago
                        </button>
                    </div>

                </form>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-success mb-4">
            <i class="bi bi-check-circle me-2"></i>
            Esta cuenta ya fue cancelada completamente. No tiene saldo pendiente.
        </div>
    }

    <!-- HISTORIAL DE PAGOS -->
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white py-3">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                <div>
                    <h5 class="fw-bold mb-1">
                        <i class="bi bi-clock-history me-2 text-primary"></i>
                        Historial de pagos
                    </h5>
                    <small class="text-muted">
                        Abonos registrados para esta cuenta.
                    </small>
                </div>

                <a asp-controller="CuentasPorCobrar"
                   asp-action="HistorialPagos"
                   asp-route-idCxc="@Model.IdCxc"
                   class="btn btn-outline-primary btn-sm">
                    Ver historial completo
                    <i class="bi bi-arrow-right ms-1"></i>
                </a>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Pago</th>
                        <th>Fecha</th>
                        <th>Método de pago</th>
                        <th>Referencia</th>
                        <th>Usuario</th>
                        <th class="text-end">Monto</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model.Pagos != null && Model.Pagos.Any())
                    {
                        @foreach (var pago in Model.Pagos)
                        {
                            <tr>
                                <td>#@pago.IdPago</td>
                                <td>@pago.FechaPago.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>@pago.MetodoPago</td>
                                <td>@(string.IsNullOrWhiteSpace(pago.Referencia) ? "—" : pago.Referencia)</td>
                                <td>@(string.IsNullOrWhiteSpace(pago.Usuario) ? "—" : pago.Usuario)</td>
                                <td class="text-end fw-semibold text-success">
                                    ₡@pago.Monto.ToString("N2")
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5">
                                <i class="bi bi-inbox fs-2 text-muted"></i>
                                <p class="fw-semibold mt-2 mb-1">
                                    No hay pagos registrados
                                </p>
                                <small class="text-muted">
                                    Los abonos realizados aparecerán en esta sección.
                                </small>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="card-footer bg-white text-muted small">
            @((Model.Pagos?.Count ?? 0)) pagos registrados en esta cuenta.
        </div>
    </div>

</div>

<style>
    .cxc-detalle {
        max-width: 1250px;
        margin: 0 auto;
        padding-bottom: 35px;
    }

    .cxc-detalle .card {
        border-radius: 12px;
        overflow: hidden;
    }

    .cxc-detalle .card-header {
        border-bottom: 1px solid #edf0f4;
    }

    .detail-label {
        display: block;
        color: #8490a0;
        font-size: 0.78rem;
        margin-bottom: 5px;
    }

    .detail-value {
        color: #263445;
        font-weight: 600;
        overflow-wrap: anywhere;
    }

    .financial-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        padding: 13px 0;
        border-bottom: 1px solid #edf0f4;
    }

    .financial-item:last-of-type {
        border-bottom: none;
    }

    .financial-item span {
        color: #788596;
        font-size: 0.9rem;
    }

    .financial-item strong {
        color: #263445;
    }

    .cxc-detalle .form-control,
    .cxc-detalle .form-select,
    .cxc-detalle .input-group-text {
        min-height: 42px;
        border-color: #dfe5ec;
    }

    .cxc-detalle .form-control:focus,
    .cxc-detalle .form-select:focus {
        border-color: #86b7fe;
        box-shadow: 0 0 0 0.15rem rgba(13, 110, 253, 0.12);
    }

    .cxc-detalle .table thead th {
        color: #778496;
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
        white-space: nowrap;
        padding: 14px;
    }

    .cxc-detalle .table tbody td {
        padding: 14px;
        font-size: 0.88rem;
    }

    @@media (max-width: 768px) {
        .cxc-detalle {
            padding-left: 8px;
            padding-right: 8px;
        }
    }
</style>
