@{
    ViewData["Title"] = "Cuentas por cobrar";
}

<div class="d-flex justify-content-between align-items-start mb-3">

    <div>

        <div class="page-title">
            Cuentas por cobrar
        </div>

        <div class="page-subtitle">
            Seguimiento de saldos pendientes y pagos de clientes.
        </div>

    </div>

    <div class="d-flex gap-2">
        <a asp-action="HistorialPagos" class="btn btn-outline-primary">
            <i class="bi bi-clock-history me-1"></i> Historial de pagos
        </a>
        <button class="btn btn-primary"><i class="bi bi-cash-coin me-1"></i> Registrar pago</button>
    </div>

</div>


<!-- RESUMEN -->

<div class="row g-3 mb-4">

    <div class="col-md-4">

        <div class="card metric">

            <div class="label">
                Total pendiente
            </div>

            <div class="value">
                ₡420.000
            </div>

        </div>

    </div>

    <div class="col-md-4">

        <div class="card metric">

            <div class="label">
                Clientes con saldo
            </div>

            <div class="value">
                12
            </div>

        </div>

    </div>

    <div class="col-md-4">

        <div class="card metric">

            <div class="label">
                Pagos registrados este mes
            </div>

            <div class="value">
                ₡185.000
            </div>

        </div>

    </div>

</div>


<!-- CUENTAS -->

<div class="card p-4">

    <div class="row mb-3">

        <div class="col-md-5">

            <input type="text"
                   class="form-control"
                   placeholder="Buscar cliente..." />

        </div>

        <div class="col-md-3">

            <select class="form-select">

                <option selected>
                    Todos los estados
                </option>

                <option>
                    Pendiente
                </option>

                <option>Vencida</option>

                <option>
                    Pagada
                </option>

            </select>

        </div>

    </div>


    <div class="table-responsive">

        <table class="table table-hover align-middle">

            <thead>

                <tr>

                    <th>Cliente</th>
                    <th>Venta</th>
                    <th>Fecha</th>
                    <th>Saldo</th>
                    <th>Estado</th>
                    <th>Acciones</th>

                </tr>

            </thead>

            <tbody>

                <tr>

                    <td>
                        Carlos Mora
                    </td>

                    <td>
                        #V-1047
                    </td>

                    <td>
                        08/08/2026
                    </td>

                    <td>
                        ₡72.500
                    </td>

                    <td>

                        <span class="badge bg-warning text-dark">
                            Pendiente
                        </span>

                    </td>

                    <td>

                        <button class="btn btn-sm btn-outline-primary">

                            <i class="bi bi-cash-coin"></i>

                        </button>

                        <button class="btn btn-sm btn-outline-secondary">

                            <i class="bi bi-eye"></i>

                        </button>

                    </td>

                </tr>


                <tr>

                    <td>
                        Sofía Vargas
                    </td>

                    <td>
                        #V-1039
                    </td>

                    <td>
                        02/08/2026
                    </td>

                    <td>
                        ₡35.000
                    </td>

                    <td>

                        <span class="badge bg-danger">
                            Vencida · 7 días
                        </span>

                    </td>

                    <td>

                        <button class="btn btn-sm btn-outline-primary">

                            <i class="bi bi-cash-coin"></i>

                        </button>

                        <button class="btn btn-sm btn-outline-secondary">

                            <i class="bi bi-eye"></i>

                        </button>

                    </td>

                </tr>


                <tr>

                    <td>
                        María López
                    </td>

                    <td>
                        #V-1035
                    </td>

                    <td>
                        30/07/2026
                    </td>

                    <td>
                        ₡0
                    </td>

                    <td>

                        <span class="badge bg-success">
                            Pagada
                        </span>

                    </td>

                    <td>

                        <button class="btn btn-sm btn-outline-secondary">

                            <i class="bi bi-eye"></i>

                        </button>

                    </td>

                </tr>

            </tbody>

        </table>

    </div>

</div>