
@model IEnumerable<CharlieShop.Models.HistorialPagoCuentaViewModel>

@{
    ViewData["Title"] = "Historial de pagos";

    var pagos = Model?.ToList()
        ?? new List<CharlieShop.Models.HistorialPagoCuentaViewModel>();

    decimal totalRecaudado = pagos.Sum(p => p.Monto);
    decimal promedioPago = pagos.Count > 0
        ? totalRecaudado / pagos.Count
        : 0;

    int? idCliente = ViewBag.IdCliente as int?;
    int? idCxc = ViewBag.IdCxc as int?;

    bool filtrado = idCliente.HasValue || idCxc.HasValue;
}

<div class="container-fluid cxc-historial">

    <!-- ENCABEZADO -->
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
        <div>
            <h2 class="fw-bold mb-1">Historial de pagos</h2>
            <p class="text-muted mb-0">
                Consulta de abonos y cancelaciones aplicados a cuentas por cobrar.
            </p>
        </div>

        <a asp-controller="CuentasPorCobrar"
           asp-action="Index"
           class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>
            Volver a cuentas
        </a>
    </div>

    <!-- MENSAJE DE ERROR -->
    @if (ViewBag.ErrorHistorial != null)
    {
        <div class="alert alert-danger">
            <i class="bi bi-exclamation-triangle me-2"></i>
            @ViewBag.ErrorHistorial
        </div>
    }

    <!-- FILTROS ACTIVOS -->
    @if (filtrado)
    {
        <div class="alert alert-info d-flex justify-content-between align-items-center flex-wrap gap-2">
            <div>
                <i class="bi bi-funnel me-2"></i>
                <strong>Consulta filtrada:</strong>

                @if (idCliente.HasValue)
                {
                    <span class="ms-1">Cliente #@idCliente</span>
                }

                @if (idCxc.HasValue)
                {
                    <span class="ms-1">Cuenta #@idCxc</span>
                }
            </div>

            <a asp-controller="CuentasPorCobrar"
               asp-action="HistorialPagos"
               class="btn btn-sm btn-outline-primary">
                Limpiar filtro
            </a>
        </div>
    }

    <!-- RESUMEN -->
    <div class="row g-3 mb-4">

        <div class="col-md-4">
            <div class="card metric-card h-100">
                <div class="metric-icon blue">
                    <i class="bi bi-cash-stack"></i>
                </div>
                <div class="metric-label">Total recaudado</div>
                <div class="metric-value">
                    ₡@totalRecaudado.ToString("N2")
                </div>
                <small class="text-muted">
                    Según los resultados actuales
                </small>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card metric-card h-100">
                <div class="metric-icon green">
                    <i class="bi bi-receipt"></i>
                </div>
                <div class="metric-label">Pagos registrados</div>
                <div class="metric-value">
                    @pagos.Count
                </div>
                <small class="text-muted">
                    Registros encontrados
                </small>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card metric-card h-100">
                <div class="metric-icon purple">
                    <i class="bi bi-calculator"></i>
                </div>
                <div class="metric-label">Promedio por pago</div>
                <div class="metric-value">
                    ₡@promedioPago.ToString("N2")
                </div>
                <small class="text-muted">
                    Monto promedio de los resultados
                </small>
            </div>
        </div>

    </div>

    <!-- TABLA -->
    <div class="card border-0 shadow-sm">

        <div class="card-header bg-white py-3">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                <div>
                    <h5 class="fw-bold mb-1">Pagos registrados</h5>
                    <small class="text-muted">
                        Detalle de los movimientos realizados.
                    </small>
                </div>

                <span class="text-muted small">
                    @pagos.Count registros
                </span>
            </div>
        </div>

        <div class="table-responsive">

            <table class="table table-hover align-middle mb-0">

                <thead class="table-light">
                    <tr>
                        <th>Pago</th>
                        <th>Fecha</th>
                        <th>Cliente</th>
                        <th>Cuenta</th>
                        <th>Venta</th>
                        <th>Método</th>
                        <th>Referencia</th>
                        <th class="text-end">Monto</th>
                        <th>Registrado por</th>
                        <th class="text-center">Acciones</th>
                    </tr>
                </thead>

                <tbody>

                    @if (pagos.Any())
                    {
                        @foreach (var pago in pagos)
                        {
                            <tr>
                                <td class="fw-semibold">
                                    #@pago.IdPago
                                </td>

                                <td class="text-nowrap">
                                    @pago.FechaPago.ToString("dd/MM/yyyy HH:mm")
                                </td>

                                <td>
                                    <div class="fw-semibold">
                                        @pago.NombreCliente
                                    </div>
                                    <small class="text-muted">
                                        @(string.IsNullOrWhiteSpace(pago.Identificacion)
                                            ? "Sin identificación"
                                            : pago.Identificacion)
                                    </small>
                                </td>

                                <td>
                                    #@pago.IdCxc
                                </td>

                                <td>
                                    #@pago.IdVenta
                                </td>

                                <td>
                                    <span class="method-badge">
                                        @pago.MetodoPago
                                    </span>
                                </td>

                                <td>
                                    @(string.IsNullOrWhiteSpace(pago.Referencia)
                                        ? "—"
                                        : pago.Referencia)
                                </td>

                                <td class="text-end fw-bold text-success text-nowrap">
                                    ₡@pago.Monto.ToString("N2")
                                </td>

                                <td>
                                    @(string.IsNullOrWhiteSpace(pago.Usuario)
                                        ? "No disponible"
                                        : pago.Usuario)
                                </td>

                                <td class="text-center">
                                    <a asp-controller="CuentasPorCobrar"
                                       asp-action="Detalle"
                                       asp-route-id="@pago.IdCxc"
                                       class="btn btn-sm btn-outline-primary"
                                       title="Consultar cuenta">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="10" class="text-center py-5">
                                <div class="empty-state">
                                    <i class="bi bi-inbox"></i>
                                    <h6 class="fw-bold mt-3">
                                        No hay pagos registrados
                                    </h6>
                                    <p class="text-muted mb-3">
                                        No se encontraron movimientos para los criterios seleccionados.
                                    </p>

                                    <a asp-controller="CuentasPorCobrar"
                                       asp-action="Index"
                                       class="btn btn-outline-primary btn-sm">
                                        Consultar cuentas por cobrar
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }

                </tbody>

            </table>

        </div>

        <div class="card-footer bg-white text-muted small">
            Mostrando @pagos.Count pagos registrados.
        </div>

    </div>

</div>

<style>
    .cxc-historial {
        max-width: 1450px;
        margin: 0 auto;
        padding-bottom: 35px;
    }

    .cxc-historial .card {
        border-radius: 12px;
        overflow: hidden;
    }

    .metric-card {
        padding: 20px;
        border: 1px solid #edf0f4;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.025);
    }

    .metric-icon {
        width: 38px;
        height: 38px;
        border-radius: 9px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 17px;
        margin-bottom: 14px;
    }

    .metric-icon.blue {
        background: #edf4ff;
        color: #3478c8;
    }

    .metric-icon.green {
        background: #e9f8ef;
        color: #259653;
    }

    .metric-icon.purple {
        background: #f1edff;
        color: #7556c9;
    }

    .metric-label {
        color: #8190a2;
        font-size: 0.78rem;
        text-transform: uppercase;
        font-weight: 600;
        margin-bottom: 5px;
    }

    .metric-value {
        color: #263445;
        font-size: 1.55rem;
        font-weight: 700;
        margin-bottom: 5px;
    }

    .cxc-historial .card-header {
        border-bottom: 1px solid #edf0f4;
    }

    .cxc-historial .table thead th {
        color: #778496;
        font-size: 0.72rem;
        font-weight: 700;
        text-transform: uppercase;
        white-space: nowrap;
        padding: 14px;
    }

    .cxc-historial .table tbody td {
        padding: 14px;
        font-size: 0.84rem;
    }

    .method-badge {
        display: inline-block;
        background: #f0f4f8;
        color: #536477;
        border-radius: 6px;
        padding: 5px 9px;
        font-size: 0.76rem;
        font-weight: 600;
        white-space: nowrap;
    }

    .empty-state {
        color: #8b98a8;
        padding: 15px;
    }

    .empty-state > i {
        font-size: 2rem;
    }

    @@media (max-width: 768px) {
        .cxc-historial {
            padding-left: 8px;
            padding-right: 8px;
        }

        .metric-value {
            font-size: 1.3rem;
        }
    }
</style>
