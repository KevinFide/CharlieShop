</style>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const searchInput = document.getElementById("productSearch");
            const searchButton = document.getElementById("searchButton");
            const searchResults = document.getElementById("searchResults");
            const catalogPagination = document.getElementById("catalogPagination");
            const catalogPageInfo = document.getElementById("catalogPageInfo");
            const catalogPageNumber = document.getElementById("catalogPageNumber");
            const catalogPrev = document.getElementById("catalogPrev");
            const catalogNext = document.getElementById("catalogNext");
            const searchMessage = document.getElementById("searchMessage");
            const cartActionMessage = document.getElementById("cartActionMessage");
            const selectedProductName = document.getElementById("selectedProductName");
            const selectedProductDetails = document.getElementById("selectedProductDetails");
            const selectedProductBadge = document.getElementById("selectedProductBadge");
            const selectedProductStock = document.getElementById("selectedProductStock");
            const quantityInput = document.getElementById("quantityInput");
            const addProductButton = document.getElementById("addProductButton");
            const cartBody = document.getElementById("cartTableBody");
            const cartEmpty = document.getElementById("cartEmpty");
            const cartTableWrapper = document.getElementById("cartTableWrapper");
            const cartCount = document.getElementById("cartCount");
            const summaryItems = document.getElementById("summaryItems");
            const summarySubtotal = document.getElementById("summarySubtotal");
            const summaryDiscount = document.getElementById("summaryDiscount");
            const summaryTax = document.getElementById("summaryTax");
            const summaryTotal = document.getElementById("summaryTotal");
            const liveSummaryTotal = document.getElementById("liveSummaryTotal");
            const liveSummaryItems = document.getElementById("liveSummaryItems");
            const goToSaleSummary = document.getElementById("goToSaleSummary");
            const cancelSaleFromBanner = document.getElementById("cancelSaleFromBanner");
            const cancelSaleModal = document.getElementById("cancelSaleModal");
            const keepSaleButton = document.getElementById("keepSaleButton");
            const acceptCancelSale = document.getElementById("acceptCancelSale");
            const saleSummaryPanel = document.querySelector(".sale-summary-panel");
            const mainMenuUrl = '@Url.Action("Index", "Ventas")';
            const discountPercentage = document.getElementById("discountPercentage");
            const discountPercentageHidden = document.getElementById("DescuentoPorcentaje");
            const productsJson = document.getElementById("ProductosJson");
            const saleForm = document.getElementById("saleForm");
            const finishSaleButton = document.getElementById("finishSaleButton");
            const clientSearchInput = document.getElementById("clientSearchInput");
            const clientSearchToggle = document.getElementById("clientSearchToggle");
            const clientSearchDropdown = document.getElementById("clientSearchDropdown");
            const confirmSaleModal = document.getElementById("confirmSaleModal");
            const confirmSaleItems = document.getElementById("confirmSaleItems");
            const confirmSaleTotal = document.getElementById("confirmSaleTotal");
            const cancelConfirmSale = document.getElementById("cancelConfirmSale");
            const acceptConfirmSale = document.getElementById("acceptConfirmSale");

            let saleSubmissionApproved = false;

            // Interacción visual temporal del selector de cliente.
            // No consulta ni envía clientes hasta implementar ese módulo.
            function toggleClientDropdown() {
                clientSearchDropdown.classList.toggle("d-none");
            }

            clientSearchToggle.addEventListener("click", toggleClientDropdown);

            clientSearchInput.addEventListener("focus", function () {
                clientSearchDropdown.classList.remove("d-none");
            });

            clientSearchInput.addEventListener("input", function () {
                clientSearchDropdown.classList.remove("d-none");
            });

            document.addEventListener("click", function (event) {
                if (!event.target.closest(".sale-client-field")) {
                    clientSearchDropdown.classList.add("d-none");
                }
            });

            const searchUrl = '@Url.Action("BuscarProductos", "Ventas")';

            let selectedProduct = null;
            let cart = [];
            let catalogProducts = [];
            let catalogPage = 1;

            const catalogPageSize = 6;

            const currency = new Intl.NumberFormat("es-CR", {
                style: "currency",
                currency: "CRC",
                minimumFractionDigits: 2
            });

            function showSearchMessage(message, isError = false) {
                searchMessage.textContent = message;
                searchMessage.classList.remove(
                    "d-none", "alert", "alert-danger", "alert-info"
                );
                searchMessage.classList.add(
                    "alert", isError ? "alert-danger" : "alert-info"
                );
            }

            function clearSearchMessage() {
                searchMessage.textContent = "";
                searchMessage.classList.add("d-none");
                searchMessage.classList.remove(
                    "alert", "alert-danger", "alert-info"
                );
            }

            function showCartActionMessage(message, isError = false) {
                cartActionMessage.textContent = message;
                cartActionMessage.classList.remove(
                    "d-none", "alert", "alert-danger",
                    "alert-success", "alert-info"
                );
                cartActionMessage.classList.add(
                    "alert", isError ? "alert-danger" : "alert-success"
                );
                cartActionMessage.scrollIntoView({
                    behavior: "smooth",
                    block: "nearest"
                });
            }

            function clearCartActionMessage() {
                cartActionMessage.textContent = "";
                cartActionMessage.classList.add("d-none");
                cartActionMessage.classList.remove(
                    "alert", "alert-danger", "alert-success", "alert-info"
                );
            }

            function selectProduct(product) {
                selectedProduct = product;
                selectedProductName.textContent = product.nombre;
                selectedProductDetails.textContent =
                    `${product.codigo} · ${currency.format(product.precioVenta)} · Stock: ${product.stockActual}`;
                selectedProductBadge.textContent =
                    product.stockActual > 0 ? "Seleccionado" : "Sin existencias";
                selectedProductStock.textContent = String(product.stockActual);
                quantityInput.max = String(product.stockActual);
                quantityInput.value = "1";
                clearSearchMessage();
            }

            function renderCatalogPage() {
                searchResults.innerHTML = "";

                const total = catalogProducts.length;
                const totalPages = Math.max(1, Math.ceil(total / catalogPageSize));

                if (total === 0) {
                    searchResults.innerHTML =
                        '<div class="sale-catalog-loading">No hay productos activos que coincidan con la búsqueda.</div>';
                    searchResults.classList.remove("d-none");
                    catalogPagination.classList.add("d-none");
                    return;
                }

                catalogPage = Math.min(Math.max(catalogPage, 1), totalPages);

                const startIndex = (catalogPage - 1) * catalogPageSize;
                const pageProducts = catalogProducts.slice(
                    startIndex,
                    startIndex + catalogPageSize
                );

                pageProducts.forEach(product => {
                    const card = document.createElement("article");
                    card.className = "sale-product-card";

                    const image = document.createElement("div");
                    image.className = "sale-product-image";
                    image.innerHTML = '<i class="bi bi-image"></i>';
                    image.setAttribute("aria-label", "Imagen de producto pendiente");

                    const body = document.createElement("div");
                    body.className = "sale-product-card-body";

                    const name = document.createElement("div");
                    name.className = "sale-product-card-title";
                    name.textContent = product.nombre;

                    const code = document.createElement("div");
                    code.className = "sale-product-card-code";
                    code.textContent = product.codigo;

                    const price = document.createElement("div");
                    price.className = "sale-product-card-price";
                    price.textContent = currency.format(Number(product.precioVenta || 0));

                    const stock = document.createElement("div");
                    stock.className = "sale-product-card-stock";
                    stock.textContent = `Stock disponible: ${Number(product.stockActual || 0)}`;

                    const button = document.createElement("button");
                    button.type = "button";
                    button.className = "btn btn-outline-dark btn-sm";
                    button.textContent = "Seleccionar";
                    button.addEventListener("click", () => selectProduct(product));

                    body.append(name, code, price, stock, button);
                    card.append(image, body);
                    searchResults.appendChild(card);
                });

                searchResults.classList.remove("d-none");
                catalogPagination.classList.toggle(
                    "d-none", total <= catalogPageSize
                );

                catalogPageInfo.textContent =
                    `Mostrando ${startIndex + 1}–${Math.min(startIndex + pageProducts.length, total)} de ${total} productos`;

                catalogPageNumber.textContent = `${catalogPage} / ${totalPages}`;
                catalogPrev.disabled = catalogPage <= 1;
                catalogNext.disabled = catalogPage >= totalPages;
            }

            async function searchProducts() {
                const term = searchInput.value.trim();

                searchButton.disabled = true;
                searchButton.textContent = "Buscando...";
                searchResults.innerHTML = "";
                searchResults.classList.remove("d-none");
                catalogPagination.classList.add("d-none");
                clearSearchMessage();

                try {
                    const response = await fetch(
                        `${searchUrl}?busqueda=${encodeURIComponent(term)}`,
                        {
                            headers: {
                                "X-Requested-With": "XMLHttpRequest"
                            }
                        }
                    );

                    const payload = await response.json().catch(() => null);

                    if (!response.ok) {
                        throw new Error(
                            payload?.mensaje ||
                            `Error HTTP ${response.status} al consultar el catálogo.`
                        );
                    }

                    if (!Array.isArray(payload)) {
                        throw new Error(
                            "La respuesta del catálogo no tiene el formato esperado."
                        );
                    }

                    catalogProducts = payload;
                    catalogPage = 1;

                    if (catalogProducts.length === 0) {
                        renderCatalogPage();

                        showSearchMessage(
                            term
                                ? "No se encontraron productos activos con ese código o nombre."
                                : "No hay productos activos para mostrar.",
                            false
                        );
                        return;
                    }

                    clearSearchMessage();
                    renderCatalogPage();
                } catch (error) {
                    catalogProducts = [];
                    renderCatalogPage();
                    showSearchMessage(
                        error.message || "Ocurrió un error al buscar productos.",
                        true
                    );
                } finally {
                    searchButton.disabled = false;
                    searchButton.textContent = "Buscar";
                }
            }

            catalogPrev.addEventListener("click", function () {
                if (catalogPage > 1) {
                    catalogPage--;
                    renderCatalogPage();
                }
            });

            catalogNext.addEventListener("click", function () {
                const totalPages = Math.ceil(
                    catalogProducts.length / catalogPageSize
                );

                if (catalogPage < totalPages) {
                    catalogPage++;
                    renderCatalogPage();
                }
            });

            function syncProductsJson() {
                productsJson.value = JSON.stringify(
                    cart.map(item => ({
                        IdProducto: item.idProducto,
                        Codigo: item.codigo,
                        Nombre: item.nombre,
                        Cantidad: item.cantidad,
                        PrecioUnitario: item.precioUnitario,
                        StockActual: item.stockActual
                    }))
                );
            }

            function renderCart() {
                cartBody.innerHTML = "";
                cartEmpty.classList.toggle("d-none", cart.length > 0);
                cartTableWrapper.classList.toggle("d-none", cart.length === 0);

                let units = 0;
                let subtotal = 0;

                cart.forEach((item, index) => {
                    units += item.cantidad;
                    subtotal += item.cantidad * item.precioUnitario;

                    const row = document.createElement("tr");

                    const productCell = document.createElement("td");
                    const productName = document.createElement("strong");
                    productName.textContent = item.nombre;

                    const productCode = document.createElement("div");
                    productCode.className = "text-muted small";
                    productCode.textContent = item.codigo;

                    productCell.appendChild(productName);
                    productCell.appendChild(productCode);

                    const priceCell = document.createElement("td");
                    priceCell.textContent = currency.format(item.precioUnitario);

                    const quantityCell = document.createElement("td");
                    const quantity = document.createElement("input");

                    quantity.type = "number";
                    quantity.min = "1";
                    quantity.step = "1";
                    quantity.inputMode = "numeric";
                    quantity.max = String(item.stockActual);
                    quantity.className = "sale-cart-quantity";
                    quantity.value = String(item.cantidad);
                    quantity.setAttribute(
                        "aria-label", `Cantidad de ${item.nombre}`
                    );

                    quantity.addEventListener("change", () => {
                        const rawQuantity = quantity.value.trim();
                        const next = Number(rawQuantity);

                        const otherQuantity = cart
                            .filter((_, i) => i !== index)
                            .filter(p => p.idProducto === item.idProducto)
                            .reduce((sum, p) => sum + p.cantidad, 0);

                        // Ingresar cero permite solicitar la eliminación del producto.
                        if (rawQuantity !== "" && next === 0) {
                            const confirmar = window.confirm(
                                `¿Deseás eliminar "${item.nombre}" del detalle de la venta?`
                            );

                            if (confirmar) {
                                cart = cart.filter(
                                    producto => producto.idProducto !== item.idProducto
                                );

                                clearCartActionMessage();
                                renderCart();

                                showCartActionMessage(
                                    `Se eliminó "${item.nombre}" del detalle de la venta.`
                                );
                            } else {
                                // Restaurar la cantidad anterior si se cancela.
                                renderCart();
                            }

                            return;
                        }

                        // Las cantidades deben ser enteros positivos.
                        if (
                            rawQuantity === "" ||
                            !Number.isFinite(next) ||
                            !Number.isInteger(next) ||
                            next < 0
                        ) {
                            showCartActionMessage(
                                "La cantidad debe ser un número entero mayor que cero. No se permiten decimales ni fracciones.",
                                true
                            );
                            renderCart();
                            return;
                        }

                        if (next + otherQuantity > item.stockActual) {
                            showCartActionMessage(
                                `La cantidad no puede superar el stock disponible (${item.stockActual}).`,
                                true
                            );
                            renderCart();
                            return;
                        }

                        item.cantidad = next;
                        clearCartActionMessage();
                        renderCart();
                    });

                    quantityCell.appendChild(quantity);

                    const subtotalCell = document.createElement("td");
                    subtotalCell.textContent = currency.format(
                        item.cantidad * item.precioUnitario
                    );

                    const actionCell = document.createElement("td");
                    actionCell.className = "text-end";

                    const removeButton = document.createElement("button");
                    removeButton.type = "button";
                    removeButton.className = "sale-remove-button";
                    removeButton.title = "Quitar producto";
                    removeButton.setAttribute(
                        "aria-label", `Quitar ${item.nombre}`
                    );
                    removeButton.innerHTML = '<i class="bi bi-trash"></i>';

                    removeButton.addEventListener("click", () => {
                        const productoExiste = cart.some(
                            producto => producto.idProducto === item.idProducto
                        );

                        if (!productoExiste) {
                            showCartActionMessage(
                                `El producto "${item.nombre}" ya no se encuentra en el detalle de la venta.`,
                                true
                            );

                            renderCart();
                            return;
                        }

                        const confirmar = window.confirm(
                            `¿Deseás eliminar "${item.nombre}" del detalle de la venta?`
                        );

                        if (!confirmar) {
                            return;
                        }

                        cart = cart.filter(
                            producto => producto.idProducto !== item.idProducto
                        );

                        renderCart();

                        showCartActionMessage(
                            `Se eliminó "${item.nombre}" del detalle de la venta.`
                        );
                    });

                    actionCell.appendChild(removeButton);
                    row.append(
                        productCell,
                        priceCell,
                        quantityCell,
                        subtotalCell,
                        actionCell
                    );
                    cartBody.appendChild(row);
                });

                subtotal = Math.round(
                    (subtotal + Number.EPSILON) * 100
                ) / 100;

                let discountRate = Number(discountPercentage.value);

                if (!Number.isFinite(discountRate)) {
                    discountRate = 0;
                }

                discountRate = Math.min(100, Math.max(0, discountRate));
                discountPercentage.value = String(discountRate);
                discountPercentageHidden.value = String(discountRate);

                const discountAmount = Math.round(
                    (subtotal * discountRate / 100 + Number.EPSILON) * 100
                ) / 100;

                const taxableAmount = Math.max(0, subtotal - discountAmount);

                const taxAmount = Math.round(
                    (taxableAmount * 0.13 + Number.EPSILON) * 100
                ) / 100;

                const total = Math.round(
                    (taxableAmount + taxAmount + Number.EPSILON) * 100
                ) / 100;

                cartCount.textContent =
                    `${cart.length} ${cart.length === 1 ? "producto" : "productos"}`;

                summaryItems.textContent = String(units);
                summarySubtotal.textContent = currency.format(subtotal);
                summaryDiscount.textContent = currency.format(discountAmount);
                summaryTax.textContent = currency.format(taxAmount);
                summaryTotal.textContent = currency.format(total);

                // Sincronizar la barra fija con el resumen financiero.
                liveSummaryTotal.textContent = currency.format(total);
                liveSummaryItems.textContent =
                    `${units} ${units === 1 ? "unidad" : "unidades"} · ${cart.length} ${cart.length === 1 ? "producto" : "productos"}`;

                syncProductsJson();
            }

            // Cancelar la venta desde el banner superior.
            // Si hay productos, solicitar confirmación antes de descartarlos.
            cancelSaleFromBanner.addEventListener("click", function () {
                if (cart.length === 0) {
                    window.location.href = mainMenuUrl;
                    return;
                }

                cancelSaleModal.classList.remove("d-none");
                acceptCancelSale.focus();
            });

            function closeCancelSaleModal() {
                cancelSaleModal.classList.add("d-none");
                cancelSaleFromBanner.focus();
            }

            keepSaleButton.addEventListener("click", closeCancelSaleModal);

            cancelSaleModal.addEventListener("click", function (event) {
                if (event.target === cancelSaleModal) {
                    closeCancelSaleModal();
                }
            });

            acceptCancelSale.addEventListener("click", function () {
                // La venta todavía no se ha enviado al servidor; salir descarta el carrito local.
                window.location.href = mainMenuUrl;
            });

            // Ir al resumen financiero sin desplazarse manualmente.
            goToSaleSummary.addEventListener("click", function () {
                saleSummaryPanel.scrollIntoView({
                    behavior: "smooth",
                    block: "center"
                });
            });

            discountPercentage.addEventListener("input", renderCart);

            searchButton.addEventListener("click", searchProducts);

            searchInput.addEventListener("keydown", event => {
                if (event.key === "Enter") {
                    event.preventDefault();
                    searchProducts();
                }
            });

            addProductButton.addEventListener("click", function () {
                clearCartActionMessage();

                if (!selectedProduct) {
                    showCartActionMessage(
                        "Buscá y seleccioná un producto antes de agregarlo.",
                        true
                    );
                    return;
                }

                const rawQuantity = quantityInput.value.trim();
                const quantity = Number(rawQuantity);

                if (
                    rawQuantity === "" ||
                    !Number.isFinite(quantity) ||
                    !Number.isInteger(quantity) ||
                    quantity <= 0
                ) {
                    showCartActionMessage(
                        "La cantidad debe ser un número entero mayor que cero. No se permiten decimales ni fracciones.",
                        true
                    );
                    quantityInput.focus();
                    return;
                }

                if (quantity > selectedProduct.stockActual) {
                    showCartActionMessage(
                        `Stock insuficiente. Disponible: ${selectedProduct.stockActual}.`,
                        true
                    );
                    return;
                }

                const existing = cart.find(
                    item => item.idProducto === selectedProduct.idProducto
                );

                const nextQuantity = (existing ? existing.cantidad : 0) + quantity;

                if (nextQuantity > selectedProduct.stockActual) {
                    showCartActionMessage(
                        `La cantidad total supera el stock disponible (${selectedProduct.stockActual}).`,
                        true
                    );
                    return;
                }

                if (existing) {
                    existing.cantidad = nextQuantity;
                } else {
                    cart.push({
                        idProducto: selectedProduct.idProducto,
                        codigo: selectedProduct.codigo,
                        nombre: selectedProduct.nombre,
                        cantidad: quantity,
                        precioUnitario: Number(selectedProduct.precioVenta),
                        stockActual: Number(selectedProduct.stockActual)
                    });
                }

                clearSearchMessage();
                clearCartActionMessage();
                renderCart();
            });

            saleForm.addEventListener("submit", function (event) {
                syncProductsJson();

                if (saleSubmissionApproved) {
                    finishSaleButton.disabled = true;
                    finishSaleButton.innerHTML =
                        '<span class="spinner-border spinner-border-sm me-2"></span>Procesando...';
                    return;
                }

                event.preventDefault();

                if (cart.length === 0) {
                    showCartActionMessage(
                        "Debe agregar al menos un producto antes de finalizar la venta.",
                        true
                    );
                    return;
                }

                // Validación final de cantidades y stock.
                const invalidQuantity = cart.find(item =>
                    !Number.isInteger(item.cantidad) ||
                    item.cantidad <= 0 ||
                    item.cantidad > item.stockActual
                );

                if (invalidQuantity) {
                    showCartActionMessage(
                        `La cantidad de "${invalidQuantity.nombre}" debe ser un entero positivo y no puede superar el stock disponible (${invalidQuantity.stockActual}).`,
                        true
                    );
                    renderCart();
                    return;
                }

                const discount = Number(
                    document.getElementById("discountPercentage").value || 0
                );

                if (
                    !Number.isFinite(discount) ||
                    discount < 0 ||
                    discount > 100
                ) {
                    showCartActionMessage(
                        "El descuento debe estar entre 0 y 100 %.",
                        true
                    );
                    return;
                }

                confirmSaleItems.textContent = String(
                    cart.reduce((sum, item) => sum + item.cantidad, 0)
                );

                confirmSaleTotal.textContent = summaryTotal.textContent;
                confirmSaleModal.classList.remove("d-none");
                acceptConfirmSale.focus();
            });

            function closeConfirmSaleModal() {
                confirmSaleModal.classList.add("d-none");
                finishSaleButton.focus();
            }

            cancelConfirmSale.addEventListener("click", closeConfirmSaleModal);

            confirmSaleModal.addEventListener("click", function (event) {
                if (event.target === confirmSaleModal) {
                    closeConfirmSaleModal();
                }
            });

            acceptConfirmSale.addEventListener("click", function () {
                syncProductsJson();
                saleSubmissionApproved = true;
                closeConfirmSaleModal();

                finishSaleButton.disabled = true;
                finishSaleButton.innerHTML =
                    '<span class="spinner-border spinner-border-sm me-2"></span>Procesando...';

                saleForm.requestSubmit();
            });

            document.addEventListener("keydown", function (event) {
                if (event.key !== "Escape") {
                    return;
                }

                if (!confirmSaleModal.classList.contains("d-none")) {
                    closeConfirmSaleModal();
                }

                if (!cancelSaleModal.classList.contains("d-none")) {
                    closeCancelSaleModal();
                }
            });

            renderCart();

            // Mostrar todo el catálogo al abrir la pantalla.
            // El campo de búsqueda permite filtrar por código o nombre.
            searchProducts();
        });
    </script>
}