@{
    ViewData["Title"] = "Registrar venta";
}

<div class="sale-create-page">
    <div class="sale-page-header">
        <div class="sale-page-heading">
            <div class="sale-page-icon"><i class="bi bi-cart-plus"></i></div>
            <div>
                <h1>Registrar venta</h1>
                <p>Agregá productos al carrito y revisá la compra antes de finalizar.</p>
            </div>
        </div>
        <a asp-action="Index" class="btn btn-outline-dark sale-back-button">
            <i class="bi bi-arrow-left me-1"></i> Volver a ventas
        </a>
    </div>

    @if (TempData["ErrorVenta"] != null)
    {
        <div class="alert alert-danger sale-alert" role="alert">@TempData["ErrorVenta"]</div>
    }

    @if (TempData["VentaExitosa"] != null)
    {
        <div class="alert alert-success sale-alert" role="status">
            @TempData["VentaExitosa"]
        </div>
    }

    <form asp-action="Finalizar" method="post" id="saleForm">
        @Html.AntiForgeryToken()
        <input type="hidden" id="ProductosJson" name="ProductosJson" value="[]" />
        <input type="hidden" name="IdCliente" value="" />
        <input type="hidden" id="DescuentoPorcentaje" name="DescuentoPorcentaje" value="0" />

        <div class="sale-layout">
            <div class="sale-main-column">
                <section class="sale-panel">
                    <div class="sale-panel-header">
                        <div>
                            <h2>Agregar productos</h2>
                            <p>Buscá el producto que desea comprar el cliente.</p>
                        </div>
                        <span class="sale-panel-icon"><i class="bi bi-search"></i></span>
                    </div>

                    <div class="sale-panel-body">
                        <label for="productSearch" class="form-label">Buscar producto</label>

                        <div class="input-group sale-search-group">
                            <span class="input-group-text"><i class="bi bi-search"></i></span>
                            <input id="productSearch" type="text" class="form-control"
                                   placeholder="Ingresá el código o nombre del producto"
                                   autocomplete="off" />
                            <button class="btn btn-dark" type="button" id="searchButton">Buscar</button>
                        </div>

                        <div class="sale-help-text">
                            Buscá por código o nombre y seleccioná el producto que querés agregar.
                        </div>

                        <div id="searchMessage" class="sale-feedback d-none" role="status"></div>

                        <div class="sale-catalog-heading">
                            <strong>Catálogo de productos</strong>
                            <span>También podés agregar productos desde esta lista sin escribir una búsqueda.</span>
                        </div>

                        <div id="searchResults" class="sale-search-results">
                            <div class="sale-catalog-loading">Cargando productos...</div>
                        </div>

                        <div id="catalogPagination" class="sale-pagination d-none">
                            <span id="catalogPageInfo" class="sale-page-info"></span>
                            <div class="sale-page-controls">
                                <button type="button" class="btn btn-outline-secondary btn-sm"
                                        id="catalogPrev" disabled>Anterior</button>
                                <span id="catalogPageNumber" class="sale-page-number">1</span>
                                <button type="button" class="btn btn-outline-secondary btn-sm"
                                        id="catalogNext" disabled>Siguiente</button>
                            </div>
                        </div>

                        <div class="sale-demo-product" id="selectedProductPanel">
                            <div class="sale-product-symbol"><i class="bi bi-box-seam"></i></div>
                            <div class="sale-product-data">
                                <strong id="selectedProductName">Producto seleccionado</strong>
                                <span id="selectedProductDetails">Los resultados de búsqueda aparecerán aquí.</span>
                            </div>
                            <span class="sale-product-placeholder" id="selectedProductBadge">Sin seleccionar</span>
                        </div>

                        <div class="sale-quantity-row">
                            <div class="sale-quantity-field">
                                <label for="quantityInput" class="form-label">Cantidad</label>
                                <input id="quantityInput" type="number" class="form-control"
                                       min="1" step="1" value="1" inputmode="numeric" />
                            </div>

                            <div class="sale-stock-placeholder">
                                <span>Stock disponible</span>
                                <strong id="selectedProductStock">—</strong>
                            </div>

                            <button type="button" class="btn btn-dark sale-add-button" id="addProductButton">
                                <i class="bi bi-plus-lg me-1"></i> Agregar al carrito
                            </button>
                        </div>

                        <div id="cartActionMessage" class="sale-feedback d-none"
                             role="alert" aria-live="polite"></div>

                        <div class="sale-prototype-notice">
                            <i class="bi bi-info-circle"></i>
                            <span>Seleccioná un producto del catálogo o buscá por código o nombre.
                                El stock se valida nuevamente al finalizar la venta.</span>
                        </div>
                    </div>
                </section>

                <section class="sale-panel sale-cart-panel">
                    <div class="sale-panel-header">
                        <div>
                            <h2>Detalle de la venta</h2>
                            <p>Productos que se incluirán en la transacción.</p>
                        </div>
                        <span class="sale-count-badge" id="cartCount">0 productos</span>
                    </div>

                    <div class="sale-cart-empty" id="cartEmpty">
                        <div class="sale-empty-icon"><i class="bi bi-cart3"></i></div>
                        <strong>El carrito está vacío</strong>
                        <span>Buscá un producto y agregalo para comenzar la venta.</span>
                    </div>

                    <div class="table-responsive d-none" id="cartTableWrapper">
                        <table class="table sale-cart-table mb-0">
                            <thead>
                                <tr>
                                    <th>Producto</th>
                                    <th>Precio</th>
                                    <th>Cantidad</th>
                                    <th>Subtotal</th>
                                    <th class="text-end">Acción</th>
                                </tr>
                            </thead>
                            <tbody id="cartTableBody"></tbody>
                        </table>
                    </div>
                </section>
            </div>

            <aside class="sale-summary-panel" id="saleSummaryPanel">
                <div class="sale-summary-header">
                    <div class="sale-summary-icon"><i class="bi bi-receipt"></i></div>
                    <div>
                        <h2>Resumen de venta</h2>
                        <p>Revisá los datos antes de confirmar.</p>
                    </div>
                </div>

                <div class="sale-summary-body">
                    <div class="sale-client-field">
                        <label for="clientSearchInput" class="form-label">
                            Cliente <span class="text-danger">*</span>
                        </label>

                        <div class="input-group sale-client-search">
                            <span class="input-group-text"><i class="bi bi-person-search"></i></span>
                            <input type="text" id="clientSearchInput" class="form-control"
                                   placeholder="Buscar por nombre o identificación..."
                                   autocomplete="off" aria-label="Buscar cliente" />
                            <button class="btn btn-outline-secondary" type="button"
                                    id="clientSearchToggle" aria-label="Mostrar clientes">
                                <i class="bi bi-chevron-down"></i>
                            </button>
                        </div>

                        <div class="sale-client-dropdown d-none" id="clientSearchDropdown">
                            <div class="sale-client-empty">
                                <i class="bi bi-people"></i>
                                <strong>Selector de clientes</strong>
                                <span>Se conectará cuando esté implementado el módulo de Clientes.</span>
                            </div>
                        </div>

                        <div class="sale-help-text">Seleccioná el cliente al que corresponde la venta.</div>
                    </div>

                    <label for="paymentMethod" class="form-label">Forma de pago</label>
                    <select id="paymentMethod" name="FormaPago" class="form-select">
                        <option value="CONTADO">Contado</option>
                        <option value="CREDITO">Crédito</option>
                    </select>
                    <div class="sale-help-text">Seleccioná la forma de pago de la venta.</div>

                    <div class="sale-discount-field">
                        <label for="discountPercentage" class="form-label">Descuento (%)</label>
                        <div class="input-group">
                            <input id="discountPercentage" type="number" class="form-control"
                                   min="0" max="100" step="1" value="0" inputmode="decimal" />
                            <span class="input-group-text">%</span>
                        </div>
                        <div class="sale-help-text">Opcional. Ingresá un porcentaje entre 0 y 100.</div>
                    </div>

                    <div class="sale-summary-line">
                        <span>Productos</span>
                        <strong id="summaryItems">0</strong>
                    </div>
                    <div class="sale-summary-line">
                        <span>Subtotal</span>
                        <strong id="summarySubtotal">₡0,00</strong>
                    </div>
                    <div class="sale-summary-line">
                        <span>Descuento</span>
                        <strong id="summaryDiscount">₡0,00</strong>
                    </div>
                    <div class="sale-summary-line">
                        <span>IVA (13%)</span>
                        <strong id="summaryTax">₡0,00</strong>
                    </div>
                    <div class="sale-summary-total">
                        <span>Total</span>
                        <strong id="summaryTotal">₡0,00</strong>
                    </div>

                    <button type="submit" class="btn btn-dark sale-finish-button" id="finishSaleButton">
                        <i class="bi bi-check2-circle me-1"></i> Finalizar venta
                    </button>
                    <a asp-action="Index" class="btn btn-light sale-cancel-button">Cancelar</a>

                    <div class="sale-secure-note">
                        <i class="bi bi-shield-check"></i>
                        <span>El inventario se actualizará cuando la venta se confirme correctamente.</span>
                    </div>
                </div>
            </aside>
        </div>
    </form>

    <!-- Barra compacta con el total siempre visible durante la venta -->
    <div class="sale-live-total-bar" id="saleLiveTotalBar" role="status" aria-live="polite">
        <div class="sale-live-total-info">
            <div class="sale-live-total-icon"><i class="bi bi-receipt"></i></div>
            <div class="sale-live-total-copy">
                <span class="sale-live-total-label">Total a cobrar</span>
                <strong id="liveSummaryTotal">₡0,00</strong>
            </div>
            <span class="sale-live-total-divider"></span>
            <div class="sale-live-total-items">
                <span id="liveSummaryItems">0 unidades</span>
                <small>Importe actualizado automáticamente</small>
            </div>
        </div>

        <div class="sale-live-actions">
            <button type="button" class="btn sale-live-summary-button" id="goToSaleSummary">
                Ver resumen <i class="bi bi-arrow-up-right ms-1"></i>
            </button>
            <button type="button" class="btn sale-live-cancel-button" id="cancelSaleFromBanner">
                <i class="bi bi-x-circle me-1"></i> Cancelar venta
            </button>
        </div>
    </div>

    <!-- Confirmación para descartar una venta en proceso -->
    <div class="sale-modal-backdrop d-none" id="cancelSaleModal" role="presentation">
        <div class="sale-confirm-modal" role="dialog" aria-modal="true"
             aria-labelledby="cancelSaleTitle" aria-describedby="cancelSaleDescription">
            <div class="sale-confirm-icon sale-cancel-confirm-icon"><i class="bi bi-exclamation-triangle"></i></div>
            <h2 id="cancelSaleTitle">¿Cancelar esta venta?</h2>
            <p id="cancelSaleDescription">Se descartarán los productos, las cantidades y el descuento de esta venta. Esta acción no guardará la venta ni modificará el inventario.</p>
            <div class="sale-confirm-actions">
                <button type="button" class="btn btn-light" id="keepSaleButton">
                    Seguir con la venta
                </button>
                <button type="button" class="btn sale-confirm-cancel-button" id="acceptCancelSale">
                    <i class="bi bi-trash3 me-1"></i> Sí, cancelar venta
                </button>
            </div>
        </div>
    </div>

    <!-- Modal de confirmación propio del sistema -->
    <div class="sale-modal-backdrop d-none" id="confirmSaleModal" role="presentation">
        <div class="sale-confirm-modal" role="dialog" aria-modal="true"
             aria-labelledby="confirmSaleTitle" aria-describedby="confirmSaleDescription">
            <div class="sale-confirm-icon"><i class="bi bi-receipt-cutoff"></i></div>
            <h2 id="confirmSaleTitle">Confirmar venta</h2>
            <p id="confirmSaleDescription">¿Deseás finalizar la venta y actualizar el inventario?</p>

            <div class="sale-confirm-summary">
                <div>
                    <span>Unidades en la venta</span>
                    <strong id="confirmSaleItems">0</strong>
                </div>
                <div>
                    <span>Total a cobrar</span>
                    <strong id="confirmSaleTotal">₡0,00</strong>
                </div>
            </div>

            <div class="sale-confirm-actions">
                <button type="button" class="btn btn-light" id="cancelConfirmSale">
                    Seguir revisando
                </button>
                <button type="button" class="btn btn-dark" id="acceptConfirmSale">
                    <i class="bi bi-check2-circle me-1"></i> Confirmar venta
                </button>
            </div>
        </div>
    </div>
</div>

<style>
    .sale-create-page {
        width: 100%;
        max-width: 1400px;
        margin: 0 auto;
        padding-bottom: 100px;
    }

    /* Barra fija: color azul elegante, transparencia y adaptación al viewport */
    .sale-live-total-bar {
        position: fixed;
        z-index: 1030;
        /* Ubicada sobre el área central de trabajo, debajo de la cabecera. */
        top: 70px;
        left: calc(50% + 140px);
        right: auto;
        bottom: auto;
        width: min(740px, calc(100vw - 440px));
        transform: translateX(-50%);
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 14px;
        min-height: 68px;
        padding: 10px 14px;
        border: 1px solid rgba(125, 211, 252, .25);
        border-radius: 14px;
        background: rgba(18, 42, 62, .88);
        color: #f8fbff;
        box-shadow: 0 8px 28px rgba(15, 45, 70, .18);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        transition: background .2s ease, box-shadow .2s ease;
    }

    .sale-live-total-info {
        display: flex;
        align-items: center;
        gap: 13px;
        min-width: 0;
    }

    .sale-live-total-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 38px;
        height: 38px;
        flex-shrink: 0;
        border: 1px solid rgba(125, 211, 252, .2);
        border-radius: 10px;
        background: rgba(56, 189, 248, .12);
        color: #7dd3fc;
        font-size: 17px;
    }

    .sale-live-total-copy {
        display: flex;
        flex-direction: column;
        gap: 3px;
        min-width: 0;
    }

    .sale-live-total-label {
        color: #b9d0df;
        font-size: 10px;
        font-weight: 550;
        letter-spacing: .035em;
    }

    .sale-live-total-copy strong {
        color: #f8fbff;
        font-size: 21px;
        font-weight: 750;
        line-height: 1.15;
        font-variant-numeric: tabular-nums;
        white-space: nowrap;
    }

    .sale-live-total-divider {
        width: 1px;
        height: 32px;
        margin: 0 3px;
        background: rgba(186, 230, 253, .22);
    }

    .sale-live-total-items {
        display: flex;
        flex-direction: column;
        gap: 4px;
        min-width: 0;
    }

    .sale-live-total-items span {
        color: #eff8ff;
        font-size: 11px;
        font-weight: 650;
    }

    .sale-live-total-items small {
        color: #a9c3d4;
        font-size: 10px;
    }

    .sale-live-actions {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 8px;
        flex-shrink: 0;
    }

    .sale-live-summary-button {
        flex-shrink: 0;
        min-height: 38px;
        padding: 0 13px;
        border: 1px solid rgba(125, 211, 252, .4);
        border-radius: 9px;
        background: #dff5ff;
        color: #123047;
        font-size: 11px;
        font-weight: 700;
        white-space: nowrap;
        transition: background .15s ease, transform .15s ease;
    }

    .sale-live-summary-button:hover {
        border-color: #bae6fd;
        background: #bae6fd;
        color: #123047;
        transform: translateY(-1px);
    }

    .sale-live-cancel-button {
        flex-shrink: 0;
        min-height: 38px;
        padding: 0 13px;
        border: 1px solid rgba(254, 202, 202, .65);
        border-radius: 9px;
        background: #b42318;
        color: #fff;
        font-size: 11px;
        font-weight: 750;
        white-space: nowrap;
        box-shadow: 0 3px 10px rgba(180, 35, 24, .2);
        transition: background .15s ease, transform .15s ease, box-shadow .15s ease;
    }

    .sale-live-cancel-button:hover {
        border-color: #fecaca;
        background: #8f1d14;
        color: #fff;
        transform: translateY(-1px);
        box-shadow: 0 5px 14px rgba(180, 35, 24, .3);
    }

    .sale-cancel-confirm-icon {
        background: #fff1f0;
        color: #b42318;
    }

    .sale-confirm-cancel-button {
        padding: 10px 13px;
        border: 1px solid #b42318;
        border-radius: 9px;
        background: #b42318;
        color: #fff;
        font-size: 12px;
        font-weight: 700;
    }

    .sale-confirm-cancel-button:hover {
        border-color: #8f1d14;
        background: #8f1d14;
        color: #fff;
    }

    .sale-page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        margin-bottom: 26px;
    }

    .sale-page-heading {
        display: flex;
        align-items: center;
        gap: 15px;
    }

    .sale-page-icon {
        width: 49px;
        height: 49px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        border-radius: 12px;
        background: #111;
        color: #fff;
        font-size: 21px;
    }

    .sale-page-heading h1 {
        margin: 0;
        color: #111;
        font-size: 27px;
        font-weight: 700;
    }

    .sale-page-heading p {
        margin: 5px 0 0;
        color: #777;
        font-size: 14px;
    }

    .sale-back-button {
        padding: 10px 14px;
        border-radius: 9px;
        font-size: 13px;
        white-space: nowrap;
    }

    .sale-layout {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 330px;
        gap: 20px;
        align-items: start;
    }

    .sale-main-column {
        display: flex;
        flex-direction: column;
        gap: 20px;
        min-width: 0;
    }

    .sale-panel,
    .sale-summary-panel {
        overflow: hidden;
        background: #fff;
        border: 1px solid #e7e7e7;
        border-radius: 15px;
        box-shadow: 0 3px 14px rgba(0, 0, 0, .025);
    }

    .sale-panel-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 15px;
        padding: 22px 24px;
        border-bottom: 1px solid #eee;
    }

    .sale-panel-header h2,
    .sale-summary-header h2 {
        margin: 0;
        color: #171717;
        font-size: 16px;
        font-weight: 700;
    }

    .sale-panel-header p,
    .sale-summary-header p {
        margin: 5px 0 0;
        color: #858585;
        font-size: 12px;
    }

    .sale-panel-icon,
    .sale-summary-icon {
        width: 36px;
        height: 36px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 9px;
        background: #f3f3f3;
        color: #333;
        font-size: 16px;
        flex-shrink: 0;
    }

    .sale-panel-body {
        padding: 23px 24px;
    }

    .sale-create-page .form-label {
        display: block;
        margin-bottom: 8px;
        color: #444;
        font-size: 12px;
        font-weight: 600;
    }

    .sale-create-page .form-control,
    .sale-create-page .form-select,
    .sale-create-page .input-group-text {
        min-height: 43px;
        border-color: #dedede;
        border-radius: 9px;
        font-size: 12px;
        box-shadow: none;
    }

    .sale-create-page .form-control:focus,
    .sale-create-page .form-select:focus {
        border-color: #777;
        box-shadow: 0 0 0 3px rgba(0, 0, 0, .05);
    }

    .sale-search-group .input-group-text {
        display: flex;
        align-items: center;
        padding: 0 13px;
        border-radius: 9px 0 0 9px;
        background: #f8f8f8;
        color: #777;
    }

    .sale-search-group .form-control {
        border-radius: 0;
    }

    .sale-search-group .btn {
        border-radius: 0 9px 9px 0;
        padding: 0 17px;
        font-size: 12px;
        font-weight: 600;
    }

    .sale-help-text {
        margin-top: 7px;
        color: #888;
        font-size: 11px;
    }

    .sale-feedback {
        margin-top: 12px;
        padding: 10px 12px;
        border-radius: 8px;
        font-size: 12px;
    }

    #cartActionMessage {
        margin-top: 12px;
    }

    .sale-prototype-notice {
        border-color: #d7e8fb !important;
        background: #f0f7ff !important;
        color: #315b83 !important;
    }

    .sale-prototype-notice i {
        color: #3979b9 !important;
    }

    .sale-search-results {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 12px;
        margin-top: 12px;
    }

    .sale-product-card {
        display: flex;
        flex-direction: column;
        min-width: 0;
        overflow: hidden;
        border: 1px solid #e6e6e6;
        border-radius: 12px;
        background: #fff;
        transition: border-color .15s ease, box-shadow .15s ease;
    }

    .sale-product-card:hover {
        border-color: #c9c9c9;
        box-shadow: 0 4px 14px rgba(0, 0, 0, .045);
    }

    .sale-product-image {
        display: flex;
        align-items: center;
        justify-content: center;
        height: 125px;
        background: #f7f7f7;
        color: #999;
        border-bottom: 1px solid #eee;
        font-size: 30px;
    }

    .sale-product-image img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .sale-product-card-body {
        display: flex;
        flex-direction: column;
        gap: 7px;
        padding: 12px;
        flex: 1;
    }

    .sale-product-card-title {
        color: #222;
        font-size: 12px;
        font-weight: 700;
        line-height: 1.4;
        min-height: 34px;
    }

    .sale-product-card-code {
        color: #777;
        font-size: 10px;
    }

    .sale-product-card-price {
        color: #111;
        font-size: 14px;
        font-weight: 700;
    }

    .sale-product-card-stock {
        color: #777;
        font-size: 10px;
    }

    .sale-product-card .btn {
        margin-top: auto;
        width: 100%;
        border-radius: 8px;
        font-size: 11px;
    }

    .sale-pagination {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        margin-top: 16px;
        padding-top: 12px;
        border-top: 1px solid #eee;
    }

    .sale-page-info {
        color: #777;
        font-size: 11px;
    }

    .sale-page-controls {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .sale-page-controls .btn {
        border-radius: 8px;
        font-size: 11px;
