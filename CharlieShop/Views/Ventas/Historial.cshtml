@{
    ViewData["Title"] = "Historial de ventas";
}

<div class="d-flex justify-content-between align-items-start mb-4">
    <div>
        <div class="page-title">Historial de ventas</div>
        <div class="page-subtitle">Búsqueda, consulta y seguimiento de las transacciones registradas.</div>
    </div>
    <a asp-action="Index" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i> Nueva venta</a>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-3"><div class="card metric"><div class="label">Ventas de hoy</div><div class="value">₡148.500</div></div></div>
    <div class="col-md-3"><div class="card metric"><div class="label">Transacciones</div><div class="value">7</div></div></div>
    <div class="col-md-3"><div class="card metric"><div class="label">Venta promedio</div><div class="value">₡21.214</div></div></div>
    <div class="col-md-3"><div class="card metric"><div class="label">Ventas a crédito</div><div class="value">2</div></div></div>
</div>

<div class="card p-4">
    <div class="row g-3 mb-3">
        <div class="col-md-4"><div class="input-group"><span class="input-group-text"><i class="bi bi-search"></i></span><input class="form-control" placeholder="Buscar por venta o cliente..." /></div></div>
        <div class="col-md-2"><input type="date" class="form-control" value="2026-08-01" /></div>
        <div class="col-md-2"><input type="date" class="form-control" value="2026-08-09" /></div>
        <div class="col-md-2"><select class="form-select"><option>Todos los pagos</option><option>Contado</option><option>Crédito</option></select></div>
        <div class="col-md-2"><button class="btn btn-outline-primary w-100"><i class="bi bi-funnel me-1"></i> Filtrar</button></div>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead><tr><th>Venta</th><th>Fecha</th><th>Cliente</th><th>Vendedor</th><th>Forma de pago</th><th>Productos</th><th>Total</th><th>Estado</th><th>Acciones</th></tr></thead>
            <tbody>
                <tr><td class="fw-semibold">#V-1048</td><td>08/08/2026</td><td>María López</td><td>Ana Pérez</td><td>Contado</td><td>3</td><td>₡45.000</td><td><span class="badge bg-success">Completada</span></td><td><a asp-action="Detalle" class="btn btn-sm btn-outline-primary"><i class="bi bi-eye"></i></a></td></tr>
                <tr><td class="fw-semibold">#V-1047</td><td>08/08/2026</td><td>Carlos Mora</td><td>Ana Pérez</td><td>Crédito</td><td>2</td><td>₡72.500</td><td><span class="badge bg-warning text-dark">Por cobrar</span></td><td><a asp-action="Detalle" class="btn btn-sm btn-outline-primary"><i class="bi bi-eye"></i></a></td></tr>
                <tr><td class="fw-semibold">#V-1046</td><td>07/08/2026</td><td>Andrea Solís</td><td>Kevin Hidalgo</td><td>Contado</td><td>2</td><td>₡31.000</td><td><span class="badge bg-success">Completada</span></td><td><a asp-action="Detalle" class="btn btn-sm btn-outline-primary"><i class="bi bi-eye"></i></a></td></tr>
                <tr><td class="fw-semibold">#V-1045</td><td>06/08/2026</td><td>Sofía Vargas</td><td>Ana Pérez</td><td>Crédito</td><td>1</td><td>₡35.000</td><td><span class="badge bg-danger">Vencida</span></td><td><a asp-action="Detalle" class="btn btn-sm btn-outline-primary"><i class="bi bi-eye"></i></a></td></tr>
            </tbody>
        </table>
    </div>
    <div class="d-flex justify-content-between align-items-center mt-3"><small class="text-secondary">Mostrando 4 de 48 ventas</small><nav><ul class="pagination pagination-sm mb-0"><li class="page-item disabled"><span class="page-link">Anterior</span></li><li class="page-item active"><span class="page-link">1</span></li><li class="page-item"><span class="page-link">2</span></li><li class="page-item"><span class="page-link">Siguiente</span></li></ul></nav></div>
</div>
