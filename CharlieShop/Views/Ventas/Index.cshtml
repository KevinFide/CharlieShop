
@model IEnumerable<CharlieShop.Models.HistorialVentaViewModel>

@{
    ViewData["Title"] = "Ventas";
}

<div class="sales-page">
    <div class="sales-page-header">
        <div class="sales-page-heading">
            <div class="sales-page-icon">
                <i class="bi bi-cart3"></i>
            </div>
            <div>
                <h1>Ventas</h1>
                <p>Registrá ventas y consultá las transacciones de Charlie Shop.</p>
            </div>
        </div>

        <a asp-action="Crear" class="btn btn-dark sales-primary-button">
            <i class="bi bi-plus-lg me-1"></i>
            Nueva venta
        </a>
    </div>

    <div class="sales-summary-grid">
        <div class="sales-summary-card">
            <div class="sales-summary-top">
                <span>Nueva transacción</span>
                <div class="sales-summary-icon">
                    <i class="bi bi-cart-plus"></i>
                </div>
            </div>
            <div class="sales-summary-value">Registrar venta</div>
            <p>Buscá productos, agregalos al carrito y confirmá la compra.</p>
            <a asp-action="Crear" class="sales-card-link">
                Comenzar venta <i class="bi bi-arrow-right"></i>
            </a>
        </div>

        <div class="sales-summary-card">
            <div class="sales-summary-top">
                <span>Control de inventario</span>
                <div class="sales-summary-icon">
                    <i class="bi bi-box-seam"></i>
                </div>
            </div>
            <div class="sales-summary-value">Validación de stock</div>
            <p>Las existencias se verificarán antes de completar la transacción.</p>
            <span class="sales-card-note">
                <i class="bi bi-shield-check me-1"></i> Confirmación segura
            </span>
        </div>

        <div class="sales-summary-card">
            <div class="sales-summary-top">
                <span>Registro de transacciones</span>
                <div class="sales-summary-icon">
                    <i class="bi bi-receipt"></i>
                </div>
            </div>
            <div class="sales-summary-value">Ventas registradas</div>
            <p>Las transacciones confirmadas se conservarán en la base de datos.</p>
            <span class="sales-card-note">
                <i class="bi bi-database-check me-1"></i> Registro en PostgreSQL
            </span>
        </div>
    </div>

    <div class="sales-content-card">
        <div class="sales-content-header">
            <div>
                <h2>Operaciones de venta</h2>
                <p>Accedé a las funciones principales del módulo.</p>
            </div>
        </div>

        <div class="sales-action-row">
            <div class="sales-action-info">
                <div class="sales-action-icon">
                    <i class="bi bi-bag-plus"></i>
                </div>
                <div>
                    <h3>Registrar una venta</h3>
                    <p>
                        Agregá uno o más productos, verificá las cantidades
                        y revisá el total antes de finalizar.
                    </p>
                </div>
            </div>
            <a asp-action="Crear" class="btn btn-dark sales-action-button">
                Iniciar venta <i class="bi bi-arrow-right ms-1"></i>
            </a>
        </div>
    </div>

    <div class="sales-content-card sales-history-card">
        <div class="sales-content-header sales-history-header">
            <div class="sales-history-title">
                <div class="sales-history-icon">
                    <i class="bi bi-clock-history"></i>
                </div>
                <div>
                    <h2>Historial de ventas</h2>
                    <p>Consultá las transacciones registradas en Charlie Shop.</p>
                </div>
            </div>

            <a asp-action="Index" class="btn btn-outline-dark btn-sm">
                <i class="bi bi-arrow-clockwise me-1"></i> Actualizar
            </a>
        </div>

        <div class="sales-history-tools">
            <div class="sales-search-box">
                <label for="searchSale" class="visually-hidden">
                    Buscar venta
                </label>
                <div class="input-group">
                    <span class="input-group-text">
                        <i class="bi bi-search"></i>
                    </span>
                    <input id="searchSale"
                           type="search"
                           class="form-control"
                           placeholder="Buscar por número de venta o vendedor..."
                           autocomplete="off" />
                    <button type="button"
                            class="btn btn-dark"
                            id="searchSaleButton">
                        Buscar
                    </button>
                </div>
            </div>

            <div class="sales-history-filter">
                <label for="saleStatusFilter" class="visually-hidden">
                    Filtrar por estado
                </label>
                <select id="saleStatusFilter" class="form-select">
                    <option value="">Todos los estados</option>
                    <option value="FINALIZADA">Finalizada</option>
                    <option value="EN PROCESO">En proceso</option>
                    <option value="CANCELADA">Cancelada</option>
                </select>
            </div>
        </div>

        @if (ViewBag.ErrorHistorial != null)
        {
            <div class="alert alert-danger m-3" role="alert">
                @ViewBag.ErrorHistorial
            </div>
        }

        <div class="table-responsive sales-history-table-wrap">
            <table class="table sales-history-table mb-0">
                <thead>
                    <tr>
                        <th>N.º de venta</th>
                        <th>Fecha</th>
                        <th>Vendedor</th>
                        <th>Total neto</th>
                        <th>Estado</th>
                        <th class="text-end">Forma de pago</th>
                    </tr>
                </thead>

                <tbody id="salesHistoryBody">
                    @if (Model == null || !Model.Any())
                    {
                        <tr class="sales-empty-row">
                            <td colspan="6">
                                <div class="sales-history-placeholder">
                                    <div class="sales-history-empty-icon">
                                        <i class="bi bi-receipt"></i>
                                    </div>
                                    <strong>No hay ventas registradas</strong>
                                    <span>
                                        Cuando se registre una venta,
                                        aparecerá aquí.
                                    </span>
                                </div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var venta in Model)
                        {
                            <tr class="sales-history-row"
                                data-sale-id="@venta.IdVenta"
                                data-seller="@venta.NombreVendedor"
                                data-status="@venta.Estado"
                                data-detail-url="@Url.Action("Detalle", "Ventas", new { id = venta.IdVenta })"
                                tabindex="0"
                                role="link"
                                aria-label="Consultar el detalle de la venta número @venta.IdVenta"
                                title="Seleccionar para consultar el detalle de la venta">

                                <td>
                                    <strong>#@venta.IdVenta</strong>
                                </td>
                                <td>
                                    @venta.Fecha.ToString("dd/MM/yyyy HH:mm")
                                </td>
                                <td>
                                    @(string.IsNullOrWhiteSpace(venta.NombreVendedor)
                                        ? "No disponible"
                                        : venta.NombreVendedor)
                                </td>
                                <td>
                                    @venta.TotalNeto.ToString(
                                        "C2",
                                        System.Globalization.CultureInfo.GetCultureInfo("es-CR"))
                                </td>
                                <td>
                                    <span class="sales-status-badge">
                                        @venta.Estado
                                    </span>
                                </td>
                                <td class="text-end">
                                    @venta.FormaPago
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <div class="sales-pagination">
            <span class="sales-pagination-info" id="salesPaginationInfo">
                Mostrando 0–0 de 0 ventas
            </span>
            <nav aria-label="Resumen del historial de ventas">
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item disabled">
                        <span class="page-link">Historial completo</span>
                    </li>
                </ul>
            </nav>
        </div>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const searchInput = document.getElementById("searchSale");
        const searchButton = document.getElementById("searchSaleButton");
        const statusFilter = document.getElementById("saleStatusFilter");
        const paginationInfo = document.getElementById("salesPaginationInfo");

        const rows = Array.from(
            document.querySelectorAll(".sales-history-row")
        );

        const emptyRow = document.querySelector(".sales-empty-row");

        // Abre el detalle de la venta seleccionada.
        function openSaleDetail(row) {
            const detailUrl = row.dataset.detailUrl;

            if (!detailUrl) {
                return;
            }

            // Muestra visualmente la selección antes de navegar.
            row.classList.add("sales-history-row-selected");

            window.setTimeout(function () {
                window.location.href = detailUrl;
            }, 120);
        }

        // Toda la fila es seleccionable, sin agregar botones.
        rows.forEach(function (row) {
            row.addEventListener("click", function () {
                openSaleDetail(row);
            });

            // Permite seleccionar filas con Enter o barra espaciadora.
            row.addEventListener("keydown", function (event) {
                if (event.key === "Enter" || event.key === " ") {
                    event.preventDefault();
                    openSaleDetail(row);
                }
            });
        });

        function filterSales() {
            const searchTerm = (searchInput?.value || "")
                .trim()
                .toLocaleLowerCase();

            const selectedStatus = (statusFilter?.value || "")
                .trim()
                .toLocaleLowerCase();

            let visibleCount = 0;

            rows.forEach(function (row) {
                const saleId = (row.dataset.saleId || "")
                    .toLocaleLowerCase();

                const seller = (row.dataset.seller || "")
                    .toLocaleLowerCase();

                const status = (row.dataset.status || "")
                    .toLocaleLowerCase();

                const matchesSearch = !searchTerm ||
                    saleId.includes(searchTerm) ||
                    seller.includes(searchTerm) ||
                    ("#" + saleId).includes(searchTerm);

                const matchesStatus = !selectedStatus ||
                    status === selectedStatus;

                const visible = matchesSearch && matchesStatus;

                row.hidden = !visible;

                if (visible) {
                    visibleCount++;
                }
            });

            if (emptyRow) {
                const hasAnySales = rows.length > 0;
                emptyRow.hidden = hasAnySales;

                let filteredEmptyRow =
                    document.getElementById("salesFilteredEmptyRow");

                if (hasAnySales && visibleCount === 0) {
                    if (!filteredEmptyRow) {
                        filteredEmptyRow = document.createElement("tr");
                        filteredEmptyRow.id = "salesFilteredEmptyRow";
                        filteredEmptyRow.innerHTML = `
                            <td colspan="6">
                                <div class="sales-history-placeholder">
                                    <div class="sales-history-empty-icon">
                                        <i class="bi bi-search"></i>
                                    </div>
                                    <strong>No se encontraron ventas</strong>
                                    <span>
                                        Probá con otro número, vendedor o estado.
                                    </span>
                                </div>
                            </td>
                        `;

                        document.getElementById("salesHistoryBody")
                            .appendChild(filteredEmptyRow);
                    }

                    filteredEmptyRow.hidden = false;
                } else if (filteredEmptyRow) {
                    filteredEmptyRow.hidden = true;
                }
            } else if (rows.length > 0 && visibleCount === 0) {
                let filteredEmptyRow =
                    document.getElementById("salesFilteredEmptyRow");

                if (!filteredEmptyRow) {
                    filteredEmptyRow = document.createElement("tr");
                    filteredEmptyRow.id = "salesFilteredEmptyRow";
                    filteredEmptyRow.innerHTML = `
                        <td colspan="6">
                            <div class="sales-history-placeholder">
                                <div class="sales-history-empty-icon">
                                    <i class="bi bi-search"></i>
                                </div>
                                <strong>No se encontraron ventas</strong>
                                <span>
                                    Probá con otro número, vendedor o estado.
                                </span>
                            </div>
                        </td>
                    `;

                    document.getElementById("salesHistoryBody")
                        .appendChild(filteredEmptyRow);
                }

                filteredEmptyRow.hidden = false;
            } else {
                const filteredEmptyRow =
                    document.getElementById("salesFilteredEmptyRow");

                if (filteredEmptyRow) {
                    filteredEmptyRow.hidden = true;
                }
            }

            if (paginationInfo) {
                if (rows.length === 0) {
                    paginationInfo.textContent =
                        "Mostrando 0–0 de 0 ventas";
                } else {
                    paginationInfo.textContent =
                        `Mostrando ${visibleCount} de ${rows.length} ventas`;
                }
            }
        }

        if (searchButton) {
            searchButton.addEventListener("click", filterSales);
        }

        if (searchInput) {
            searchInput.addEventListener("keydown", function (event) {
                if (event.key === "Enter") {
                    event.preventDefault();
                    filterSales();
                }
            });

            searchInput.addEventListener("input", filterSales);
        }

        if (statusFilter) {
            statusFilter.addEventListener("change", filterSales);
        }

        filterSales();
    });
</script>

<style>
    .sales-page {
        max-width: 1320px;
        margin: 0 auto;
        padding-bottom: 28px;
    }

    .sales-page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        margin-bottom: 28px;
    }

    .sales-page-heading {
        display: flex;
        align-items: center;
        gap: 15px;
    }

    .sales-page-icon {
        width: 49px;
        height: 49px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        border-radius: 12px;
        background: #111;
        color: #fff;
        font-size: 21px;
    }

    .sales-page-heading h1 {
        margin: 0;
        color: #111;
        font-size: 27px;
        font-weight: 700;
    }

    .sales-page-heading p {
        margin: 5px 0 0;
        color: #777;
        font-size: 14px;
    }

    .sales-primary-button {
        padding: 11px 16px;
        border-radius: 9px;
        font-size: 13px;
        font-weight: 600;
        background: #111;
        border-color: #111;
        white-space: nowrap;
    }

    .sales-primary-button:hover,
    .sales-action-button:hover {
        background: #303030;
        border-color: #303030;
    }

    .sales-summary-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 16px;
        margin-bottom: 22px;
    }

    .sales-summary-card,
    .sales-content-card {
        background: #fff;
        border: 1px solid #e7e7e7;
        border-radius: 15px;
        box-shadow: 0 3px 14px rgba(0, 0, 0, .025);
    }

    .sales-summary-card {
        padding: 21px;
    }

    .sales-summary-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        color: #666;
        font-size: 12px;
    }

    .sales-summary-icon {
        width: 34px;
        height: 34px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 9px;
        background: #f3f3f3;
        color: #333;
        font-size: 15px;
    }

    .sales-summary-value {
        margin-top: 17px;
        color: #171717;
        font-size: 19px;
        font-weight: 700;
    }

    .sales-summary-card p {
        margin: 7px 0 0;
        color: #818181;
        font-size: 12px;
        line-height: 1.6;
    }

    .sales-card-link {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        margin-top: 17px;
        color: #171717;
        text-decoration: none;
        font-size: 12px;
        font-weight: 700;
    }

    .sales-card-link:hover {
        color: #555;
    }

    .sales-card-note {
        display: inline-block;
        margin-top: 16px;
        color: #555;
        font-size: 11px;
    }

    .sales-content-card {
        overflow: hidden;
        margin-bottom: 22px;
    }

    .sales-content-header {
        padding: 23px 25px;
        border-bottom: 1px solid #eee;
    }

    .sales-content-header h2 {
        margin: 0;
        color: #171717;
        font-size: 17px;
        font-weight: 700;
    }

    .sales-content-header p {
        margin: 5px 0 0;
        color: #858585;
        font-size: 13px;
    }

    .sales-action-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        padding: 23px 25px;
    }

    .sales-action-info {
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .sales-action-icon {
        width: 43px;
        height: 43px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 11px;
        background: #f3f3f3;
        color: #222;
        font-size: 19px;
        flex-shrink: 0;
    }

    .sales-action-info h3 {
        margin: 0;
        font-size: 14px;
        font-weight: 700;
        color: #222;
    }

    .sales-action-info p {
        margin: 5px 0 0;
        color: #818181;
        font-size: 12px;
        line-height: 1.5;
    }

    .sales-action-button {
        white-space: nowrap;
        border-radius: 9px;
        padding: 10px 14px;
        font-size: 12px;
        font-weight: 600;
        background: #111;
        border-color: #111;
    }

    .sales-history-tools {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 14px;
        padding: 20px 25px;
        border-bottom: 1px solid #eee;
    }

    .sales-search-box {
        flex: 1;
        min-width: 220px;
    }

    .sales-history-filter {
        width: 190px;
        flex-shrink: 0;
    }

    .sales-history-tools .form-control,
    .sales-history-tools .form-select,
    .sales-history-tools .input-group-text {
        min-height: 42px;
        border-color: #dedede;
        font-size: 12px;
        box-shadow: none;
    }

    .sales-history-tools .input-group-text {
        display: flex;
        align-items: center;
        padding: 0 13px;
        border-radius: 9px 0 0 9px;
        background: #f8f8f8;
        color: #777;
    }

    .sales-history-tools .form-control {
        border-radius: 0;
    }

    .sales-history-tools .btn {
        border-radius: 0 9px 9px 0;
        padding: 0 16px;
        font-size: 12px;
        font-weight: 600;
    }

    .sales-history-tools .form-select {
        border-radius: 9px;
    }

    .sales-history-table {
        font-size: 12px;
    }

    .sales-history-table thead th {
        padding: 14px 16px;
        background: #fafafa;
        border-bottom: 1px solid #eee;
        color: #777;
        font-size: 10px;
        font-weight: 700;
        white-space: nowrap;
    }

    .sales-history-table tbody td {
        padding: 0;
        vertical-align: middle;
    }

    .sales-history-table .sales-history-placeholder {
        min-height: 175px;
    }

    .sales-pagination {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 15px;
        padding: 16px 25px;
        border-top: 1px solid #eee;
    }

    .sales-pagination-info {
        color: #888;
        font-size: 11px;
    }

    .sales-pagination .page-link {
        color: #444;
        border-color: #e5e5e5;
        padding: 7px 10px;
        font-size: 11px;
    }

    .sales-pagination .page-item.active .page-link {
        background: #111;
        border-color: #111;
        color: #fff;
    }

    .sales-pagination .page-item.disabled .page-link {
        color: #aaa;
        background: #fafafa;
    }

    .sales-history-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
    }

    .sales-history-title {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .sales-history-icon {
        width: 38px;
        height: 38px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 10px;
        background: #f3f3f3;
        color: #333;
        font-size: 16px;
        flex-shrink: 0;
    }

    .sales-history-placeholder {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 9px;
        min-height: 185px;
        padding: 25px;
        text-align: center;
    }

    .sales-history-empty-icon {
        width: 45px;
        height: 45px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 3px;
        border-radius: 12px;
        background: #f4f4f4;
        color: #777;
        font-size: 19px;
    }

    .sales-history-placeholder strong {
        color: #444;
        font-size: 13px;
    }

    .sales-history-placeholder span {
        max-width: 520px;
        color: #888;
        font-size: 11px;
        line-height: 1.6;
    }

    .sales-status-badge {
        display: inline-block;
        padding: 6px 9px;
        border-radius: 7px;
        background: #e8f5e9;
        color: #256029;
        font-size: 10px;
        font-weight: 700;
        white-space: nowrap;
    }

    /* Toda la fila funciona como una superficie seleccionable. */
    .sales-history-row {
        cursor: pointer;
        outline: none;
        transition:
            background-color .16s ease,
            opacity .16s ease,
            box-shadow .16s ease;
    }

    .sales-history-row td {
        padding: 14px 16px !important;
        border-bottom: 1px solid #eee;
        color: #444;
        vertical-align: middle;
        transition:
            background-color .16s ease,
            color .16s ease;
    }

    /* Efecto breve y sutil al pasar el cursor sobre la fila completa. */
    .sales-history-row:hover td {
        background-color: #f3f4f5;
    }

    .sales-history-row:hover {
        box-shadow: inset 3px 0 0 #b9bec5;
    }

    /* Selección visual antes de abrir el detalle de la venta. */
    .sales-history-row-selected td {
        background-color: #e9ecef !important;
        color: #111;
    }

    .sales-history-row-selected {
        box-shadow:
            inset 4px 0 0 #171717,
            inset 0 0 0 1px #d5d8dc;
        opacity: .88;
    }

    .sales-history-row:focus-visible {
        box-shadow: inset 0 0 0 2px #777;
    }

    .sales-history-row strong {
        color: #171717;
    }

    .sales-empty-row td {
        padding: 0 !important;
    }

    .sales-history-row[hidden],
    .sales-empty-row[hidden],
    #salesFilteredEmptyRow[hidden] {
        display: none !important;
    }

    @@media (prefers-reduced-motion: reduce) {
        .sales-history-row,
        .sales-history-row td {
            transition: none;
        }
    }

    @@media (max-width: 900px) {
        .sales-summary-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @@media (max-width: 600px) {
        .sales-page-header {
            align-items: flex-start;
            flex-direction: column;
        }

        .sales-primary-button {
            width: 100%;
        }

        .sales-summary-grid {
            grid-template-columns: 1fr;
        }

        .sales-action-row {
            align-items: stretch;
            flex-direction: column;
        }

        .sales-action-button {
            width: 100%;
        }

        .sales-content-header,
        .sales-action-row {
            padding: 20px;
        }

        .sales-history-tools {
            padding: 20px;
        }

        .sales-search-box,
        .sales-history-filter {
            width: 100%;
            min-width: 100%;
        }

        .sales-history-header {
            align-items: flex-start;
            flex-direction: column;
        }

        .sales-pagination {
            align-items: flex-start;
            flex-direction: column;
            padding: 16px 20px;
