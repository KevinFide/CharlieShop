@{
    ViewData["Title"] = "Ventas";
}

<div class="d-flex justify-content-between align-items-start mb-3">

    <div>

        <div class="page-title">
            Ventas
        </div>

        <div class="page-subtitle">
            Registro y consulta de las transacciones realizadas.
        </div>

    </div>

    <div class="d-flex gap-2">
        <a asp-action="Historial" class="btn btn-outline-primary">
            <i class="bi bi-clock-history me-1"></i>
            Historial de ventas
        </a>
        <button class="btn btn-primary">
            <i class="bi bi-plus-lg me-1"></i>
            Nueva venta
        </button>
    </div>

</div>


<div class="card p-4">

    <h5 class="mb-4">
        Registrar venta
    </h5>


    <!-- INFORMACIÓN DE LA VENTA -->

    <div class="row g-3 mb-4">

        <div class="col-md-5">

            <label class="form-label">
                Cliente
            </label>

            <select class="form-select">

                <option selected>
                    Seleccionar cliente
                </option>

                <option>
                    María López
                </option>

                <option>
                    Carlos Mora
                </option>

                <option>
                    Andrea Solís
                </option>

            </select>

        </div>


        <div class="col-md-3">

            <label class="form-label">
                Forma de pago
            </label>

            <select class="form-select">

                <option selected>
                    Contado
                </option>

                <option>
                    Crédito
                </option>

            </select>

        </div>


        <div class="col-md-3">

            <label class="form-label">
                Fecha
            </label>

            <input type="date"
                   class="form-control"
                   value="2026-08-09" />

        </div>

    </div>


    <hr />


    <!-- PRODUCTOS -->

    <div class="d-flex justify-content-between align-items-center mb-3">

        <h5 class="mb-0">
            Productos
        </h5>

        <button class="btn btn-outline-primary">

            <i class="bi bi-plus-lg me-1"></i>

            Agregar producto

        </button>

    </div>


    <div class="table-responsive">

        <table class="table table-hover align-middle">

            <thead>

                <tr>

                    <th>Producto</th>
                    <th>Cantidad</th>
                    <th>Precio unitario</th>
                    <th>Subtotal</th>
                    <th></th>

                </tr>

            </thead>

            <tbody>

                <tr>

                    <td>
                        Camisa básica
                    </td>

                    <td style="width: 120px;">

                        <input type="number"
                               class="form-control"
                               value="2"
                               min="1" />

                    </td>

                    <td>
                        ₡12.000
                    </td>

                    <td>
                        ₡24.000
                    </td>

                    <td>

                        <button class="btn btn-sm btn-outline-danger">

                            <i class="bi bi-trash"></i>

                        </button>

                    </td>

                </tr>


                <tr>

                    <td>
                        Pantalón jeans
                    </td>

                    <td>

                        <input type="number"
                               class="form-control"
                               value="1"
                               min="1" />

                    </td>

                    <td>
                        ₡25.000
                    </td>

                    <td>
                        ₡25.000
                    </td>

                    <td>

                        <button class="btn btn-sm btn-outline-danger">

                            <i class="bi bi-trash"></i>

                        </button>

                    </td>

                </tr>

            </tbody>

        </table>

    </div>


    <!-- TOTAL -->

    <div class="row justify-content-end mt-4">

        <div class="col-md-4">

            <div class="d-flex justify-content-between mb-2">

                <span>
                    Subtotal
                </span>

                <strong>
                    ₡49.000
                </strong>

            </div>


            <div class="d-flex justify-content-between mb-2">

                <span>
                    Descuento
                </span>

                <strong>
                    ₡0
                </strong>

            </div>


            <hr />


            <div class="d-flex justify-content-between">

                <span class="fs-5">
                    Total
                </span>

                <strong class="fs-4">
                    ₡49.000
                </strong>

            </div>


            <button class="btn btn-primary w-100 mt-3">

                <i class="bi bi-check-circle me-1"></i>

                Registrar venta

            </button>

        </div>

    </div>

</div>