
@model IEnumerable<CharlieShop.Models.HistorialVentaViewModel>

@{
    ViewData["Title"] = "Ventas";
}

<div class="sales-page">
    <div class="sales-page-header">
        <div class="sales-page-heading">
            <div class="sales-page-icon">
                <i class="bi bi-cart3"></i>
            </div>
            <div>
                <h1>Ventas</h1>
                <p>Registrá ventas y consultá las transacciones de Charlie Shop.</p>
            </div>
        </div>

        <a asp-action="Crear" class="btn btn-dark sales-primary-button">
            <i class="bi bi-plus-lg me-1"></i>
            Nueva venta
        </a>
    </div>

    <div class="sales-summary-grid">
        <div class="sales-summary-card">
            <div class="sales-summary-top">
                <span>Nueva transacción</span>
                <div class="sales-summary-icon">
                    <i class="bi bi-cart-plus"></i>
                </div>
            </div>
            <div class="sales-summary-value">Registrar venta</div>
            <p>Buscá productos, agregalos al carrito y confirmá la compra.</p>
            <a asp-action="Crear" class="sales-card-link">
                Comenzar venta <i class="bi bi-arrow-right"></i>
            </a>
        </div>

        <div class="sales-summary-card">
            <div class="sales-summary-top">
                <span>Control de inventario</span>
                <div class="sales-summary-icon">
                    <i class="bi bi-box-seam"></i>
                </div>
            </div>
            <div class="sales-summary-value">Validación de stock</div>
            <p>Las existencias se verificarán antes de completar la transacción.</p>
            <span class="sales-card-note">
                <i class="bi bi-shield-check me-1"></i> Confirmación segura
            </span>
        </div>

        <div class="sales-summary-card">
            <div class="sales-summary-top">
                <span>Registro de transacciones</span>
                <div class="sales-summary-icon">
                    <i class="bi bi-receipt"></i>
                </div>
            </div>
            <div class="sales-summary-value">Ventas registradas</div>
            <p>Las transacciones confirmadas se conservarán en la base de datos.</p>
            <span class="sales-card-note">
                <i class="bi bi-database-check me-1"></i> Registro en PostgreSQL
            </span>
        </div>
    </div>

    <div class="sales-content-card">
        <div class="sales-content-header">
            <div>
                <h2>Operaciones de venta</h2>
                <p>Accedé a las funciones principales del módulo.</p>
            </div>
        </div>

        <div class="sales-action-row">
            <div class="sales-action-info">
                <div class="sales-action-icon">
                    <i class="bi bi-bag-plus"></i>
                </div>
                <div>
                    <h3>Registrar una venta</h3>
                    <p>
                        Agregá uno o más productos, verificá las cantidades
                        y revisá el total antes de finalizar.
                    </p>
                </div>
            </div>
            <a asp-action="Crear" class="btn btn-dark sales-action-button">
                Iniciar venta <i class="bi bi-arrow-right ms-1"></i>
            </a>
        </div>
    </div>

    <div class="sales-content-card sales-history-card">
        <div class="sales-content-header sales-history-header">
            <div class="sales-history-title">
                <div class="sales-history-icon">
                    <i class="bi bi-clock-history"></i>
                </div>
                <div>
                    <h2>Historial de ventas</h2>
                    <p>Consultá las transacciones registradas en Charlie Shop.</p>
                </div>
            </div>

            <a asp-action="Index" class="btn btn-outline-dark btn-sm">
                <i class="bi bi-arrow-clockwise me-1"></i> Actualizar
            </a>
        </div>

        <div class="sales-history-tools">
            <div class="sales-search-box">
                <label for="searchSale" class="visually-hidden">
                    Buscar venta
                </label>
                <div class="input-group">
                    <span class="input-group-text">
                        <i class="bi bi-search"></i>
                    </span>
                    <input id="searchSale"
                           type="search"
                           class="form-control"
                           placeholder="Buscar por número de venta o vendedor..."
                           autocomplete="off" />
                    <button type="button"
                            class="btn btn-dark"
                            id="searchSaleButton">
                        Buscar
                    </button>
                </div>
            </div>

            <div class="sales-history-filter">
                <label for="saleStatusFilter" class="visually-hidden">
                    Filtrar por estado
                </label>
                <select id="saleStatusFilter" class="form-select">
                    <option value="">Todos los estados</option>
                    <option value="FINALIZADA">Finalizada</option>
                    <option value="EN_PROCESO">En proceso</option>
                    <option value="CANCELADA">Cancelada</option>
                </select>
            </div>
        </div>

        @if (ViewBag.ErrorHistorial != null)
        {
            <div class="alert alert-danger m-3" role="alert">
                @ViewBag.ErrorHistorial
            </div>
        }

        <div class="table-responsive sales-history-table-wrap">
            <table class="table sales-history-table mb-0">
                <thead>
                    <tr>
                        <th>N.º de venta</th>
                        <th>Fecha</th>
                        <th>Vendedor</th>
                        <th>Total neto</th>
                        <th>Estado</th>
                        <th class="text-end">Forma de pago</th>
                    </tr>
                </thead>

                <tbody id="salesHistoryBody">
                    @if (Model == null || !Model.Any())
                    {
                        <tr class="sales-empty-row">
                            <td colspan="6">
                                <div class="sales-history-placeholder">
                                    <div class="sales-history-empty-icon">
                                        <i class="bi bi-receipt"></i>
                                    </div>
                                    <strong>No hay ventas registradas</strong>
                                    <span>
                                        Cuando se registre una venta,
                                        aparecerá aquí.
                                    </span>
                                </div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var venta in Model)
                        {
                            <tr class="sales-history-row"
                                data-sale-id="@venta.IdVenta"
                                data-seller="@venta.NombreVendedor"
                                data-status="@venta.Estado"
                                data-detail-url="@Url.Action("Detalle", "Ventas", new { id = venta.IdVenta })"
                                tabindex="0"
                                role="link"
                                aria-label="Consultar el detalle de la venta número @venta.IdVenta"
                                title="Seleccionar para consultar el detalle de la venta">

                                <td>
                                    <strong>#@venta.IdVenta</strong>
                                </td>
                                <td>
                                    @venta.Fecha.ToString("dd/MM/yyyy HH:mm")
                                </td>
                                <td>
                                    @(string.IsNullOrWhiteSpace(venta.NombreVendedor)
                                        ? "No disponible"
                                        : venta.NombreVendedor)
                                </td>
                                <td>
                                    @venta.TotalNeto.ToString(
                                        "C2",
                                        System.Globalization.CultureInfo.GetCultureInfo("es-CR"))
                                </td>
                                <td>
                                    @{
                                        var claseEstado = venta.Estado switch
                                        {
                                            "FINALIZADA" => "sales-status-finalizada",
                                            "EN_PROCESO" => "sales-status-proceso",
                                            "CANCELADA" => "sales-status-cancelada",
                                            _ => "sales-status-default"
                                        };

                                        var textoEstado = venta.Estado == "EN_PROCESO"
                                            ? "EN PROCESO"
                                            : venta.Estado;
                                    }
                                    <span class="sales-status-badge @claseEstado">
                                        @textoEstado
                                    </span>
                                </td>
                                <td class="text-end">
                                    @venta.FormaPago
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <div class="sales-pagination">
            <div class="sales-pagination-left">
                <span class="sales-pagination-info" id="salesPaginationInfo">
                    Mostrando 0–0 de 0 ventas
                </span>
                <label class="sales-page-size-label" for="salesPageSize">
                    Mostrar
                    <select id="salesPageSize" class="form-select form-select-sm">
                        <option value="10" selected>10</option>
                        <option value="20">20</option>
                        <option value="50">50</option>
                    </select>
                    por página
                </label>
            </div>
            <nav aria-label="Paginación del historial de ventas">
                <ul class="pagination pagination-sm mb-0" id="salesPaginationControls">
                    <li class="page-item disabled">
                        <button type="button" class="page-link" disabled>Anterior</button>
                    </li>
                    <li class="page-item disabled">
                        <button type="button" class="page-link" disabled>Siguiente</button>
                    </li>
                </ul>
            </nav>
        </div>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const searchInput = document.getElementById("searchSale");
        const searchButton = document.getElementById("searchSaleButton");
        const statusFilter = document.getElementById("saleStatusFilter");
        const paginationInfo = document.getElementById("salesPaginationInfo");
        const paginationControls = document.getElementById("salesPaginationControls");
        const pageSizeSelect = document.getElementById("salesPageSize");
        const tbody = document.getElementById("salesHistoryBody");

        const rows = Array.from(document.querySelectorAll(".sales-history-row"));
        const emptyRow = document.querySelector(".sales-empty-row");

        let currentPage = 1;
        let pageSize = Number(pageSizeSelect?.value || 10);
        let filteredRows = rows.slice();

        function openSaleDetail(row) {
            const detailUrl = row.dataset.detailUrl;
            if (!detailUrl) return;

            row.classList.add("sales-history-row-selected");
            window.setTimeout(function () {
                window.location.href = detailUrl;
            }, 160);
        }

        rows.forEach(function (row) {
            row.addEventListener("click", function () {
                openSaleDetail(row);
            });

            row.addEventListener("keydown", function (event) {
                if (event.key === "Enter" || event.key === " ") {
                    event.preventDefault();
                    openSaleDetail(row);
                }
            });
        });

        function createPageButton(label, page, disabled, active, ariaLabel) {
            const li = document.createElement("li");
            li.className = "page-item" +
                (disabled ? " disabled" : "") +
                (active ? " active" : "");

            const button = document.createElement("button");
            button.type = "button";
            button.className = "page-link";
            button.textContent = label;
            if (ariaLabel) button.setAttribute("aria-label", ariaLabel);
            if (disabled || active) button.disabled = true;

            if (!disabled && !active) {
                button.addEventListener("click", function () {
                    currentPage = page;
                    renderPage();
                });
            }

            li.appendChild(button);
            return li;
        }

        function renderPagination(totalPages) {
            if (!paginationControls) return;

            paginationControls.innerHTML = "";
            paginationControls.appendChild(
                createPageButton("Anterior", currentPage - 1, currentPage <= 1, false, "Página anterior")
            );

            // Mostrar un conjunto compacto de páginas alrededor de la actual.
            let startPage = Math.max(1, currentPage - 2);
            let endPage = Math.min(totalPages, currentPage + 2);

            if (startPage > 1) {
                paginationControls.appendChild(
                    createPageButton("1", 1, false, currentPage === 1, "Página 1")
                );
                if (startPage > 2) {
                    const dots = document.createElement("li");
                    dots.className = "page-item disabled";
                    dots.innerHTML = '<span class="page-link">…</span>';
                    paginationControls.appendChild(dots);
                }
            }

            for (let page = startPage; page <= endPage; page++) {
                if (page === 1 && startPage > 1) continue;
                paginationControls.appendChild(
                    createPageButton(String(page), page, false, page === currentPage, "Página " + page)
                );
            }

            if (endPage < totalPages) {
                if (endPage < totalPages - 1) {
                    const dots = document.createElement("li");
                    dots.className = "page-item disabled";
                    dots.innerHTML = '<span class="page-link">…</span>';
                    paginationControls.appendChild(dots);
                }
                paginationControls.appendChild(
                    createPageButton(String(totalPages), totalPages, false, currentPage === totalPages, "Página " + totalPages)
                );
            }

            paginationControls.appendChild(
                createPageButton("Siguiente", currentPage + 1, currentPage >= totalPages, false, "Página siguiente")
            );
        }

        function renderPage() {
            const total = filteredRows.length;
            const totalPages = Math.max(1, Math.ceil(total / pageSize));

            if (currentPage > totalPages) currentPage = totalPages;
            if (currentPage < 1) currentPage = 1;

            const startIndex = total === 0 ? 0 : (currentPage - 1) * pageSize;
            const endIndex = Math.min(startIndex + pageSize, total);
            const visibleRows = new Set(filteredRows.slice(startIndex, endIndex));

            rows.forEach(function (row) {
                row.hidden = !visibleRows.has(row);
            });

            if (emptyRow) {
                emptyRow.hidden = rows.length !== 0;
            }

            let filteredEmptyRow = document.getElementById("salesFilteredEmptyRow");
            if (total === 0 && rows.length > 0) {
                if (!filteredEmptyRow) {
                    filteredEmptyRow = document.createElement("tr");
                    filteredEmptyRow.id = "salesFilteredEmptyRow";
                    filteredEmptyRow.innerHTML = `
                        <td colspan="6">
                            <div class="sales-history-placeholder">
                                <div class="sales-history-empty-icon">
                                    <i class="bi bi-search"></i>
                                </div>
                                <strong>No se encontraron ventas</strong>
                                <span>Probá con otro número, vendedor o estado.</span>
                            </div>
                        </td>`;
                    tbody.appendChild(filteredEmptyRow);
                }
                filteredEmptyRow.hidden = false;
            } else if (filteredEmptyRow) {
                filteredEmptyRow.hidden = true;
            }

            if (paginationInfo) {
                const from = total === 0 ? 0 : startIndex + 1;
                const to = total === 0 ? 0 : endIndex;
                paginationInfo.textContent = `Mostrando ${from}–${to} de ${total} ventas`;
            }

            renderPagination(totalPages);
        }

        function filterSales() {
            const searchTerm = (searchInput?.value || "").trim().toLocaleLowerCase();
            const selectedStatus = (statusFilter?.value || "").trim().toLocaleLowerCase();

            filteredRows = rows.filter(function (row) {
                const saleId = (row.dataset.saleId || "").toLocaleLowerCase();
                const seller = (row.dataset.seller || "").toLocaleLowerCase();
                const status = (row.dataset.status || "").toLocaleLowerCase();

                const matchesSearch = !searchTerm ||
                    saleId.includes(searchTerm) ||
                    seller.includes(searchTerm) ||
                    ("#" + saleId).includes(searchTerm);

                const matchesStatus = !selectedStatus || status === selectedStatus;
                return matchesSearch && matchesStatus;
            });

            currentPage = 1;
            renderPage();
        }

        if (searchButton) searchButton.addEventListener("click", filterSales);

        if (searchInput) {
            searchInput.addEventListener("input", filterSales);
            searchInput.addEventListener("keydown", function (event) {
                if (event.key === "Enter") {
                    event.preventDefault();
                    filterSales();
                }
            });
        }

        if (statusFilter) statusFilter.addEventListener("change", filterSales);

        if (pageSizeSelect) {
            pageSizeSelect.addEventListener("change", function () {
                pageSize = Number(pageSizeSelect.value) || 10;
                currentPage = 1;
                renderPage();
            });
        }

        filterSales();
    });
</script>

<style>
    .sales-page {
        max-width: 1320px;
        margin: 0 auto;
        padding-bottom: 28px;
        animation: salesPageEnter .3s ease-out;
    }

    @@keyframes salesPageEnter {
        from {
            opacity: 0;
            transform: translateY(5px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .sales-page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        margin-bottom: 28px;
    }

    .sales-page-heading {
        display: flex;
        align-items: center;
        gap: 15px;
    }

    .sales-page-icon {
        width: 49px;
        height: 49px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        border-radius: 13px;
        background: #111;
        color: #fff;
        font-size: 21px;
        box-shadow: 0 5px 12px rgba(0, 0, 0, .12);
        transition: transform .22s ease, box-shadow .22s ease;
    }

    .sales-page-heading h1 {
        margin: 0;
        color: #111;
        font-size: 27px;
        font-weight: 750;
        letter-spacing: -.5px;
    }

    .sales-page-heading p {
        margin: 5px 0 0;
        color: #777;
        font-size: 14px;
    }

    .sales-primary-button {
        padding: 11px 16px;
        border-radius: 10px;
        font-size: 13px;
        font-weight: 600;
        background: #111;
        border-color: #111;
        white-space: nowrap;
        transition:
            background-color .2s ease,
            border-color .2s ease,
            transform .2s ease,
            box-shadow .2s ease;
    }

    .sales-primary-button:hover,
    .sales-action-button:hover {
        background: #303030;
        border-color: #303030;
        transform: translateY(-2px);
        box-shadow: 0 5px 12px rgba(0, 0, 0, .12);
    }

    .sales-primary-button:active,
    .sales-action-button:active {
        transform: translateY(0);
        box-shadow: none;
    }

    .sales-summary-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 16px;
        margin-bottom: 22px;
    }

    .sales-summary-card,
    .sales-content-card {
        background: #fff;
        border: 1px solid #e7e7e7;
        border-radius: 16px;
        box-shadow: 0 3px 14px rgba(0, 0, 0, .025);
    }

    .sales-summary-card {
        position: relative;
        padding: 21px;
        transition:
            transform .22s ease,
            box-shadow .22s ease,
            border-color .22s ease;
    }

    /* Elevación discreta de las tarjetas al pasar el cursor. */
    .sales-summary-card:hover {
        transform: translateY(-4px);
        border-color: #d9dce0;
        box-shadow: 0 12px 28px rgba(20, 25, 35, .075);
    }

    .sales-summary-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        color: #666;
        font-size: 12px;
    }

    .sales-summary-icon {
        width: 36px;
        height: 36px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 10px;
        background: #f3f4f5;
        color: #333;
        font-size: 15px;
        transition:
            background-color .22s ease,
            color .22s ease,
            transform .22s ease;
    }

    .sales-summary-card:hover .sales-summary-icon {
        background: #171717;
        color: #fff;
        transform: scale(1.05);
    }

    .sales-summary-value {
        margin-top: 17px;
        color: #171717;
        font-size: 19px;
        font-weight: 700;
        letter-spacing: -.25px;
    }

    .sales-summary-card p {
        margin: 7px 0 0;
        color: #818181;
        font-size: 12px;
        line-height: 1.7;
    }

    .sales-card-link {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        margin-top: 17px;
        color: #171717;
        text-decoration: none;
        font-size: 12px;
        font-weight: 700;
    }

    .sales-card-link i {
        transition: transform .2s ease;
    }

    .sales-card-link:hover {
        color: #555;
    }

    .sales-card-link:hover i {
        transform: translateX(4px);
    }

    .sales-card-note {
        display: inline-block;
        margin-top: 16px;
        color: #555;
        font-size: 11px;
    }

    .sales-content-card {
        overflow: hidden;
        margin-bottom: 22px;
        transition:
            border-color .22s ease,
            box-shadow .22s ease;
    }

    .sales-content-card:hover {
        border-color: #dedfe2;
        box-shadow: 0 7px 22px rgba(20, 25, 35, .035);
    }

    .sales-content-header {
        padding: 23px 25px;
        border-bottom: 1px solid #eee;
    }

    .sales-content-header h2 {
        margin: 0;
        color: #171717;
        font-size: 17px;
        font-weight: 700;
        letter-spacing: -.2px;
    }

    .sales-content-header p {
        margin: 5px 0 0;
        color: #858585;
        font-size: 13px;
        line-height: 1.6;
    }

    .sales-action-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        padding: 23px 25px;
        transition: background-color .2s ease;
    }

    .sales-action-row:hover {
        background-color: #fcfcfc;
    }

    .sales-action-info {
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .sales-action-icon {
        width: 43px;
        height: 43px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 12px;
        background: #f3f3f3;
        color: #222;
        font-size: 19px;
        flex-shrink: 0;
        transition:
            background-color .22s ease,
            color .22s ease,
            transform .22s ease;
    }

    .sales-action-row:hover .sales-action-icon {
        background: #171717;
        color: #fff;
        transform: translateY(-2px);
    }

    .sales-action-info h3 {
        margin: 0;
        font-size: 14px;
        font-weight: 700;
        color: #222;
    }

    .sales-action-info p {
        margin: 5px 0 0;
        color: #818181;
        font-size: 12px;
        line-height: 1.6;
    }

    .sales-action-button {
        white-space: nowrap;
        border-radius: 10px;
        padding: 10px 14px;
        font-size: 12px;
        font-weight: 600;
        background: #111;
        border-color: #111;
        transition:
            background-color .2s ease,
            border-color .2s ease,
            transform .2s ease,
            box-shadow .2s ease;
    }

    /* =========================================
       BUSCADOR MEJORADO - HISTORIAL DE VENTAS
       ========================================= */

    .sales-history-tools {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 14px;
        padding: 22px 25px;
        border-bottom: 1px solid #ededed;
        background: #fff;
    }

    .sales-search-box {
        flex: 1;
        min-width: 240px;
    }

    .sales-history-filter {
        width: 200px;
        flex-shrink: 0;
    }

    /* El grupo completo se comporta como un único campo. */
    .sales-history-tools .input-group {
        min-height: 46px;
        overflow: hidden;
        border: 1px solid #dedfe3;
        border-radius: 12px;
        background: #f9fafb;
        transition:
            border-color .22s ease,
            background-color .22s ease,
            box-shadow .22s ease,
            transform .22s ease;
    }

    .sales-history-tools .input-group-text {
        display: flex;
        align-items: center;
        justify-content: center;
        min-width: 48px;
        padding: 0 14px;
        border: 0;
        border-radius: 0;
        background: transparent;
        color: #777e87;
        font-size: 14px;
        transition: color .22s ease;
    }

    .sales-history-tools .form-control {
        min-height: 44px;
        padding: 0 12px;
        border: 0;
        border-radius: 0;
        background: transparent;
        color: #202124;
        font-size: 13px;
        box-shadow: none;
    }

    .sales-history-tools .form-control::placeholder {
        color: #9a9da4;
        opacity: 1;
    }

    /* Realce sutil al entrar al campo o enfocarlo con teclado. */
    .sales-history-tools .input-group:focus-within {
        border-color: #858b95;
        background: #fff;
        box-shadow: 0 0 0 4px rgba(40, 45, 55, .07);
