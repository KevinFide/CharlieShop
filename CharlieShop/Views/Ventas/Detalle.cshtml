
@model CharlieShop.Models.ConsultaDetalleVentaViewModel

@using System.Globalization

@{
    ViewData["Title"] = $"Detalle de venta #{Model.IdVenta}";

    var cultura = CultureInfo.GetCultureInfo("es-CR");

    string moneda(decimal valor) => valor.ToString("C2", cultura);

    string fechaVenta = Model.Fecha.ToString(
        "dd 'de' MMMM 'de' yyyy",
        cultura
    );

    string horaVenta = Model.Fecha.ToString("hh:mm tt", cultura);

    string estado = string.IsNullOrWhiteSpace(Model.Estado)
        ? "SIN ESTADO"
        : Model.Estado.Trim().ToUpperInvariant();

    string estadoClase = estado switch
    {
        "FINALIZADA" => "sale-status-completed",
        "CANCELADA" => "sale-status-cancelled",
        "EN PROCESO" => "sale-status-progress",
        _ => "sale-status-default"
    };

    int cantidadProductos = Model.Productos?.Count ?? 0;

    decimal subtotalProductos = Model.Productos?.Sum(p => p.Subtotal) ?? 0m;
}

<div class="sale-detail-page">

    <!-- Encabezado -->
    <div class="sale-detail-header">
        <div class="sale-detail-heading">
            <a asp-action="Index"
               class="sale-back-button"
               aria-label="Regresar al historial de ventas"
               title="Regresar al historial">
                <i class="bi bi-arrow-left"></i>
            </a>

            <div class="sale-heading-icon">
                <i class="bi bi-receipt-cutoff"></i>
            </div>

            <div class="sale-heading-text">
                <div class="sale-breadcrumb">
                    <a asp-action="Index">Ventas</a>
                    <i class="bi bi-chevron-right"></i>
                    <span>Detalle de transacción</span>
                </div>

                <div class="sale-title-line">
                    <h1>Venta #@Model.IdVenta</h1>

                    <span class="sale-status-badge @estadoClase">
                        <span class="sale-status-dot"></span>
                        @estado
                    </span>
                </div>

                <p>
                    <i class="bi bi-calendar3 me-1"></i>
                    Registrada el @fechaVenta a las @horaVenta
                </p>
            </div>
        </div>

        <div class="sale-header-actions">
            <a asp-action="Index" class="btn sale-secondary-button">
                <i class="bi bi-arrow-left me-2"></i>
                Volver al historial
            </a>

            <button type="button"
                    class="btn sale-primary-button"
                    onclick="window.print()">
                <i class="bi bi-printer me-2"></i>
                Imprimir detalle
            </button>
        </div>
    </div>

    <!-- Indicadores de la venta -->
    <div class="sale-overview-grid">

        <div class="sale-overview-card">
            <div class="sale-overview-top">
                <span>Importe neto</span>
                <div class="sale-overview-icon sale-icon-dark">
                    <i class="bi bi-cash-stack"></i>
                </div>
            </div>

            <div class="sale-overview-value">
                @moneda(Model.TotalNeto)
            </div>

            <p>Total final registrado en la transacción.</p>
        </div>

        <div class="sale-overview-card">
            <div class="sale-overview-top">
                <span>Productos vendidos</span>
                <div class="sale-overview-icon">
                    <i class="bi bi-box-seam"></i>
                </div>
            </div>

            <div class="sale-overview-value">
                @cantidadProductos
            </div>

            <p>Tipos de producto incluidos en esta venta.</p>
        </div>

        <div class="sale-overview-card">
            <div class="sale-overview-top">
                <span>Forma de pago</span>
                <div class="sale-overview-icon">
                    <i class="bi bi-credit-card"></i>
                </div>
            </div>

            <div class="sale-overview-value sale-payment-value">
                @(string.IsNullOrWhiteSpace(Model.FormaPago)
                    ? "No especificada"
                    : Model.FormaPago)
            </div>

            <p>Modalidad registrada al confirmar la venta.</p>
        </div>

    </div>

    <!-- Contenido principal -->
    <div class="sale-detail-layout">

        <div class="sale-detail-main">

            <!-- Productos -->
            <section class="sale-detail-card">

                <div class="sale-card-header">
                    <div class="sale-card-heading">
                        <div class="sale-section-icon">
                            <i class="bi bi-bag-check"></i>
                        </div>

                        <div>
                            <h2>Productos vendidos</h2>
                            <p>Detalle de los artículos incluidos en la transacción.</p>
                        </div>
                    </div>

                    <span class="sale-count-badge">
                        @cantidadProductos @(cantidadProductos == 1
                            ? "producto"
                            : "productos")
                    </span>
                </div>

                <div class="table-responsive">
                    <table class="table sale-products-table mb-0">
                        <thead>
                            <tr>
                                <th>Producto</th>
                                <th class="text-center">Cantidad</th>
                                <th class="text-end">Precio unitario</th>
                                <th class="text-end">Descuento</th>
                                <th class="text-end">Subtotal</th>
                            </tr>
                        </thead>

                        <tbody>
                            @if (Model.Productos == null || !Model.Productos.Any())
                            {
                                <tr>
                                    <td colspan="5">
                                        <div class="sale-empty-products">
                                            <div class="sale-empty-icon">
                                                <i class="bi bi-inbox"></i>
                                            </div>

                                            <strong>No hay productos asociados</strong>

                                            <span>
                                                No se encontraron líneas de detalle
                                                para esta venta.
                                            </span>
                                        </div>
                                    </td>
                                </tr>
                            }
                            else
                            {
                                foreach (var producto in Model.Productos)
                                {
                                    <tr>
                                        <td>
                                            <div class="sale-product-info">
                                                <div class="sale-product-icon">
                                                    <i class="bi bi-box"></i>
                                                </div>

                                                <div class="sale-product-text">
                                                    <strong>
                                                        @(string.IsNullOrWhiteSpace(producto.NombreProducto)
                                                            ? $"Producto #{producto.IdProducto}"
                                                            : producto.NombreProducto)
                                                    </strong>

                                                    <span>
                                                        @if (!string.IsNullOrWhiteSpace(producto.CodigoProducto))
                                                        {
                                                            @:Código: @producto.CodigoProducto
                                                        }
                                                        else
                                                        {
                                                            @:ID de producto: @producto.IdProducto
                                                        }
                                                    </span>
                                                </div>
                                            </div>
                                        </td>

                                        <td class="text-center">
                                            <span class="sale-quantity-badge">
                                                @producto.Cantidad.ToString("0.##", cultura)
                                            </span>
                                        </td>

                                        <td class="text-end sale-money-cell">
                                            @moneda(producto.PrecioUnitario)
                                        </td>

                                        <td class="text-end sale-money-cell">
                                            @moneda(producto.Descuento)
                                        </td>

                                        <td class="text-end sale-subtotal-cell">
                                            @moneda(producto.Subtotal)
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>

                <div class="sale-products-footer">
                    <span>
                        <i class="bi bi-shield-check me-1"></i>
                        Información registrada en el sistema
                    </span>

                    <span>
                        @cantidadProductos @(cantidadProductos == 1
                            ? "línea de detalle"
                            : "líneas de detalle")
                    </span>
                </div>
            </section>

            <!-- Información de registro -->
            <section class="sale-detail-card sale-metadata-card">
                <div class="sale-card-header">
                    <div class="sale-card-heading">
                        <div class="sale-section-icon">
                            <i class="bi bi-info-circle"></i>
                        </div>

                        <div>
                            <h2>Información de la transacción</h2>
                            <p>Datos generales guardados para esta venta.</p>
                        </div>
                    </div>
                </div>

                <div class="sale-metadata-grid">

                    <div class="sale-metadata-item">
                        <span class="sale-metadata-label">
                            <i class="bi bi-hash"></i>
                            Número de venta
                        </span>

                        <strong>#@Model.IdVenta</strong>
                    </div>

                    <div class="sale-metadata-item">
                        <span class="sale-metadata-label">
                            <i class="bi bi-calendar-event"></i>
                            Fecha de registro
                        </span>

                        <strong>@Model.Fecha.ToString("dd/MM/yyyy HH:mm")</strong>
                    </div>

                    <div class="sale-metadata-item">
                        <span class="sale-metadata-label">
                            <i class="bi bi-person"></i>
                            Cliente
                        </span>

                        <strong>
                            @(string.IsNullOrWhiteSpace(Model.NombreCliente)
                                ? "No asociado"
                                : Model.NombreCliente)
                        </strong>
                    </div>

                    <div class="sale-metadata-item">
                        <span class="sale-metadata-label">
                            <i class="bi bi-person-badge"></i>
                            Vendedor
                        </span>

                        <strong>
                            @(string.IsNullOrWhiteSpace(Model.NombreVendedor)
                                ? "No disponible"
                                : Model.NombreVendedor)
                        </strong>
                    </div>

                    <div class="sale-metadata-item">
                        <span class="sale-metadata-label">
                            <i class="bi bi-credit-card-2-front"></i>
                            Forma de pago
                        </span>

                        <strong>
                            @(string.IsNullOrWhiteSpace(Model.FormaPago)
                                ? "No especificada"
                                : Model.FormaPago)
                        </strong>
                    </div>

                    <div class="sale-metadata-item">
                        <span class="sale-metadata-label">
                            <i class="bi bi-check2-circle"></i>
                            Estado de la venta
                        </span>

                        <strong>@estado</strong>
                    </div>

                </div>
            </section>

        </div>

        <!-- Resumen financiero -->
        <aside class="sale-detail-sidebar">

            <section class="sale-detail-card sale-total-card">

                <div class="sale-card-header">
                    <div class="sale-card-heading">
                        <div class="sale-section-icon">
                            <i class="bi bi-calculator"></i>
                        </div>

                        <div>
                            <h2>Resumen financiero</h2>
                            <p>Importes de la transacción.</p>
                        </div>
                    </div>
                </div>

                <div class="sale-total-content">

                    <div class="sale-total-row">
                        <span>Subtotal de productos</span>
                        <strong>@moneda(subtotalProductos)</strong>
                    </div>

                    <div class="sale-total-row">
                        <span>Descuento registrado</span>
                        <strong class="sale-discount-value">
                            − @moneda(Model.Descuento)
                        </strong>
                    </div>

                    <div class="sale-total-row">
                        <span>Impuestos</span>
                        <strong>@moneda(Model.Impuesto)</strong>
                    </div>

                    <div class="sale-total-divider"></div>

                    <div class="sale-grand-total">
                        <span>Total neto</span>
                        <strong>@moneda(Model.TotalNeto)</strong>
                    </div>

                    <div class="sale-total-note">
                        <i class="bi bi-info-circle"></i>
                        <span>
                            Los importes corresponden a los datos registrados
                            para esta transacción.
                        </span>
                    </div>
                </div>
            </section>

            <section class="sale-detail-card sale-payment-card">
                <div class="sale-payment-icon">
                    <i class="bi bi-patch-check"></i>
                </div>

                <h3>Registro de la venta</h3>

                <p>
                    La información mostrada corresponde al registro almacenado
                    en Charlie Shop.
                </p>

                <div class="sale-payment-status">
                    <span class="sale-status-dot"></span>
                    @estado
                </div>
            </section>

            <a asp-action="Index" class="sale-return-link">
                <i class="bi bi-arrow-left"></i>
                Regresar al historial de ventas
            </a>

        </aside>
    </div>

</div>

<style>
    .sale-detail-page {
        max-width: 1320px;
        margin: 0 auto;
        padding: 0 0 32px;
        color: #171717;
    }

    .sale-detail-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 24px;
        margin-bottom: 26px;
    }

    .sale-detail-heading {
        display: flex;
        align-items: center;
        gap: 14px;
        min-width: 0;
    }

    .sale-back-button {
        width: 38px;
        height: 38px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        border: 1px solid #e5e5e5;
        border-radius: 10px;
        background: #fff;
        color: #333;
        text-decoration: none;
        transition: background .2s, border-color .2s;
    }

    .sale-back-button:hover {
        background: #f5f5f5;
        border-color: #ccc;
        color: #111;
    }

    .sale-heading-icon {
        width: 49px;
        height: 49px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        border-radius: 13px;
        background: #111;
        color: #fff;
        font-size: 21px;
    }

    .sale-heading-text {
        min-width: 0;
    }

    .sale-breadcrumb {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 8px;
        margin-bottom: 5px;
        color: #888;
        font-size: 11px;
    }

    .sale-breadcrumb a {
        color: #555;
        text-decoration: none;
    }

    .sale-breadcrumb a:hover {
        color: #111;
        text-decoration: underline;
    }

    .sale-breadcrumb i {
        font-size: 9px;
    }

    .sale-title-line {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 12px;
    }

    .sale-title-line h1 {
        margin: 0;
        color: #111;
        font-size: 27px;
        font-weight: 750;
        letter-spacing: -.7px;
    }

    .sale-heading-text > p {
        margin: 6px 0 0;
        color: #818181;
        font-size: 12px;
    }

    .sale-header-actions {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 9px;
    }

    .sale-secondary-button,
    .sale-primary-button {
        min-height: 40px;
        padding: 10px 14px;
        border-radius: 9px;
        font-size: 12px;
        font-weight: 600;
        white-space: nowrap;
    }

    .sale-secondary-button {
        border: 1px solid #dedede;
        background: #fff;
        color: #333;
    }

    .sale-secondary-button:hover {
        background: #f7f7f7;
        border-color: #ccc;
        color: #111;
    }

    .sale-primary-button {
        border: 1px solid #111;
        background: #111;
        color: #fff;
    }

    .sale-primary-button:hover {
        border-color: #333;
        background: #333;
        color: #fff;
    }

    .sale-overview-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 16px;
        margin-bottom: 22px;
    }

    .sale-overview-card,
    .sale-detail-card {
        border: 1px solid #e8e8e8;
        border-radius: 15px;
        background: #fff;
        box-shadow: 0 3px 14px rgba(0, 0, 0, .025);
    }

    .sale-overview-card {
        padding: 20px 21px;
    }

    .sale-overview-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        color: #777;
        font-size: 12px;
    }

    .sale-overview-icon {
        width: 35px;
        height: 35px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        border-radius: 10px;
        background: #f3f3f3;
        color: #333;
        font-size: 16px;
    }

    .sale-icon-dark {
        background: #111;
        color: #fff;
    }

    .sale-overview-value {
        margin-top: 17px;
        color: #171717;
        font-size: 24px;
        font-weight: 750;
        letter-spacing: -.5px;
        overflow-wrap: anywhere;
    }

    .sale-payment-value {
        font-size: 20px;
    }

    .sale-overview-card > p {
        margin: 7px 0 0;
        color: #858585;
        font-size: 11px;
        line-height: 1.6;
    }

    .sale-status-badge {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 6px 10px;
        border-radius: 8px;
        font-size: 10px;
        font-weight: 750;
        white-space: nowrap;
    }

    .sale-status-dot {
        width: 7px;
        height: 7px;
        display: inline-block;
        flex-shrink: 0;
        border-radius: 50%;
        background: currentColor;
    }

    .sale-status-completed {
        background: #e8f5e9;
        color: #276738;
    }

    .sale-status-cancelled {
        background: #fff0f0;
        color: #b42318;
    }

    .sale-status-progress {
        background: #fff5df;
        color: #8a5a00;
    }

    .sale-status-default {
        background: #f1f1f1;
        color: #555;
    }

    .sale-detail-layout {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 330px;
        align-items: start;
        gap: 22px;
    }

    .sale-detail-main,
    .sale-detail-sidebar {
        display: flex;
        flex-direction: column;
        gap: 22px;
        min-width: 0;
    }

    .sale-detail-card {
        overflow: hidden;
    }

    .sale-card-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 14px;
        padding: 21px 23px;
        border-bottom: 1px solid #eee;
    }

    .sale-card-heading {
        display: flex;
        align-items: center;
        gap: 12px;
        min-width: 0;
    }

    .sale-section-icon {
        width: 39px;
        height: 39px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        border-radius: 11px;
        background: #f3f3f3;
        color: #333;
        font-size: 17px;
    }

    .sale-card-heading h2 {
        margin: 0;
        color: #171717;
        font-size: 15px;
        font-weight: 750;
    }

    .sale-card-heading p {
        margin: 5px 0 0;
        color: #888;
        font-size: 11px;
        line-height: 1.5;
    }

    .sale-count-badge {
        padding: 7px 10px;
        border: 1px solid #e9e9e9;
        border-radius: 8px;
        background: #fafafa;
        color: #555;
        font-size: 10px;
        font-weight: 650;
        white-space: nowrap;
    }

    .sale-products-table {
        min-width: 690px;
        font-size: 12px;
    }

    .sale-products-table thead th {
        padding: 13px 15px;
        border-bottom: 1px solid #eee;
        background: #fafafa;
        color: #777;
        font-size: 10px;
        font-weight: 750;
        white-space: nowrap;
    }

    .sale-products-table tbody td {
        padding: 16px 15px;
        border-bottom: 1px solid #f0f0f0;
        vertical-align: middle;
    }

    .sale-products-table tbody tr:last-child td {
        border-bottom: none;
    }

    .sale-product-info {
        display: flex;
        align-items: center;
        gap: 11px;
        min-width: 180px;
    }

    .sale-product-icon {
        width: 39px;
        height: 39px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        border: 1px solid #ededed;
        border-radius: 10px;
        background: #f8f8f8;
        color: #555;
        font-size: 16px;
    }

    .sale-product-text {
        display: flex;
        flex-direction: column;
        gap: 5px;
        min-width: 0;
    }

    .sale-product-text strong {
        color: #222;
        font-size: 12px;
        font-weight: 700;
    }

    .sale-product-text span {
        color: #888;
        font-size: 10px;
    }

    .sale-quantity-badge {
        display: inline-block;
        min-width: 32px;
        padding: 6px 9px;
        border: 1px solid #e8e8e8;
        border-radius: 7px;
        background: #fafafa;
        color: #333;
        font-weight: 700;
    }

    .sale-money-cell {
        color: #555;
        white-space: nowrap;
    }

    .sale-subtotal-cell {
        color: #171717;
        font-weight: 750;
        white-space: nowrap;
    }

    .sale-products-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        padding: 13px 20px;
        border-top: 1px solid #eee;
        background: #fdfdfd;
        color: #888;
        font-size: 10px;
    }

    .sale-products-footer i {
        color: #555;
    }

    .sale-empty-products {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 9px;
        padding: 35px 15px;
        text-align: center;
    }

    .sale-empty-icon {
        width: 44px;
        height: 44px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 12px;
        background: #f3f3f3;
        color: #777;
        font-size: 19px;
    }

    .sale-empty-products strong {
        color: #444;
        font-size: 13px;
    }

    .sale-empty-products span {
        color: #888;
        font-size: 11px;
    }

    .sale-metadata-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 0;
        padding: 4px 23px;
    }

    .sale-metadata-item {
        display: flex;
        flex-direction: column;
        gap: 9px;
        padding: 17px 12px 17px 0;
        border-bottom: 1px solid #f0f0f0;
        min-width: 0;
    }

    .sale-metadata-item:nth-last-child(-n+2) {
        border-bottom: none;
    }

    .sale-metadata-label {
        display: flex;
        align-items: center;
        gap: 7px;
        color: #888;
        font-size: 11px;
    }

    .sale-metadata-label i {
        color: #666;
        font-size: 13px;
    }

    .sale-metadata-item > strong {
        color: #222;
        font-size: 12px;
        font-weight: 700;
        overflow-wrap: anywhere;
    }

    .sale-total-content {
        padding: 22px;
    }

    .sale-total-row {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 14px;
        margin-bottom: 17px;
        color: #777;
        font-size: 12px;
    }

    .sale-total-row strong {
        color: #333;
        font-size: 12px;
        font-weight: 700;
        text-align: right;
        white-space: nowrap;
    }

    .sale-total-row .sale-discount-value {
        color: #267345;
    }

    .sale-total-divider {
        height: 1px;
        margin: 6px 0 19px;
        background: #eaeaea;
    }

    .sale-grand-total {
        display: flex;
        flex-direction: column;
        gap: 9px;
    }

