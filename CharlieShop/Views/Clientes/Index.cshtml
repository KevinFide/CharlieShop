@{
    ViewData["Title"] = "Clientes";
}

<div class="d-flex justify-content-between align-items-start mb-3">

    <div>

        <div class="page-title">
            Clientes
        </div>

        <div class="page-subtitle">
            Gestión de información y seguimiento de clientes.
        </div>

    </div>

    <div class="d-flex gap-2">
        <a asp-action="Detalle" class="btn btn-outline-primary"><i class="bi bi-person-lines-fill me-1"></i> Ver detalle</a>
        <button class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i> Nuevo cliente</button>
    </div>

</div>


<div class="card p-4">

    <div class="row mb-3">

        <div class="col-md-5">

