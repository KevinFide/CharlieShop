@model CharlieShop.Models.CrearClienteViewModel

@{
    ViewData["Title"] = "Registrar cliente";
    ViewData["Breadcrumbs"] = new List<(string Texto, string? Controlador, string? Accion)>
    {
        ("Clientes", "Clientes", "Index"),
        ("Registrar cliente", null, null)
    };
}

<div class="container py-4">
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <h1 class="h3 fw-bold mb-1">Registrar cliente</h1>
            <p class="text-muted mb-0">
                Complete la información para registrar un nuevo cliente.
            </p>
        </div>

        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> Volver
        </a>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-4">
            <form asp-action="Crear" method="post">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3"></div>

                <h2 class="h5 fw-semibold mb-3">Información personal</h2>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="Nombre" class="form-label"></label>
                        <input asp-for="Nombre" class="form-control"
                               placeholder="Ingrese el nombre" />
                        <span asp-validation-for="Nombre"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Apellido" class="form-label"></label>
                        <input asp-for="Apellido" class="form-control"
                               placeholder="Ingrese el apellido" />
                        <span asp-validation-for="Apellido"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Identificacion" class="form-label"></label>
                        <input asp-for="Identificacion" class="form-control"
                               placeholder="Número de identificación" />
                        <span asp-validation-for="Identificacion"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Telefono" class="form-label"></label>
                        <input asp-for="Telefono" class="form-control"
                               type="tel" placeholder="Número de teléfono" />
                        <span asp-validation-for="Telefono"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Email" class="form-label"></label>
                        <input asp-for="Email" class="form-control"
                               type="email" placeholder="correo@ejemplo.com" />
                        <span asp-validation-for="Email"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Direccion" class="form-label"></label>
                        <input asp-for="Direccion" class="form-control"
                               placeholder="Dirección del cliente" />
                        <span asp-validation-for="Direccion"
                              class="text-danger"></span>
                    </div>
                </div>

                <hr class="my-4" />

                <div class="d-flex justify-content-end gap-2">
                    <a asp-action="Index"
                       class="btn btn-light border">Cancelar</a>

                    <button type="submit" class="btn btn-dark">
                        <i class="bi bi-person-plus me-1"></i>
                        Registrar cliente
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
