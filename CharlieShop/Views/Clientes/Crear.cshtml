@model CharlieShop.Models.CrearClienteViewModel

@{
    ViewData["Title"] = "Registrar cliente";
    ViewData["Breadcrumbs"] = new List<(string Texto, string? Controlador, string? Accion)>
    {
        ("Clientes", "Clientes", "Index"),
        ("Registrar cliente", null, null)
    };
}

<style>
    .client-create-page { color:#25282d; }
    .client-create-page .create-heading { font-size:25px; font-weight:750; letter-spacing:-.65px; margin:0; }
    .client-create-page .create-subtitle { color:#858b95; font-size:13px; margin-top:5px; }
    .client-create-page .create-card { background:#fff; border:1px solid #eceef1; border-radius:15px; box-shadow:0 3px 12px rgba(20,25,35,.035); overflow:hidden; }
    .client-create-page .create-card-header { display:flex; align-items:center; gap:12px; padding:21px 24px; border-bottom:1px solid #eff0f2; }
    .client-create-page .header-icon { width:40px; height:40px; display:flex; align-items:center; justify-content:center; border-radius:12px; background:#f1f2f4; color:#373b42; font-size:18px; }
    .client-create-page .card-title { font-size:14px; font-weight:750; margin:0; }
    .client-create-page .card-description { font-size:11px; color:#9298a1; margin-top:3px; }
    .client-create-page .create-card-body { padding:25px 24px; }
    .client-create-page .create-label { display:block; color:#505660; font-size:12px; font-weight:650; margin-bottom:8px; }
    .client-create-page .form-control { min-height:43px; border:1px solid #e1e4e8; border-radius:9px; color:#30343a; font-size:13px; padding:10px 12px; box-shadow:none; }
    .client-create-page .form-control:focus { border-color:#9ca1a9; box-shadow:0 0 0 3px rgba(45,49,55,.07); }
    .client-create-page .form-control::placeholder { color:#b0b5bd; }
    .client-create-page .field-validation-error { display:block; font-size:11px; margin-top:5px; color:#c0392b; }
    .client-create-page .validation-summary-errors { padding:11px 13px; border:1px solid #f1c7c4; border-radius:9px; background:#fff5f4; color:#b42318; font-size:12px; }
    .client-create-page .validation-summary-errors ul { margin:0; padding-left:18px; }
    .client-create-page .field-validation-valid { display:none; }
    .client-create-page .create-section-label { color:#9298a1; font-size:10px; font-weight:750; letter-spacing:.9px; text-transform:uppercase; margin:0 0 16px; }
    .client-create-page .create-aside { background:#f8f9fa; border:1px solid #eceef1; border-radius:13px; padding:20px; }
    .client-create-page .aside-icon { width:43px; height:43px; display:flex; align-items:center; justify-content:center; border-radius:13px; background:#e9eaed; color:#30343a; font-size:19px; margin-bottom:15px; }
    .client-create-page .aside-title { font-size:14px; font-weight:750; margin-bottom:7px; }
    .client-create-page .aside-copy { color:#7b818b; font-size:11px; line-height:1.7; margin:0; }
    .client-create-page .aside-tip { display:flex; gap:9px; padding-top:15px; margin-top:17px; border-top:1px solid #e6e8eb; color:#7b818b; font-size:11px; line-height:1.6; }
    .client-create-page .aside-tip i { font-size:14px; }
    .client-create-page .create-card-footer { display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:12px; padding:17px 24px; background:#fcfcfd; border-top:1px solid #eff0f2; }
    .client-create-page .footer-hint { color:#9298a1; font-size:11px; }
    .client-create-page .btn-cancel { background:#fff; border:1px solid #e0e3e7; color:#4c525b; border-radius:9px; padding:10px 14px; font-size:12px; font-weight:650; }
    .client-create-page .btn-save { background:#202124; border:1px solid #202124; color:#fff; border-radius:9px; padding:10px 15px; font-size:12px; font-weight:650; }
    .client-create-page .btn-save:hover { background:#383a3d; color:#fff; }
    .client-create-page .btn-cancel:hover { background:#f5f6f7; }
    @@media (max-width: 767.98px) {
        .client-create-page .create-heading { font-size:22px; }
        .client-create-page .create-card-header, .client-create-page .create-card-body { padding:18px; }
        .client-create-page .create-card-footer { padding:16px 18px; }
        .client-create-page .create-card-footer .footer-hint { width:100%; }
        .client-create-page .create-card-footer .footer-actions { display:flex; width:100%; }
        .client-create-page .create-card-footer .footer-actions a, .client-create-page .create-card-footer .footer-actions button { flex:1; justify-content:center; }
    }
</style>

<div class="client-create-page">
    <div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-4">
        <div>
            <h1 class="create-heading">Registrar cliente</h1>
            <p class="create-subtitle mb-0">Completa la información para incorporar un nuevo cliente al sistema.</p>
        </div>

        <a asp-action="Index" class="btn btn-cancel d-inline-flex align-items-center">
            <i class="bi bi-arrow-left me-2"></i>Volver al listado
        </a>
    </div>

    <div class="row g-4">
        <div class="col-lg-4">
            <aside class="create-aside">
                <div class="aside-icon"><i class="bi bi-person-plus"></i></div>
                <h2 class="aside-title">Nuevo cliente</h2>
                <p class="aside-copy">
                    Registra los datos de identificación y contacto para mantener la información de tus clientes organizada y disponible.
                </p>
                <div class="aside-tip">
                    <i class="bi bi-info-circle"></i>
                    <span>Los campos deben completarse de acuerdo con la información proporcionada por el cliente.</span>
                </div>
                <div class="aside-tip">
                    <i class="bi bi-shield-check"></i>
                    <span>Revisa los datos antes de seleccionar <strong>Registrar cliente</strong>.</span>
                </div>
            </aside>
        </div>

        <div class="col-lg-8">
            <section class="create-card">
                <div class="create-card-header">
                    <div class="header-icon"><i class="bi bi-person-vcard"></i></div>
                    <div>
                        <h2 class="card-title">Información del cliente</h2>
                        <div class="card-description">Ingresa los datos personales y la información de contacto.</div>
                    </div>
                </div>

                <form asp-action="Crear" method="post">
                    @Html.AntiForgeryToken()

                    <div class="create-card-body">
                        <div asp-validation-summary="ModelOnly" class="mb-4"></div>

                        <h3 class="create-section-label">Datos personales</h3>
                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <label asp-for="Nombre" class="create-label">Nombre</label>
                                <input asp-for="Nombre" class="form-control" placeholder="Ingrese el nombre" autocomplete="given-name" />
                                <span asp-validation-for="Nombre"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Apellido" class="create-label">Apellido</label>
                                <input asp-for="Apellido" class="form-control" placeholder="Ingrese el apellido" autocomplete="family-name" />
                                <span asp-validation-for="Apellido"></span>
                            </div>
                            <div class="col-12">
                                <label asp-for="Identificacion" class="create-label">Identificación</label>
                                <input asp-for="Identificacion" class="form-control" placeholder="Número de identificación" autocomplete="off" />
                                <span asp-validation-for="Identificacion"></span>
                            </div>
                        </div>

                        <h3 class="create-section-label">Información de contacto</h3>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="Telefono" class="create-label">Teléfono</label>
                                <input asp-for="Telefono" class="form-control" type="tel" placeholder="Ej. 8888-8888" autocomplete="tel" />
                                <span asp-validation-for="Telefono"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Email" class="create-label">Correo electrónico</label>
                                <input asp-for="Email" class="form-control" type="email" placeholder="correo@ejemplo.com" autocomplete="email" />
                                <span asp-validation-for="Email"></span>
                            </div>
                            <div class="col-12">
                                <label asp-for="Direccion" class="create-label">Dirección</label>
                                <textarea asp-for="Direccion" class="form-control" rows="3" placeholder="Ingrese la dirección del cliente" autocomplete="street-address" style="resize:vertical; min-height:90px;"></textarea>
                                <span asp-validation-for="Direccion"></span>
                            </div>
                        </div>
                    </div>

                    <div class="create-card-footer">
                        <span class="footer-hint"><i class="bi bi-info-circle me-1"></i>Los datos se guardarán al confirmar el registro.</span>
                        <div class="footer-actions d-flex gap-2">
                            <a asp-action="Index" class="btn btn-cancel d-inline-flex align-items-center">Cancelar</a>
                            <button type="submit" class="btn btn-save d-inline-flex align-items-center">
                                <i class="bi bi-person-plus me-2"></i>Registrar cliente
                            </button>
                        </div>
                    </div>
                </form>
            </section>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
