@model CharlieShop.Models.ClienteDetalleViewModel

@{
    ViewData["Title"] = "Detalle de cliente";

    ViewData["Breadcrumbs"] = new List<(string Texto, string? Controlador, string? Accion)>
    {
        ("Clientes", "Clientes", "Index"),
        ("Detalle de cliente", null, null)
    };
}

<div class="d-flex justify-content-between align-items-start mb-4">
    <div>
        <div class="page-title">Detalle de cliente</div>
        <div class="page-subtitle">
            Información personal y estado del cliente.
        </div>
    </div>

    <div class="d-flex gap-2">
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>
            Volver
        </a>

        <a asp-action="Editar"
           asp-route-id="@Model.IdCliente"
           class="btn btn-primary">
            <i class="bi bi-pencil me-1"></i>
            Editar cliente
        </a>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm p-4 text-center">
            <div class="mb-3">
                <i class="bi bi-person-circle" style="font-size: 4rem;"></i>
            </div>

            <h2 class="h4 fw-bold">
                @Model.Nombre @Model.Apellido
            </h2>

            <p class="text-muted mb-3">
                Cliente #@Model.IdCliente
            </p>

            @if (Model.Estado)
            {
                <div>
                    <span class="badge bg-success">Activo</span>
                </div>
            }
            else
            {
                <div>
                    <span class="badge bg-secondary">Inactivo</span>
                </div>
            }
        </div>
    </div>

    <div class="col-lg-8">
        <div class="card border-0 shadow-sm p-4">
            <h3 class="h5 fw-bold mb-4">
                <i class="bi bi-person-lines-fill me-2"></i>
                Información personal
            </h3>

            <div class="row g-4">
                <div class="col-md-6">
                    <div class="text-muted small mb-1">Nombre</div>
                    <div class="fw-semibold">@Model.Nombre</div>
                </div>

                <div class="col-md-6">
                    <div class="text-muted small mb-1">Apellido</div>
                    <div class="fw-semibold">@Model.Apellido</div>
                </div>

                <div class="col-md-6">
                    <div class="text-muted small mb-1">Identificación</div>
                    <div class="fw-semibold">
                        @(Model.Identificacion ?? "No registrada")
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="text-muted small mb-1">Teléfono</div>
                    <div class="fw-semibold">
                        @(Model.Telefono ?? "No registrado")
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="text-muted small mb-1">Correo electrónico</div>
                    <div class="fw-semibold">
                        @(Model.Email ?? "No registrado")
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="text-muted small mb-1">Fecha de registro</div>
                    <div class="fw-semibold">
                        @Model.FechaRegistro.ToString("dd/MM/yyyy HH:mm")
                    </div>
                </div>

                <div class="col-12">
                    <div class="text-muted small mb-1">Dirección</div>
                    <div class="fw-semibold">
                        @(Model.Direccion ?? "No registrada")
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
