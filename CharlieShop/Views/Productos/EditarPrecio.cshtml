@model CharlieShop.Models.EditarPrecioProductoViewModel

@{
    ViewData["Title"] = "Actualizar precio";
}

<div class="d-flex justify-content-between align-items-start mb-4">

    <div>
        <div class="page-title">
            Actualizar precio
        </div>

        <div class="page-subtitle">
            Modificar el precio de venta del producto.
        </div>
    </div>

    <a asp-action="Index"
       class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i>
        Cancelar
    </a>

</div>


<div class="row justify-content-center">

    <div class="col-lg-7">

        <div class="card p-4">

            <div class="mb-4">

                <div class="text-secondary mb-1">
                    Producto
                </div>

                <h4 class="mb-1">
                    @Model.Nombre
                </h4>

                <div class="text-secondary">
                    Código: @Model.Codigo
                </div>

            </div>


            <form asp-action="EditarPrecio"
                  method="post">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       asp-for="IdProducto" />

                <input type="hidden"
                       asp-for="Nombre" />

                <input type="hidden"
                       asp-for="Codigo" />

                <input type="hidden"
                       asp-for="PrecioActual" />


                <div class="mb-3">

                    <label class="form-label">
                        Precio actual
                    </label>

                    <input type="text"
                           class="form-control"
                           value="₡@Model.PrecioActual.ToString("N0")"
                           disabled />

                </div>


                <div class="mb-3">

                    <label asp-for="NuevoPrecio"
                           class="form-label">
                        Nuevo precio
                    </label>

                    <input asp-for="NuevoPrecio"
                           class="form-control"
                           type="number"
                           min="0.01"
                           step="0.01" />

                    <span asp-validation-for="NuevoPrecio"
                          class="text-danger">
                    </span>

                </div>


                <div class="d-flex justify-content-end gap-2 mt-4">

                    <a asp-action="Index"
                       class="btn btn-outline-secondary">
                        Cancelar
                    </a>

                    <button type="submit"
                            class="btn btn-primary">
                        <i class="bi bi-check-lg me-1"></i>
                        Guardar cambios
                    </button>

                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}