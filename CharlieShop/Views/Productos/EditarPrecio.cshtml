@model CharlieShop.Models.EditarPrecioProductoViewModel

@{
    ViewData["Title"] = "Actualizar precio";
}

<div class="price-page">

    <!-- Encabezado -->
    <div class="page-header">

        <div class="page-header-left">

            <div class="page-icon">
                <i class="bi bi-tag"></i>
            </div>

            <div>
                <h1>Actualizar precio</h1>
                <p>Modifica el precio de venta del producto seleccionado.</p>
            </div>

        </div>

        <a asp-action="Index"
           class="btn btn-outline-dark">
            <i class="bi bi-arrow-left me-1"></i>
            Volver
        </a>

    </div>


    <div class="row justify-content-center">

        <div class="col-xl-7 col-lg-8">

            <div class="price-card">

                <!-- Información del producto -->
                <div class="product-header">

                    <div class="product-icon">
                        <i class="bi bi-box-seam"></i>
                    </div>

                    <div class="product-info">

                        <span class="section-label">
                            PRODUCTO
                        </span>

                        <h2>
                            @Model.Nombre
                        </h2>

                        <span class="product-code">
                            Código: @Model.Codigo
                        </span>

                    </div>

                </div>


                <div class="divider"></div>


                <form asp-action="EditarPrecio"
                      method="post">

                    @Html.AntiForgeryToken()

                    <input type="hidden"
                           asp-for="IdProducto" />

                    <input type="hidden"
                           asp-for="Nombre" />

                    <input type="hidden"
                           asp-for="Codigo" />

                    <input type="hidden"
                           asp-for="PrecioActual" />


                    <!-- Precio actual -->
                    <div class="current-price-box">

                        <div class="current-price-info">

                            <span class="section-label">
                                PRECIO ACTUAL
                            </span>

                            <span class="current-price">
                                ₡@Model.PrecioActual.ToString("N0")
                            </span>

                        </div>

                        <div class="current-price-icon">
                            <i class="bi bi-cash-stack"></i>
                        </div>

                    </div>


                    <!-- Nuevo precio -->
                    <div class="new-price-section">

                        <label asp-for="NuevoPrecio"
                               class="form-label">
                            Nuevo precio
                        </label>

                        <div class="price-input-wrapper">

                            <span class="currency-symbol">
                                ₡
                            </span>

                            <input asp-for="NuevoPrecio"
                                   class="form-control price-input"
                                   type="number"
                                   min="0.01"
                                   step="0.01"
                                   placeholder="Ingrese el nuevo precio"
                                   autocomplete="off" />

                        </div>

                        <span asp-validation-for="NuevoPrecio"
                              class="validation-message">
                        </span>

                        <div class="input-help">
                            <i class="bi bi-info-circle"></i>
                            Ingresa el nuevo precio de venta del producto.
                        </div>

                    </div>


                    <!-- Acciones -->
                    <div class="form-actions">

                        <a asp-action="Index"
                           class="btn btn-cancel">
                            Cancelar
                        </a>

                        <button type="submit"
                                class="btn btn-save">
                            <i class="bi bi-check-lg me-1"></i>
                            Guardar cambios
                        </button>

                    </div>

                </form>

            </div>

        </div>

    </div>

</div>


<style>

    .price-page {
        max-width: 1200px;
        margin: 0 auto;
    }

    /* HEADER */

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        margin-bottom: 28px;
    }

    .page-header-left {
        display: flex;
        align-items: center;
        gap: 15px;
    }

    .page-icon {
        width: 48px;
        height: 48px;
        border-radius: 12px;
        background: #111;
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 21px;
        flex-shrink: 0;
    }

    .page-header h1 {
        margin: 0;
        font-size: 26px;
        font-weight: 700;
        color: #111;
    }

    .page-header p {
        margin: 4px 0 0;
        color: #6c757d;
        font-size: 14px;
    }


    /* MAIN CARD */

    .price-card {
        background: #fff;
        border: 1px solid #e7e7e7;
        border-radius: 16px;
        padding: 30px;
        box-shadow: 0 4px 16px rgba(0, 0, 0, 0.04);
    }


    /* PRODUCT */

    .product-header {
        display: flex;
        align-items: center;
        gap: 16px;
    }

    .product-icon {
        width: 58px;
        height: 58px;
        border-radius: 14px;
        background: #f3f3f3;
        color: #111;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 25px;
        flex-shrink: 0;
    }

    .product-info h2 {
        margin: 3px 0 2px;
        font-size: 21px;
        font-weight: 700;
        color: #111;
    }

    .section-label {
        display: block;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: .7px;
        color: #8a8a8a;
    }

    .product-code {
        font-size: 13px;
        color: #777;
    }


    .divider {
        height: 1px;
        background: #eeeeee;
        margin: 26px 0;
    }


    /* CURRENT PRICE */

    .current-price-box {
        display: flex;
        align-items: center;
        justify-content: space-between;
        background: #f7f7f7;
        border: 1px solid #e9e9e9;
        border-radius: 12px;
        padding: 18px 20px;
        margin-bottom: 28px;
    }

    .current-price {
        display: block;
        margin-top: 3px;
        font-size: 25px;
        font-weight: 700;
        color: #111;
    }

    .current-price-icon {
        width: 42px;
        height: 42px;
        border-radius: 10px;
        background: #fff;
        border: 1px solid #e4e4e4;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #555;
        font-size: 19px;
    }


    /* NEW PRICE */

    .new-price-section {
        margin-bottom: 28px;
    }

    .form-label {
        font-size: 14px;
        font-weight: 600;
        color: #222;
        margin-bottom: 8px;
    }

    .price-input-wrapper {
        position: relative;
    }

    .currency-symbol {
        position: absolute;
        left: 15px;
        top: 50%;
        transform: translateY(-50%);
        font-size: 17px;
        font-weight: 600;
        color: #555;
        z-index: 2;
    }

    .price-input {
        height: 52px;
        padding-left: 38px;
        border: 1px solid #dcdcdc;
        border-radius: 10px;
        font-size: 17px;
        font-weight: 600;
        color: #111;
        box-shadow: none;
    }

    .price-input:focus {
        border-color: #111;
        box-shadow: 0 0 0 3px rgba(0, 0, 0, 0.07);
    }

    .price-input::placeholder {
        color: #aaa;
        font-weight: 400;
    }

    .validation-message {
        display: block;
        margin-top: 6px;
        font-size: 13px;
        color: #dc3545;
    }

    .input-help {
        display: flex;
        align-items: center;
        gap: 6px;
        margin-top: 9px;
        color: #888;
        font-size: 12px;
    }


    /* BUTTONS */

    .form-actions {
        display: flex;
        justify-content: flex-end;
        align-items: center;
        gap: 10px;
        padding-top: 22px;
        border-top: 1px solid #eeeeee;
    }

    .btn-cancel {
        border: 1px solid #d7d7d7;
        background: #fff;
        color: #444;
        padding: 10px 18px;
        border-radius: 9px;
        font-size: 14px;
        font-weight: 500;
    }

    .btn-cancel:hover {
        background: #f5f5f5;
        color: #111;
        border-color: #c8c8c8;
    }

    .btn-save {
        border: none;
        background: #111;
        color: #fff;
        padding: 10px 19px;
        border-radius: 9px;
        font-size: 14px;
        font-weight: 600;
    }

    .btn-save:hover {
        background: #2b2b2b;
        color: #fff;
    }

    .btn-outline-dark {
        border-radius: 9px;
        padding: 9px 16px;
        font-size: 14px;
        font-weight: 500;
    }


    /* RESPONSIVE */

    @@media (max-width: 576px) {

        .page-header {
            align-items: flex-start;
            flex-direction: column;
        }

        .page-header-left {
            align-items: flex-start;
        }

        .price-card {
            padding: 22px;
        }

        .current-price-box {
            padding: 16px;
        }

        .form-actions {
            flex-direction: column-reverse;
            align-items: stretch;
        }

        .btn-cancel,
        .btn-save {
            width: 100%;
            text-align: center;
        }

    }

</style>


@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}