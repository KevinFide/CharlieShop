@model CharlieShop.Models.EditarProductoViewModel

@{
    ViewData["Title"] = "Editar producto";
    ViewData["BreadcrumbProductoId"] = Model.IdProducto;
    ViewData["Breadcrumbs"] = new List<(string Texto, string? Controlador, string? Accion)>
    {
        ("Productos", "Productos", "Index"),
        ("Detalle de producto", "Productos", "Detalle"),
        ("Editar producto", null, null)
    };
}

<style>
    .edit-product-page { max-width: 1050px; margin: 0 auto; }
    .edit-header-icon { width: 54px; height: 54px; display:flex; align-items:center; justify-content:center; border-radius:16px; background:#f1f5f9; color:#111827; }
    .edit-card { border:1px solid #e5e7eb; border-radius:18px; overflow:hidden; }
    .edit-section-title { font-size:1rem; font-weight:700; color:#111827; margin-bottom:1rem; }
    .form-label { font-weight:600; color:#374151; font-size:.9rem; }
    .form-control { border-color:#d1d5db; border-radius:10px; padding:.7rem .85rem; }
    .form-control:focus { border-color:#6b7280; box-shadow:0 0 0 .2rem rgba(17,24,39,.08); }
    .image-panel { border:1px dashed #cbd5e1; border-radius:16px; padding:1.25rem; background:#f8fafc; }
    .image-preview-frame { width:100%; height:230px; display:flex; align-items:center; justify-content:center; overflow:hidden; border-radius:12px; background:#fff; border:1px solid #e5e7eb; }
    .image-preview-frame img { width:100%; height:100%; object-fit:contain; padding:10px; }
    .image-placeholder { display:flex; flex-direction:column; align-items:center; gap:.5rem; color:#9ca3af; }
    .image-placeholder i { font-size:3rem; }
    .btn-clean { border-radius:10px; padding:.7rem 1rem; font-weight:600; }
    .section-divider { border:0; border-top:1px solid #eef0f3; margin:1.5rem 0; }
    @@media (max-width: 767.98px) { .edit-card .card-body { padding:1rem !important; } .image-preview-frame { height:190px; } }
</style>

<div class="container py-4 edit-product-page">
    <div class="d-flex align-items-center gap-3 mb-4">
        <div class="edit-header-icon"><i class="bi bi-pencil-square fs-3"></i></div>
        <div>
            <h2 class="fw-bold mb-1">Editar producto</h2>
            <p class="text-muted mb-0">Actualiza los datos, precios y fotografía del producto.</p>
        </div>
    </div>

    <form asp-action="Editar" method="post" enctype="multipart/form-data" id="editProductForm">
        @Html.AntiForgeryToken()
        <input asp-for="IdProducto" type="hidden" />
        <input asp-for="ImagenUrl" type="hidden" />

        <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3"></div>

        <div class="card edit-card shadow-sm mb-4">
            <div class="card-body p-4">
                <div class="row g-4">
                    <div class="col-lg-7">
                        <h5 class="edit-section-title"><i class="bi bi-box-seam me-2"></i>Información general</h5>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="Nombre" class="form-label"></label>
                                <input asp-for="Nombre" class="form-control" placeholder="Nombre del producto" />
                                <span asp-validation-for="Nombre" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Codigo" class="form-label"></label>
                                <input asp-for="Codigo" class="form-control" placeholder="Código único" />
                                <span asp-validation-for="Codigo" class="text-danger small"></span>
                            </div>
                            <div class="col-12">
                                <label asp-for="Descripcion" class="form-label"></label>
                                <textarea asp-for="Descripcion" class="form-control" rows="4" placeholder="Descripción o detalles del producto"></textarea>
                                <span asp-validation-for="Descripcion" class="text-danger small"></span>
                            </div>
                        </div>

                        <hr class="section-divider" />
                        <h5 class="edit-section-title"><i class="bi bi-tags me-2"></i>Clasificación</h5>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="Categoria" class="form-label"></label>
                                <input asp-for="Categoria" class="form-control" placeholder="Categoría" />
                                <span asp-validation-for="Categoria" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="UnidadMedida" class="form-label"></label>
                                <input asp-for="UnidadMedida" class="form-control" placeholder="Ej. unidad, caja, kg" />
                                <span asp-validation-for="UnidadMedida" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>

                    <div class="col-lg-5">
                        <h5 class="edit-section-title"><i class="bi bi-image me-2"></i>Fotografía del producto</h5>
                        <div class="image-panel">
                            <div class="image-preview-frame mb-3">
                                <img id="imagePreview"
                                     src="@(string.IsNullOrWhiteSpace(Model.ImagenUrl) ? "" : Model.ImagenUrl)"
                                     alt="Vista previa de la imagen del producto"
                                     style="@(string.IsNullOrWhiteSpace(Model.ImagenUrl) ? "display:none;" : "display:block;")"
                                     onerror="this.style.display='none'; document.getElementById('imagePlaceholder').style.display='flex';" />
                                <div id="imagePlaceholder" class="image-placeholder" style="@(string.IsNullOrWhiteSpace(Model.ImagenUrl) ? "display:flex;" : "display:none;")">
                                    <i class="bi bi-image"></i>
                                    <span>Sin imagen disponible</span>
                                </div>
                            </div>
                            <label asp-for="ImagenArchivo" class="form-label">Cambiar imagen</label>
                            <input asp-for="ImagenArchivo" type="file" class="form-control" accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" id="imageFile" />
                            <span asp-validation-for="ImagenArchivo" class="text-danger small"></span>
                            <div class="form-text mt-2">Formatos permitidos: JPG, PNG o WebP. Máximo 5 MB. Si no seleccionas otra imagen, se conservará la actual.</div>
                            <div id="imageError" class="text-danger small mt-2" style="display:none;"></div>
                        </div>
                    </div>
                </div>

                <hr class="section-divider" />
                <h5 class="edit-section-title"><i class="bi bi-currency-dollar me-2"></i>Precios</h5>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="Costo" class="form-label"></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0">₡</span>
                            <input asp-for="Costo" class="form-control border-start-0" type="number" min="0" step="0.01" />
                        </div>
                        <span asp-validation-for="Costo" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="PrecioVenta" class="form-label"></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0">₡</span>
                            <input asp-for="PrecioVenta" class="form-control border-start-0" type="number" min="0" step="0.01" />
                        </div>
                        <span asp-validation-for="PrecioVenta" class="text-danger small"></span>
                    </div>
                </div>
            </div>
        </div>

        <div class="d-flex justify-content-between flex-wrap gap-2">
            <a asp-action="Index" class="btn btn-outline-secondary btn-clean">
                <i class="bi bi-arrow-left me-1"></i>Cancelar
            </a>
            <button type="submit" class="btn btn-dark btn-clean">
                <i class="bi bi-check2-circle me-1"></i>Guardar cambios
            </button>
        </div>
    </form>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
    <script>
        (() => {
            const input = document.getElementById('imageFile');
            const preview = document.getElementById('imagePreview');
            const placeholder = document.getElementById('imagePlaceholder');
            const error = document.getElementById('imageError');
            const maxSize = 5 * 1024 * 1024;
            const allowedTypes = ['image/jpeg', 'image/png', 'image/webp'];

            input?.addEventListener('change', function () {
                error.style.display = 'none';
                error.textContent = '';
                const file = this.files && this.files[0];
                if (!file) return;

                if (!allowedTypes.includes(file.type) || !/\.(jpg|jpeg|png|webp)$/i.test(file.name)) {
                    error.textContent = 'Selecciona una imagen JPG, PNG o WebP.';
                    error.style.display = 'block';
                    this.value = '';
                    return;
                }
                if (file.size > maxSize) {
                    error.textContent = 'La imagen no puede superar los 5 MB.';
                    error.style.display = 'block';
                    this.value = '';
                    return;
                }

                const reader = new FileReader();
                reader.onload = e => {
                    preview.src = e.target.result;
                    preview.style.display = 'block';
                    placeholder.style.display = 'none';
                };
                reader.readAsDataURL(file);
            });
        })();
    </script>
}
