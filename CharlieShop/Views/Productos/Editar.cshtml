
@model CharlieShop.Models.EditarProductoViewModel

@{
    ViewData["Title"] = "Editar producto";
    ViewData["BreadcrumbProductoId"] = Model.IdProducto;

    ViewData["Breadcrumbs"] = new List<(string Texto, string? Controlador, string? Accion)>
    {
        ("Productos", "Productos", "Index"),
        ("Detalle de producto", "Productos", "Detalle"),
        ("Editar producto", null, null)
    };
}

<div class="container mt-4">

    <div class="d-flex align-items-center mb-4">
        <div class="me-3 p-3 rounded"
             style="background-color: #e8f0ff; color: #2563eb;">
            <i class="bi bi-pencil-square fs-3"></i>
        </div>

        <div>
            <h2 class="mb-1">Editar producto</h2>
            <p class="text-muted mb-0">
                Modifica la información general, clasificación y precios del producto.
            </p>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-4">

            <form asp-action="Editar" method="post">

                <input asp-for="IdProducto" type="hidden" />

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3"></div>

                <!-- INFORMACIÓN GENERAL -->
                <section class="mb-4">

                    <h5 class="mb-3">
                        <i class="bi bi-box-seam me-2 text-primary"></i>
                        Información general
                    </h5>

                    <div class="row g-3">

                        <div class="col-md-6">
                            <label asp-for="Nombre" class="form-label"></label>
                            <input asp-for="Nombre" class="form-control" />
                            <span asp-validation-for="Nombre"
                                  class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Codigo" class="form-label"></label>
                            <input asp-for="Codigo" class="form-control" />
                            <span asp-validation-for="Codigo"
                                  class="text-danger"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="Descripcion" class="form-label"></label>
                            <textarea asp-for="Descripcion"
                                      class="form-control"
                                      rows="3"></textarea>
                            <span asp-validation-for="Descripcion"
                                  class="text-danger"></span>
                        </div>

                    </div>
                </section>

                <hr class="my-4" />

                <!-- CLASIFICACIÓN -->
                <section class="mb-4">

                    <h5 class="mb-3">
                        <i class="bi bi-tags me-2 text-primary"></i>
                        Clasificación
                    </h5>

                    <div class="row g-3">

                        <div class="col-md-6">
                            <label asp-for="Categoria" class="form-label"></label>
                            <input asp-for="Categoria" class="form-control" />
                            <span asp-validation-for="Categoria"
                                  class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="UnidadMedida"
                                   class="form-label"></label>
                            <input asp-for="UnidadMedida"
                                   class="form-control" />
                            <span asp-validation-for="UnidadMedida"
                                  class="text-danger"></span>
                        </div>

                    </div>
                </section>

                <hr class="my-4" />

                <!-- PRECIOS -->
                <section class="mb-4">

                    <h5 class="mb-3">
                        <i class="bi bi-currency-dollar me-2 text-primary"></i>
                        Precios
                    </h5>

                    <div class="row g-3">

                        <div class="col-md-6">
                            <label asp-for="Costo" class="form-label"></label>
                            <input asp-for="Costo"
                                   class="form-control"
                                   type="number"
                                   step="0.01" />
                            <span asp-validation-for="Costo"
                                  class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="PrecioVenta"
                                   class="form-label"></label>
                            <input asp-for="PrecioVenta"
                                   class="form-control"
                                   type="number"
                                   step="0.01" />
                            <span asp-validation-for="PrecioVenta"
                                  class="text-danger"></span>
                        </div>

                    </div>
                </section>

                <hr class="my-4" />

                <!-- ACCIONES -->
                <div class="d-flex justify-content-between flex-wrap gap-2">

                    <a asp-action="Index"
                       class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left me-1"></i>
                        Cancelar
                    </a>

                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-save me-1"></i>
                        Guardar cambios
                    </button>

                </div>

            </form>

        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
