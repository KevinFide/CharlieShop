@model CharlieShop.Models.Producto

@{
    ViewData["Title"] = "Detalle de producto";

    var estadoClase = Model.Estado
        ? "bg-success"
        : "bg-secondary";

    var estadoTexto = Model.Estado
        ? "Producto activo"
        : "Producto inactivo";

    var stockClase = Model.StockActual <= Model.StockMinimo
        ? "text-danger"
        : "text-success";
}

<div class="d-flex justify-content-between align-items-start mb-4">
    <div>
        <div class="page-title">Detalle de producto</div>
        <div class="page-subtitle">
            Información general, precios y existencias del producto.
        </div>
    </div>

    <div class="d-flex gap-2">

        <a asp-action="Index"
           class="btn btn-outline-secondary">

            <i class="bi bi-arrow-left me-1"></i>
            Volver

        </a>

        <button class="btn btn-primary">

            <i class="bi bi-pencil me-1"></i>
            Editar producto

        </button>

    </div>
</div>


<div class="row g-4">

    <!-- Información general -->
    <div class="col-lg-4">

        <div class="card p-4 text-center h-100">

            <div class="product-placeholder mx-auto mb-3">
                <i class="bi bi-box-seam"></i>
            </div>

            <h4 class="mb-1">
                @Model.Nombre
            </h4>

            <div class="text-secondary mb-3">
                Código @Model.Codigo
            </div>

            <span class="badge @estadoClase align-self-center px-3 py-2">
                @estadoTexto
            </span>

            <hr />

            <div class="row text-start g-3">

                <div class="col-6">

                    <div class="info-label">
                        Categoría
                    </div>

                    <strong>
                        @Model.Categoria
                    </strong>

                </div>


                <div class="col-6">

                    <div class="info-label">
                        Unidad
                    </div>

                    <strong>
                        @Model.UnidadMedida
                    </strong>

                </div>


                <div class="col-6">

                    <div class="info-label">
                        Creado
                    </div>

                    <strong>
                        @Model.FechaCreacion.ToString("dd/MM/yyyy")
                    </strong>

                </div>


                <div class="col-6">

                    <div class="info-label">
                        Estado
                    </div>

                    <strong>
                        @estadoTexto
                    </strong>

                </div>

            </div>

        </div>

    </div>


    <!-- Información del producto -->
    <div class="col-lg-8">

        <div class="row g-3 mb-4">

            <div class="col-md-4">

                <div class="card metric">

                    <div class="label">
                        Precio de venta
                    </div>

                    <div class="value">
                        ₡@Model.PrecioVenta.ToString("N0")
                    </div>

                </div>

            </div>


            <div class="col-md-4">

                <div class="card metric">

                    <div class="label">
                        Stock actual
                    </div>

                    <div class="value @stockClase">
                        @Model.StockActual.ToString("N0")
                    </div>

                </div>

            </div>


            <div class="col-md-4">

                <div class="card metric">

                    <div class="label">
                        Stock mínimo
                    </div>

                    <div class="value">
                        @Model.StockMinimo.ToString("N0")
                    </div>

                </div>

            </div>

        </div>


        <!-- Descripción -->
        <div class="card p-4 mb-4">

            <h5>
                Descripción
            </h5>

            <p class="text-secondary mb-0">

                @if (!string.IsNullOrWhiteSpace(Model.Descripcion))
                {
                    @Model.Descripcion
                }
                else
                {
                    <span>
                        Este producto no tiene una descripción registrada.
                    </span>
                }

            </p>

        </div>


        <!-- Últimos movimientos -->
        <div class="card p-4">

            <div class="d-flex justify-content-between align-items-center mb-3">

                <h5 class="mb-0">
                    Últimos movimientos
                </h5>

                <a asp-controller="Inventario"
                   asp-action="Historial"
                   class="btn btn-sm btn-outline-primary">

                    Ver historial completo

                </a>

            </div>

            <div class="text-center text-secondary py-4">

                <i class="bi bi-clock-history fs-3 d-block mb-2"></i>

                <span>
                    Los movimientos de inventario se mostrarán aquí.
                </span>

            </div>

        </div>

    </div>

</div>