@model CharlieShop.Models.Producto

@{
    ViewData["Title"] = "Detalle de producto";

    var stockBajo = Model.StockActual <= Model.StockMinimo;

    var estadoTexto = Model.Estado
        ? "Activo"
        : "Inactivo";

    var estadoClase = Model.Estado
        ? "status-active"
        : "status-inactive";
}

<style>
    .producto-detalle-page {
        padding: 10px 0 30px;
    }

    /* ================================
       ENCABEZADO
    ================================= */

    .detail-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        margin-bottom: 25px;
    }

    .detail-title-wrapper {
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .detail-page-icon {
        width: 48px;
        height: 48px;
        border-radius: 12px;
        background: #111;
        color: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 21px;
        flex-shrink: 0;
    }

    .detail-title {
        margin: 0;
        font-size: 28px;
        font-weight: 700;
        color: #111;
    }

    .detail-subtitle {
        margin: 3px 0 0;
        color: #777;
        font-size: 14px;
    }

    .detail-actions {
        display: flex;
        gap: 8px;
    }

    .btn-detail-back,
    .btn-detail-edit {
        height: 40px;
        padding: 0 15px;
        border-radius: 9px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        font-size: 13px;
        font-weight: 600;
        text-decoration: none;
        transition: .2s ease;
    }

    .btn-detail-back {
        background: #fff;
        border: 1px solid #ddd;
        color: #444;
    }

    .btn-detail-back:hover {
        background: #f7f7f7;
        color: #111;
        border-color: #bbb;
    }

    .btn-detail-edit {
        background: #111;
        border: 1px solid #111;
        color: #fff;
    }

    .btn-detail-edit:hover {
        background: #333;
        border-color: #333;
        color: #fff;
    }


    /* ================================
       TARJETA PRINCIPAL
    ================================= */

    .product-main-card {
        background: #fff;
        border: 1px solid #e7e7e7;
        border-radius: 14px;
        padding: 25px;
        height: 100%;
    }

    .product-visual {
        width: 110px;
        height: 110px;
        margin: 0 auto 18px;
        border-radius: 18px;
        background: #f4f4f4;
        color: #222;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 43px;
    }

    .product-name {
        margin: 0;
        color: #111;
        font-size: 21px;
        font-weight: 700;
    }

    .product-code {
        margin-top: 5px;
        color: #888;
        font-size: 13px;
    }

    .product-code span {
        font-family: monospace;
        background: #f4f4f4;
        padding: 3px 7px;
        border-radius: 5px;
        color: #555;
    }

    .product-status {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 11px;
        margin-top: 14px;
        border-radius: 8px;
        font-size: 12px;
        font-weight: 600;
    }

    .product-status.status-active {
        background: #eaf7ee;
        color: #217a3a;
    }

    .product-status.status-inactive {
        background: #f0f0f0;
        color: #777;
    }

    .status-dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: currentColor;
    }

    .product-divider {
        border: 0;
        border-top: 1px solid #ededed;
        margin: 24px 0;
    }


    /* ================================
       INFORMACIÓN GENERAL
    ================================= */

    .info-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 18px 14px;
        text-align: left;
    }

    .info-label {
        color: #999;
        font-size: 11px;
        text-transform: uppercase;
        letter-spacing: .4px;
        font-weight: 700;
        margin-bottom: 4px;
    }

    .info-value {
        color: #222;
        font-size: 14px;
        font-weight: 600;
    }


    /* ================================
       MÉTRICAS
    ================================= */

    .metrics-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 14px;
        margin-bottom: 18px;
    }

    .metric-card {
        background: #fff;
        border: 1px solid #e7e7e7;
        border-radius: 14px;
        padding: 18px;
        min-height: 115px;
    }

    .metric-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 10px;
    }

    .metric-label {
        color: #777;
        font-size: 12px;
        font-weight: 600;
    }

    .metric-icon {
        width: 34px;
        height: 34px;
        border-radius: 9px;
        background: #f3f3f3;
        color: #333;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 15px;
    }

    .metric-value {
        margin-top: 13px;
        color: #111;
        font-size: 23px;
        font-weight: 700;
    }

    .metric-value.stock-normal {
        color: #217a3a;
    }

    .metric-value.stock-low {
        color: #c62828;
    }

    .stock-warning {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        margin-top: 4px;
        color: #c62828;
        font-size: 11px;
        font-weight: 600;
    }


    /* ================================
       TARJETAS DE CONTENIDO
    ================================= */

    .content-card {
        background: #fff;
        border: 1px solid #e7e7e7;
        border-radius: 14px;
        padding: 22px;
        margin-bottom: 18px;
    }

    .content-card:last-child {
        margin-bottom: 0;
    }

    .content-card-header {
        display: flex;
        align-items: center;
        gap: 9px;
        margin-bottom: 12px;
    }

    .content-card-icon {
        width: 32px;
        height: 32px;
        border-radius: 8px;
        background: #f3f3f3;
        color: #333;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 14px;
    }

    .content-card-title {
        margin: 0;
        color: #111;
        font-size: 16px;
        font-weight: 700;
    }

    .description-text {
        margin: 0;
        color: #666;
        font-size: 14px;
        line-height: 1.7;
    }

    .description-empty {
        color: #999;
        font-style: italic;
    }


    /* ================================
       MOVIMIENTOS
    ================================= */

    .movements-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 15px;
        margin-bottom: 18px;
    }

    .movements-title-wrapper {
        display: flex;
        align-items: center;
        gap: 9px;
    }

    .movements-title {
        margin: 0;
        color: #111;
        font-size: 16px;
        font-weight: 700;
    }

    .btn-history {
        height: 34px;
        padding: 0 12px;
        border: 1px solid #ddd;
        border-radius: 8px;
        background: #fff;
        color: #444;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        text-decoration: none;
        font-size: 12px;
        font-weight: 600;
        transition: .2s ease;
    }

    .btn-history:hover {
        background: #f5f5f5;
        border-color: #bbb;
        color: #111;
    }

    .movements-empty {
        border: 1px dashed #ddd;
        border-radius: 10px;
        padding: 30px 20px;
        text-align: center;
        color: #888;
    }

    .movements-empty i {
        display: block;
        margin-bottom: 8px;
        color: #bbb;
        font-size: 27px;
    }

    .movements-empty span {
        font-size: 13px;
    }


    /* ================================
       RESPONSIVE
    ================================= */

    @@media (max-width: 992px) {

        .metrics-grid {
            grid-template-columns: 1fr;
        }

    }

    @@media (max-width: 768px) {

        .detail-header {
            align-items: flex-start;
            flex-direction: column;
        }

        .detail-actions {
            width: 100%;
        }

        .btn-detail-back,
        .btn-detail-edit {
            flex: 1;
        }

        .info-grid {
            grid-template-columns: 1fr 1fr;
        }

    }

    @@media (max-width: 500px) {

        .detail-title {
            font-size: 23px;
        }

        .detail-actions {
            flex-direction: column;
        }

        .info-grid {
            grid-template-columns: 1fr;
        }

        .movements-header {
            align-items: flex-start;
            flex-direction: column;
        }

        .btn-history {
            width: 100%;
            justify-content: center;
        }

    }
</style>


<div class="producto-detalle-page">

    <!-- =====================================================
         ENCABEZADO
    ====================================================== -->

    <div class="detail-header">

        <div class="detail-title-wrapper">

            <div class="detail-page-icon">
                <i class="bi bi-box-seam"></i>
            </div>

            <div>

                <h1 class="detail-title">
                    Detalle de producto
                </h1>

                <p class="detail-subtitle">
                    Información general, precios y existencias del producto.
                </p>

            </div>

        </div>


        <div class="detail-actions">

            <a asp-action="Index"
               class="btn-detail-back">

                <i class="bi bi-arrow-left"></i>
                Volver

            </a>


            <a asp-action="Editar"
               asp-route-id="@Model.IdProducto"
               class="btn-detail-edit">

                <i class="bi bi-pencil"></i>
                Editar producto

            </a>

        </div>

    </div>


    <!-- =====================================================
         CONTENIDO
    ====================================================== -->

    <div class="row g-4">

        <!-- =================================================
             INFORMACIÓN PRINCIPAL
        ================================================== -->

        <div class="col-lg-4">

            <div class="product-main-card text-center">

                <div class="product-visual">

                    <i class="bi bi-box-seam"></i>

                </div>


                <h2 class="product-name">
                    @Model.Nombre
                </h2>


                <div class="product-code">

                    Código
                    <span>
                        @Model.Codigo
                    </span>

                </div>


                <div class="product-status @estadoClase">

                    <span class="status-dot"></span>

                    @estadoTexto

                </div>


                <hr class="product-divider" />


                <div class="info-grid">

                    <div>

                        <div class="info-label">
                            Categoría
                        </div>

                        <div class="info-value">
                            @Model.Categoria
                        </div>

                    </div>


                    <div>

                        <div class="info-label">
                            Unidad
                        </div>

                        <div class="info-value">
                            @Model.UnidadMedida
                        </div>

                    </div>


                    <div>

                        <div class="info-label">
                            Creado
                        </div>

                        <div class="info-value">
                            @Model.FechaCreacion.ToString("dd/MM/yyyy")
                        </div>

                    </div>


                    <div>

                        <div class="info-label">
                            Estado
                        </div>

                        <div class="info-value">
                            @estadoTexto
                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- =================================================
             INFORMACIÓN DEL PRODUCTO
        ================================================== -->

        <div class="col-lg-8">


            <!-- MÉTRICAS -->

            <div class="metrics-grid">

                <!-- PRECIO -->

                <div class="metric-card">

                    <div class="metric-top">

                        <div class="metric-label">
                            Precio de venta
                        </div>

                        <div class="metric-icon">
                            <i class="bi bi-currency-exchange"></i>
                        </div>

                    </div>

                    <div class="metric-value">
                        ₡@Model.PrecioVenta.ToString("N0")
                    </div>

                </div>


                <!-- STOCK ACTUAL -->

                <div class="metric-card">

                    <div class="metric-top">

                        <div class="metric-label">
                            Stock actual
                        </div>

                        <div class="metric-icon">
                            <i class="bi bi-boxes"></i>
                        </div>

                    </div>

                    <div class="metric-value @(stockBajo ? "stock-low" : "stock-normal")">

                        @Model.StockActual.ToString("N0")

                    </div>

                    @if (stockBajo)
                    {
                        <div class="stock-warning">

                            <i class="bi bi-exclamation-triangle-fill"></i>

                            Stock bajo

                        </div>
                    }

                </div>


                <!-- STOCK MÍNIMO -->

                <div class="metric-card">

                    <div class="metric-top">

                        <div class="metric-label">
                            Stock mínimo
                        </div>

                        <div class="metric-icon">
                            <i class="bi bi-bar-chart-line"></i>
                        </div>

                    </div>

                    <div class="metric-value">
                        @Model.StockMinimo.ToString("N0")
                    </div>

                </div>

            </div>


            <!-- =================================================
                 DESCRIPCIÓN
            ================================================== -->

            <div class="content-card">

                <div class="content-card-header">

                    <div class="content-card-icon">
                        <i class="bi bi-card-text"></i>
                    </div>

                    <h3 class="content-card-title">
                        Descripción
                    </h3>

                </div>


                @if (!string.IsNullOrWhiteSpace(Model.Descripcion))
                {
                    <p class="description-text">
                        @Model.Descripcion
                    </p>
                }
                else
                {
                    <p class="description-text description-empty">
                        Este producto no tiene una descripción registrada.
                    </p>
                }

            </div>


            <!-- =================================================
                 ÚLTIMOS MOVIMIENTOS
            ================================================== -->

            <div class="content-card">

                <div class="movements-header">

                    <div class="movements-title-wrapper">

                        <div class="content-card-icon">
                            <i class="bi bi-clock-history"></i>
                        </div>

                        <h3 class="movements-title">
                            Últimos movimientos
                        </h3>

                    </div>


                    <a asp-controller="Inventario"
                       asp-action="Historial"
                       class="btn-history">

                        <i class="bi bi-arrow-right"></i>
                        Ver historial completo

                    </a>

                </div>


                <div class="movements-empty">

                    <i class="bi bi-clock-history"></i>

                    <span>
                        Los movimientos de inventario se mostrarán aquí.
                    </span>

                </div>

            </div>

        </div>

    </div>

</div>