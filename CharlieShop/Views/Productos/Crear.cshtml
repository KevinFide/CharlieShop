
@model CharlieShop.Models.CrearProductoViewModel

@{
    ViewData["Title"] = "Registrar producto";

    ViewData["Breadcrumbs"] = new List<(string Texto, string? Controlador, string? Accion)>
    {
        ("Productos", "Productos", "Index"),
        ("Registrar producto", null, null)
    };
}

<div class="product-form-page">
    <div class="product-page-header">
        <div class="product-page-heading">
            <div class="product-page-icon">
                <i class="bi bi-box-seam"></i>
            </div>
            <div>
                <h1>Registrar producto</h1>
                <p>Agregá un nuevo producto al catálogo de Charlie Shop.</p>
            </div>
        </div>

        <a asp-action="Index" class="btn btn-outline-dark btn-back">
            <i class="bi bi-arrow-left me-1"></i>
            Volver a productos
        </a>
    </div>

    <div class="product-form-card">
        <div class="product-form-card-header">
            <div>
                <h2>Información del producto</h2>
                <p>Completá los datos para registrar el producto.</p>
            </div>
            <span class="product-form-tag">
                <i class="bi bi-plus-circle me-1"></i>
                Nuevo producto
            </span>
        </div>

        <form asp-action="Crear" method="post">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly"
                 class="validation-summary"></div>

            <div class="product-form-section">
                <h3>
                    <i class="bi bi-card-text me-2"></i>
                    Datos generales
                </h3>

                <div class="row g-4">
                    <div class="col-md-4">
                        <label asp-for="Codigo" class="form-label">
                            Código <span class="required">*</span>
                        </label>
                        <input asp-for="Codigo"
                               class="form-control"
                               placeholder="Ej. P-014"
                               autocomplete="off" />
                        <span asp-validation-for="Codigo"
                              class="field-error"></span>
                    </div>

                    <div class="col-md-8">
                        <label asp-for="Nombre" class="form-label">
                            Nombre del producto <span class="required">*</span>
                        </label>
                        <input asp-for="Nombre"
                               class="form-control"
                               placeholder="Ej. Bolso casual negro" />
                        <span asp-validation-for="Nombre"
                              class="field-error"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Categoria" class="form-label"></label>
                        <div class="input-icon-wrapper">
                            <i class="bi bi-tag"></i>
                            <input asp-for="Categoria"
                                   class="form-control"
                                   placeholder="Ej. Bolsos, ropa, accesorios" />
                        </div>
                        <span asp-validation-for="Categoria"
                              class="field-error"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="UnidadMedida" class="form-label"></label>
                        <div class="input-icon-wrapper">
                            <i class="bi bi-rulers"></i>
                            <input asp-for="UnidadMedida"
                                   class="form-control"
                                   placeholder="Ej. Unidad, par, paquete" />
                        </div>
                        <span asp-validation-for="UnidadMedida"
                              class="field-error"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="Descripcion" class="form-label"></label>
                        <textarea asp-for="Descripcion"
                                  class="form-control"
                                  rows="4"
                                  placeholder="Describí las características principales del producto..."></textarea>
                        <span asp-validation-for="Descripcion"
                              class="field-error"></span>
                    </div>
                </div>
            </div>

            <div class="product-form-section">
                <h3>
                    <i class="bi bi-currency-dollar me-2"></i>
                    Información de precios
                </h3>

                <div class="row g-4">
                    <div class="col-md-6">
                        <label asp-for="PrecioVenta" class="form-label">
                            Precio de venta <span class="required">*</span>
                        </label>
                        <div class="input-group price-input">
                            <span class="input-group-text">₡</span>
                            <input asp-for="PrecioVenta"
                                   class="form-control"
                                   type="number"
                                   min="0"
                                   step="0.01"
                                   placeholder="0.00" />
                        </div>
                        <span asp-validation-for="PrecioVenta"
                              class="field-error"></span>
                        <small class="field-hint">
                            Precio al que se venderá el producto.
                        </small>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Costo" class="form-label">
                            Costo del producto <span class="required">*</span>
                        </label>
                        <div class="input-group price-input">
                            <span class="input-group-text">₡</span>
                            <input asp-for="Costo"
                                   class="form-control"
                                   type="number"
                                   min="0"
                                   step="0.01"
                                   placeholder="0.00" />
                        </div>
                        <span asp-validation-for="Costo"
                              class="field-error"></span>
                        <small class="field-hint">
                            Costo de adquisición del producto.
                        </small>
                    </div>
                </div>
            </div>

            <div class="product-form-note">
                <i class="bi bi-info-circle"></i>
                <span>
                    Revisá que el código y los precios sean correctos antes
                    de registrar el producto.
                </span>
            </div>

            <div class="product-form-actions">
                <a asp-action="Index" class="btn btn-light">
                    Cancelar
                </a>
                <button type="submit" class="btn btn-dark">
                    <i class="bi bi-check-lg me-1"></i>
                    Registrar producto
                </button>
            </div>
        </form>
    </div>
</div>

<style>
    .product-form-page {
        max-width: 1100px;
        margin: 0 auto;
        padding-bottom: 25px;
    }

    .product-page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        margin-bottom: 28px;
    }

    .product-page-heading {
        display: flex;
        align-items: center;
        gap: 15px;
    }

    .product-page-icon {
        width: 49px;
        height: 49px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 12px;
        background: #111;
        color: #fff;
        font-size: 21px;
    }

    .product-page-heading h1 {
        margin: 0;
        color: #111;
        font-size: 26px;
        font-weight: 700;
    }

    .product-page-heading p {
        margin: 5px 0 0;
        color: #777;
        font-size: 14px;
    }

    .btn-back {
        padding: 10px 14px;
        border-radius: 9px;
        font-size: 13px;
    }

    .product-form-card {
        overflow: hidden;
        background: #fff;
        border: 1px solid #e8e8e8;
        border-radius: 15px;
        box-shadow: 0 3px 14px rgba(0, 0, 0, .025);
    }

    .product-form-card-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 15px;
        padding: 25px;
        border-bottom: 1px solid #eee;
    }

    .product-form-card-header h2 {
        margin: 0;
        color: #171717;
        font-size: 17px;
        font-weight: 700;
    }

    .product-form-card-header p {
        margin: 5px 0 0;
        color: #858585;
        font-size: 13px;
    }

    .product-form-tag {
        padding: 8px 11px;
        border-radius: 8px;
        background: #f1f1f1;
        color: #333;
        font-size: 12px;
        font-weight: 600;
        white-space: nowrap;
    }

    .product-form-section {
        padding: 25px;
        border-bottom: 1px solid #eee;
    }

    .product-form-section h3 {
        margin: 0 0 22px;
        color: #222;
        font-size: 14px;
        font-weight: 700;
    }

    .product-form-section h3 i {
        color: #666;
    }

    .product-form-page .form-label {
        display: block;
        margin-bottom: 8px;
        color: #444;
        font-size: 13px;
        font-weight: 600;
    }

    .required {
        color: #c83c43;
    }

    .product-form-page .form-control,
    .product-form-page .input-group-text {
        min-height: 44px;
        border-color: #dedede;
        border-radius: 9px;
        font-size: 13px;
        box-shadow: none;
    }

    .product-form-page .form-control {
        padding: 11px 13px;
    }

    .product-form-page textarea.form-control {
        min-height: 110px;
        resize: vertical;
    }

    .product-form-page .form-control:focus {
        border-color: #777;
        box-shadow: 0 0 0 3px rgba(0, 0, 0, .05);
    }

    .input-icon-wrapper {
        position: relative;
    }

    .input-icon-wrapper > i {
        position: absolute;
        top: 50%;
        left: 13px;
        transform: translateY(-50%);
        color: #888;
        pointer-events: none;
    }

    .input-icon-wrapper .form-control {
        padding-left: 38px;
    }

    .price-input .input-group-text {
        display: flex;
        align-items: center;
        padding: 0 15px;
        border-radius: 9px 0 0 9px;
        background: #f8f8f8;
        color: #555;
    }

    .price-input .form-control {
        border-radius: 0 9px 9px 0;
    }

    .field-error {
        display: block;
        margin-top: 6px;
        color: #c83c43;
        font-size: 12px;
    }

    .field-hint {
        display: block;
        margin-top: 7px;
        color: #888;
        font-size: 11px;
    }

    .validation-summary:empty {
        display: none;
    }

    .validation-summary:not(:empty) {
        margin: 20px 25px 0;
        padding: 12px;
        border: 1px solid #f1cccc;
        border-radius: 8px;
        background: #fff5f5;
        color: #b52e37;
        font-size: 13px;
    }

    .product-form-note {
        display: flex;
        align-items: flex-start;
        gap: 10px;
        margin: 22px 25px 0;
        padding: 14px;
        border: 1px solid #e7e7e7;
        border-radius: 9px;
        background: #fafafa;
        color: #666;
        font-size: 12px;
        line-height: 1.6;
    }

    .product-form-note i {
        color: #444;
        font-size: 16px;
    }

    .product-form-actions {
        display: flex;
        justify-content: flex-end;
        gap: 10px;
        padding: 22px 25px;
    }

    .product-form-actions .btn {
        min-height: 42px;
        padding: 10px 17px;
        border-radius: 9px;
        font-size: 13px;
        font-weight: 600;
    }

    .product-form-actions .btn-dark {
        background: #111;
        border-color: #111;
    }

    .product-form-actions .btn-dark:hover {
        background: #303030;
        border-color: #303030;
    }

    @@media (max-width: 767px) {
        .product-page-header {
            align-items: flex-start;
            flex-direction: column;
        }

        .product-page-heading h1 {
            font-size: 23px;
        }

        .product-page-header > .btn {
            width: 100%;
        }

        .product-form-card-header {
            align-items: flex-start;
            flex-direction: column;
        }

        .product-form-section {
            padding: 20px;
        }

        .product-form-note {
            margin: 18px 20px 0;
        }

        .product-form-actions {
            flex-direction: column-reverse;
            padding: 20px;
        }

        .product-form-actions .btn {
            width: 100%;
        }
    }
</style>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
