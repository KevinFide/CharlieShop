@model List<CharlieShop.Models.Producto>

@{
    ViewData["Title"] = "Productos";

    var busqueda = ViewBag.Busqueda as string;
    var categoria = ViewBag.Categoria as string;
}

<div class="d-flex justify-content-between align-items-start mb-3">

    <div>

        <div class="page-title">
            Productos
        </div>

        <div class="page-subtitle">
            Gestión de productos, precios y existencias.
        </div>

    </div>

    <div class="d-flex gap-2">
        <a asp-action="Detalle"
           class="btn btn-outline-primary">

            <i class="bi bi-eye me-1"></i>
            Ver detalle

        </a>

        <button class="btn btn-primary">

            <i class="bi bi-plus-lg me-1"></i>
            Nuevo producto

        </button>

    </div>

</div>


<div class="card p-4">

    <form asp-action="Index"
          method="get">

        <div class="row g-3 mb-3">

            <div class="col-md-5">

                <div class="input-group">

                    <input type="text"
                           name="busqueda"
                           value="@busqueda"
                           class="form-control"
                           placeholder="Buscar producto..." />

                    <button type="submit"
                            class="btn btn-outline-primary">

                        <i class="bi bi-search"></i>

                    </button>

                </div>

            </div>


            <div class="col-md-3">

                <select name="categoria"
                        class="form-select"
                        onchange="this.form.submit()">

                    <option value=""
                            selected="@(string.IsNullOrEmpty(categoria))">

                        Todas las categorías

                    </option>

                    <option value="Camisas"
                            selected="@(categoria == "Camisas")">

                        Camisas

                    </option>

                    <option value="Camisetas"
                            selected="@(categoria == "Camisetas")">

                        Camisetas

                    </option>

                    <option value="Pantalones"
                            selected="@(categoria == "Pantalones")">

                        Pantalones

                    </option>

                    <option value="Jackets"
                            selected="@(categoria == "Jackets")">

                        Jackets

                    </option>

                    <option value="Sudaderas"
                            selected="@(categoria == "Sudaderas")">

                        Sudaderas

                    </option>

                    <option value="Vestidos"
                            selected="@(categoria == "Vestidos")">

                        Vestidos

                    </option>

                    <option value="Accesorios"
                            selected="@(categoria == "Accesorios")">

                        Accesorios

                    </option>

                    <option value="Perfumes"
                            selected="@(categoria == "Perfumes")">

                        Perfumes

                    </option>

                </select>

            </div>

        </div>

    </form>


    <div class="table-responsive">

        <table class="table table-hover align-middle">

            <thead>

                <tr>

                    <th>Código</th>
                    <th>Producto</th>
                    <th>Categoría</th>
                    <th>Precio</th>
                    <th>Stock</th>
                    <th>Acciones</th>

                </tr>

            </thead>


            <tbody>

                @if (Model != null && Model.Any())
                {
                    foreach (var producto in Model)
                    {
                        <tr>

                            <td>
                                @producto.Codigo
                            </td>


                            <td>

                                <a asp-action="Detalle"
                                   class="fw-semibold text-decoration-none">

                                    @producto.Nombre

                                </a>

                            </td>


                            <td>
                                @producto.Categoria
                            </td>


                            <td>
                                ₡@producto.PrecioVenta.ToString("N0")
                            </td>


                            <td>

                                @{
                                    var stockClase =
                                        producto.StockActual <= producto.StockMinimo
                                            ? "bg-danger"
                                            : "bg-success";
                                }

                                <span class="badge @stockClase">

                                    @producto.StockActual.ToString("N0")

                                </span>

                            </td>


                            <td>

                                <button class="btn btn-sm btn-outline-primary">

                                    <i class="bi bi-pencil"></i>

                                </button>

                                <button class="btn btn-sm btn-outline-danger">

                                    <i class="bi bi-trash"></i>

                                </button>

                            </td>

                        </tr>
                    }
                }
                else
                {
                    <tr>

                        <td colspan="6"
                            class="text-center text-secondary py-4">

                            No se encontraron productos.

                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>