@model CharlieShop.Models.Producto

@{
    ViewData["Title"] = "Eliminar producto";
}

<div class="container mt-4">

    <h2>Eliminar producto</h2>

    <div class="alert alert-warning">
        ¿Está seguro de que desea eliminar este producto?
    </div>

    <dl class="row">
        <dt class="col-sm-3">Código</dt>
        <dd class="col-sm-9">@Model.Codigo</dd>

        <dt class="col-sm-3">Nombre</dt>
        <dd class="col-sm-9">@Model.Nombre</dd>
    </dl>

    <form asp-action="EliminarConfirmado" method="post">

        <input type="hidden" name="id" value="@Model.IdProducto" />

        <button type="submit" class="btn btn-danger">
            Sí, eliminar
        </button>

        <a asp-action="Index" class="btn btn-secondary">
            Cancelar
        </a>

    </form>

</div>