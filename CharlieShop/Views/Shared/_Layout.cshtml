<!DOCTYPE html>
<html lang="es">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        Charlie Shop - @ViewData["Title"]
    </title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

    <link rel="stylesheet"
          href="~/css/site.css" />

</head>

<body>

    <!-- MENÚ LATERAL -->

    <aside class="sidebar">

        <div class="brand mb-4">

            Charlie Shop

            <small>
                Sistema Integral de Gestión Comercial
            </small>

        </div>

        <nav>

            <a class="nav-link"
               asp-controller="Dashboard"
               asp-action="Index">

                <i class="bi bi-grid-1x2-fill me-2"></i>

                Dashboard

            </a>

            <a class="nav-link"
               asp-controller="Usuarios"
               asp-action="Index">

                <i class="bi bi-people me-2"></i>

                Usuarios

            </a>

            <a class="nav-link"
               asp-controller="Productos"
               asp-action="Index">

                <i class="bi bi-box-seam me-2"></i>

                Productos

            </a>

            <a class="nav-link"
               asp-controller="Inventario"
               asp-action="Index">

                <i class="bi bi-clipboard-data me-2"></i>

                Inventario

            </a>

            <a class="nav-link"
               asp-controller="Ventas"
               asp-action="Index">

                <i class="bi bi-cart3 me-2"></i>

                Ventas

            </a>

            <a class="nav-link"
               asp-controller="Clientes"
               asp-action="Index">

                <i class="bi bi-person-vcard me-2"></i>

                Clientes

            </a>

            <a class="nav-link"
               asp-controller="CuentasPorCobrar"
               asp-action="Index">

                <i class="bi bi-cash-stack me-2"></i>

                Cuentas por cobrar

            </a>

            <a class="nav-link"
               asp-controller="Reportes"
               asp-action="Index">

                <i class="bi bi-bar-chart-line me-2"></i>

                Reportes

            </a>

            <a class="nav-link"
               asp-controller="Asistente"
               asp-action="Index">

                <i class="bi bi-robot me-2"></i>

                Asistente virtual

                <span class="badge rounded-pill bg-primary ms-auto">IA</span>

            </a>

        </nav>

        <hr />

        <a class="nav-link"
           asp-controller="Home"
           asp-action="Index">

            <i class="bi bi-box-arrow-left me-2"></i>

            Cerrar sesión

        </a>

    </aside>


    <!-- CONTENIDO PRINCIPAL -->

    <main class="main">

        <!-- BARRA SUPERIOR -->

        <header class="topbar">

            <div class="fw-semibold">

                @ViewData["Title"]

            </div>

            <div class="d-flex align-items-center gap-3">

                <a asp-controller="Asistente" asp-action="Index" class="topbar-action" title="Abrir asistente virtual">
                    <i class="bi bi-robot"></i>
                </a>

                <a asp-controller="Usuarios" asp-action="CambiarContrasena" class="topbar-user">
                    <span class="text-secondary small">
                        Administrador
                    </span>
                    <i class="bi bi-person-circle fs-4"></i>
                </a>

            </div>

        </header>


        <!-- CONTENIDO DE CADA VISTA -->

        <section class="content">

            @RenderBody()

        </section>

    </main>


    @if (!Equals(ViewData["HideChatbotFab"], true))
    {
        <a asp-controller="Asistente" asp-action="Index" class="chatbot-fab" title="Hablar con Charlie">
            <i class="bi bi-chat-dots-fill"></i>
            <span>Pregúntale a Charlie</span>
        </a>
    }

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
    </script>

    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>