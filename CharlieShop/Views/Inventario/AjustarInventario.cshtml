
@model CharlieShop.Models.AjustarInventarioViewModel

@{
    ViewData["Title"] = "Ajustar inventario";
}

<div class="inventory-form-page">
    <div class="page-header">
        <div class="page-heading">
            <div class="page-icon">
                <i class="bi bi-sliders"></i>
            </div>
            <div>
                <h1>Ajustar inventario</h1>
                <p>Registra entradas o salidas por ajustes de existencias.</p>
            </div>
        </div>

        <a asp-action="Index" class="btn btn-outline-dark">
            <i class="bi bi-arrow-left me-1"></i> Volver al inventario
        </a>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger" role="alert">
            @TempData["Error"]
        </div>
    }

    <div class="form-card">
        <div class="form-card-header">
            <div>
                <h2>Información del ajuste</h2>
                <p>Seleccioná el producto y la operación que necesitás realizar.</p>
            </div>
            <span class="form-tag">
                <i class="bi bi-arrow-left-right me-1"></i> Ajuste de stock
            </span>
        </div>

        <form asp-action="AjustarInventario" method="post">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly"
                 class="validation-summary"></div>

            <div class="form-section">
                <h3>Producto y operación</h3>

                <div class="row g-4">
                    <div class="col-md-7">
                        <label asp-for="IdProducto" class="form-label">
                            Producto <span class="required">*</span>
                        </label>

                        <select asp-for="IdProducto"
                                class="form-select"
                                required>
                            <option value="">Seleccioná un producto</option>

                            @if (Model.Productos != null)
                            {
                                foreach (var producto in Model.Productos)
                                {
                                    <option value="@producto.IdProducto">
                                        @producto.Codigo - @producto.Nombre
                                    </option>
                                }
                            }
                        </select>

                        <span asp-validation-for="IdProducto"
                              class="field-error"></span>
                    </div>

                    <div class="col-md-5">
                        <label asp-for="Direccion" class="form-label">
                            Tipo de ajuste <span class="required">*</span>
                        </label>

                        <select asp-for="Direccion"
                                class="form-select"
                                required>
                            <option value="">Seleccioná una operación</option>
                            <option value="ENTRADA">Agregar existencias</option>
                            <option value="SALIDA">Retirar existencias</option>
                        </select>

                        <span asp-validation-for="Direccion"
                              class="field-error"></span>
                    </div>

                    <div class="col-md-5">
                        <label asp-for="Cantidad" class="form-label">
                            Cantidad <span class="required">*</span>
                        </label>

                        <div class="input-group">
                            <input asp-for="Cantidad"
                                   type="number"
                                   class="form-control"
                                   min="0.01"
                                   step="0.01"
                                   placeholder="0.00"
                                   required />
                            <span class="input-group-text">Unidades</span>
                        </div>

                        <span asp-validation-for="Cantidad"
                              class="field-error"></span>
                    </div>
                </div>
            </div>

            <div class="form-section">
                <h3>Información adicional</h3>

                <div class="row g-4">
                    <div class="col-md-6">
                        <label asp-for="Referencia" class="form-label">
                            Referencia
                        </label>

                        <input asp-for="Referencia"
                               class="form-control"
                               maxlength="100"
                               placeholder="Ej. Corrección de existencias" />

                        <span asp-validation-for="Referencia"
                              class="field-error"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Observaciones" class="form-label">
                            Observaciones
                        </label>

                        <textarea asp-for="Observaciones"
                                  class="form-control"
                                  rows="3"
                                  placeholder="Motivo del ajuste"></textarea>

                        <span asp-validation-for="Observaciones"
                              class="field-error"></span>
                    </div>
                </div>
            </div>

            <div class="form-note">
                <i class="bi bi-info-circle"></i>
                <span>
                    Las salidas no pueden superar las existencias disponibles.
                    Cada ajuste se registrará en el historial de movimientos.
                </span>
            </div>

            <div class="form-actions">
                <a asp-action="Index" class="btn btn-light">
                    Cancelar
                </a>
                <button type="submit" class="btn btn-dark">
                    <i class="bi bi-check-lg me-1"></i>
                    Guardar ajuste
                </button>
            </div>
        </form>
    </div>
</div>

<style>
    .inventory-form-page {
        max-width: 1100px;
        margin: 0 auto;
    }

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        margin-bottom: 28px;
    }

    .page-heading {
        display: flex;
        align-items: center;
        gap: 15px;
    }

    .page-icon {
        width: 49px;
        height: 49px;
        display: flex;
        flex-shrink: 0;
        align-items: center;
        justify-content: center;
        border-radius: 12px;
        background: #111;
        color: white;
        font-size: 21px;
    }

    .page-heading h1 {
        margin: 0;
        font-size: 25px;
        font-weight: 700;
        color: #111;
    }

    .page-heading p {
        margin: 5px 0 0;
        color: #777;
        font-size: 14px;
    }

    .page-header > .btn {
        padding: 10px 14px;
        border-radius: 9px;
        font-size: 13px;
    }

    .form-card {
        overflow: hidden;
        background: #fff;
        border: 1px solid #e8e8e8;
        border-radius: 15px;
        box-shadow: 0 3px 14px rgba(0, 0, 0, .025);
    }

    .form-card-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 15px;
        padding: 25px;
        border-bottom: 1px solid #eee;
    }

    .form-card-header h2 {
        margin: 0;
        font-size: 17px;
        font-weight: 700;
        color: #171717;
    }

    .form-card-header p {
        margin: 5px 0 0;
        font-size: 13px;
        color: #858585;
    }

    .form-tag {
        padding: 8px 11px;
        border-radius: 8px;
        background: #f0f0f0;
        color: #333;
        font-size: 12px;
        font-weight: 600;
        white-space: nowrap;
    }

    .form-section {
        padding: 25px;
        border-bottom: 1px solid #eee;
    }

    .form-section h3 {
        margin: 0 0 22px;
        font-size: 14px;
        font-weight: 700;
        color: #222;
    }

    .form-label {
        margin-bottom: 8px;
        color: #444;
        font-size: 13px;
        font-weight: 600;
    }

    .required {
        color: #c83c43;
    }

    .form-control,
    .form-select,
    .input-group-text {
        min-height: 44px;
        border-color: #dedede;
        border-radius: 9px;
        font-size: 13px;
        box-shadow: none;
    }

    .input-group .form-control {
        border-radius: 9px 0 0 9px;
    }

    .input-group-text {
        display: flex;
        align-items: center;
        border-radius: 0 9px 9px 0;
        background: #f8f8f8;
        color: #666;
    }

    textarea.form-control {
        min-height: 95px;
    }

    .form-control:focus,
    .form-select:focus {
        border-color: #777;
        box-shadow: 0 0 0 3px rgba(0, 0, 0, .05);
    }

    .field-error {
        display: block;
        margin-top: 6px;
        color: #c83c43;
        font-size: 12px;
    }

    .validation-summary:empty {
        display: none;
    }

    .validation-summary:not(:empty) {
        margin: 20px 25px 0;
        padding: 12px;
        border-radius: 8px;
        background: #fff0f0;
        color: #b52e37;
        font-size: 13px;
    }

    .form-note {
        display: flex;
        align-items: flex-start;
        gap: 10px;
        margin: 22px 25px 0;
        padding: 14px;
        border: 1px solid #e7e7e7;
        border-radius: 9px;
        background: #fafafa;
        color: #666;
        font-size: 12px;
        line-height: 1.6;
    }

    .form-note i {
        color: #444;
        font-size: 16px;
    }

    .form-actions {
        display: flex;
        justify-content: flex-end;
        gap: 10px;
        padding: 22px 25px;
    }

    .form-actions .btn {
        min-height: 42px;
        padding: 10px 17px;
        border-radius: 9px;
        font-size: 13px;
        font-weight: 600;
    }

    .form-actions .btn-dark {
        background: #111;
        border-color: #111;
    }

    @@media (max-width: 767px) {
        .page-header {
            align-items: flex-start;
            flex-direction: column;
        }

        .form-card-header {
            align-items: flex-start;
            flex-direction: column;
        }

        .form-section {
            padding: 20px;
        }

        .form-actions {
            flex-direction: column-reverse;
            padding: 20px;
        }

        .form-actions .btn {
            width: 100%;
        }
    }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
