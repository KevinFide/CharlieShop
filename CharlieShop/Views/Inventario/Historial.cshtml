
@model CharlieShop.Models.HistorialInventarioViewModel

@using System.Globalization

@{
    ViewData["Title"] = "Historial de inventario";

    var movimientos = Model.Movimientos
        ?? new List<CharlieShop.Models.MovimientoInventarioViewModel>();

    var inicio = Model.TotalRegistros == 0
        ? 0
        : ((Model.Pagina - 1) * Model.TamanoPagina) + 1;

    var fin = Math.Min(
        Model.Pagina * Model.TamanoPagina,
        Model.TotalRegistros);
}

<div class="inventory-page">

    <!-- ENCABEZADO -->
    <div class="page-header">
        <div class="page-header-left">
            <div class="page-icon">
                <i class="bi bi-clock-history"></i>
            </div>

            <div>
                <h1>Historial de inventario</h1>
                <p>Consulta los movimientos registrados en el inventario.</p>
            </div>
        </div>

        <a asp-action="Index" class="btn btn-outline-dark">
            <i class="bi bi-arrow-left me-1"></i>
            Volver al inventario
        </a>
    </div>

    <!-- RESUMEN REAL -->
    <div class="row g-3 mb-4">

        <div class="col-xl-4 col-md-4">
            <div class="summary-card">
                <div>
                    <span class="summary-label">Movimientos encontrados</span>
                    <div class="summary-value">@Model.TotalRegistros</div>
                    <span class="summary-description">
                        Según los filtros aplicados
                    </span>
                </div>
                <div class="summary-icon">
                    <i class="bi bi-arrow-left-right"></i>
                </div>
            </div>
        </div>

        <div class="col-xl-4 col-md-4">
            <div class="summary-card">
                <div>
                    <span class="summary-label">Página actual</span>
                    <div class="summary-value summary-green">
                        @Model.Pagina
                    </div>
                    <span class="summary-description">
                        De @Model.TotalPaginas página(s)
                    </span>
                </div>
                <div class="summary-icon entry-icon">
                    <i class="bi bi-files"></i>
                </div>
            </div>
        </div>

        <div class="col-xl-4 col-md-4">
            <div class="summary-card">
                <div>
                    <span class="summary-label">Registros mostrados</span>
                    <div class="summary-value">@movimientos.Count</div>
                    <span class="summary-description">
                        En esta página
                    </span>
                </div>
                <div class="summary-icon adjustment-icon">
                    <i class="bi bi-list-check"></i>
                </div>
            </div>
        </div>

    </div>

    <!-- HISTORIAL -->
    <div class="content-card">

        <div class="section-header">
            <div class="section-heading">
                <div class="section-icon">
                    <i class="bi bi-list-ul"></i>
                </div>
                <div>
                    <h2>Movimientos registrados</h2>
                    <p>Filtra las operaciones por producto, tipo y fecha.</p>
                </div>
            </div>
        </div>

        <!-- FILTROS -->
        <div class="filters-panel">
            <form asp-action="Historial" method="get">
                <div class="row g-3">

                    <div class="col-lg-4 col-md-6">
                        <label for="IdProducto" class="filter-label">
                            Producto
                        </label>

                        <select id="IdProducto"
                                name="idProducto"
                                class="form-select">
                            <option value="">Todos los productos</option>

                            @foreach (var producto in Model.Productos)
                            {
                                if (Model.IdProducto == producto.IdProducto)
                                {
                                    <option value="@producto.IdProducto" selected>
                                        @producto.Codigo - @producto.Nombre
                                    </option>
                                }
                                else
                                {
                                    <option value="@producto.IdProducto">
                                        @producto.Codigo - @producto.Nombre
                                    </option>
                                }
                            }
                        </select>
                    </div>

                    <div class="col-lg-3 col-md-6">
                        <label for="TipoMovimiento" class="filter-label">
                            Tipo de movimiento
                        </label>

                        <select id="TipoMovimiento"
                                name="tipoMovimiento"
                                class="form-select">
                            @if (Model.TipoMovimiento == "TODOS")
                            {
                                <option value="TODOS" selected>
                                    Todos los movimientos
                                </option>
                            }
                            else
                            {
                                <option value="TODOS">
                                    Todos los movimientos
                                </option>
                            }

                            @if (Model.TipoMovimiento == "ENTRADA")
                            {
                                <option value="ENTRADA" selected>Entradas</option>
                            }
                            else
                            {
                                <option value="ENTRADA">Entradas</option>
                            }

                            @if (Model.TipoMovimiento == "SALIDA")
                            {
                                <option value="SALIDA" selected>Salidas</option>
                            }
                            else
                            {
                                <option value="SALIDA">Salidas</option>
                            }

                            @if (Model.TipoMovimiento == "AJUSTE")
                            {
                                <option value="AJUSTE" selected>Ajustes</option>
                            }
                            else
                            {
                                <option value="AJUSTE">Ajustes</option>
                            }
                        </select>
                    </div>

                    <div class="col-lg-2 col-md-6">
                        <label for="FechaDesde" class="filter-label">
                            Desde
                        </label>

                        <input id="FechaDesde"
                               name="fechaDesde"
                               type="date"
                               class="form-control"
                               value="@Model.FechaDesde?.ToString("yyyy-MM-dd")" />
                    </div>

                    <div class="col-lg-2 col-md-6">
                        <label for="FechaHasta" class="filter-label">
                            Hasta
                        </label>

                        <input id="FechaHasta"
                               name="fechaHasta"
                               type="date"
                               class="form-control"
                               value="@Model.FechaHasta?.ToString("yyyy-MM-dd")" />
                    </div>

                    <div class="col-lg-1 d-flex align-items-end">
                        <input type="hidden" name="pagina" value="1" />
                        <input type="hidden" name="tamanoPagina"
                               value="@Model.TamanoPagina" />

                        <button type="submit"
                                class="btn btn-dark filter-submit"
                                title="Filtrar"
                                aria-label="Filtrar movimientos">
                            <i class="bi bi-search"></i>
                        </button>
                    </div>

                </div>

                <div class="filter-actions">
                    <a asp-action="Historial"
                       class="btn btn-filter-reset">
                        <i class="bi bi-arrow-counterclockwise me-1"></i>
                        Limpiar filtros
                    </a>
                </div>
            </form>
        </div>

        <!-- TABLA -->
        <div class="table-responsive">
            <table class="table inventory-table align-middle mb-0">
                <thead>
                    <tr>
                        <th>Referencia</th>
                        <th>Fecha y hora</th>
                        <th>Producto</th>
                        <th>Tipo</th>
                        <th>Cantidad</th>
                        <th>Motivo / observaciones</th>
                        <th>Usuario</th>
                    </tr>
                </thead>

                <tbody>
                    @if (movimientos.Any())
                    {
                        foreach (var movimiento in movimientos)
                        {
                            var tipo = (movimiento.TipoMovimiento ?? "")
                                .ToUpperInvariant();

                            var claseTipo = tipo switch
                            {
                                "ENTRADA" => "badge-entry",
                                "SALIDA" => "badge-exit",
                                _ => "badge-adjustment"
                            };

                            var iconoTipo = tipo switch
                            {
                                "ENTRADA" => "bi-arrow-down-left",
                                "SALIDA" => "bi-arrow-up-right",
                                _ => "bi-sliders"
                            };

                            var claseCantidad = tipo == "ENTRADA"
                                ? "quantity-positive"
                                : tipo == "SALIDA"
                                    ? "quantity-negative"
                                    : "quantity-adjustment";

                            var textoTipo = tipo switch
                            {
                                "ENTRADA" => "Entrada",
                                "SALIDA" => "Salida",
                                "AJUSTE" => "Ajuste",
                                _ => tipo
                            };

                            <tr>
                                <td>
                                    <span class="movement-reference">
                                        @(string.IsNullOrWhiteSpace(movimiento.Referencia)
                                            ? $"MOV-{movimiento.IdMovimiento}"
                                            : movimiento.Referencia)
                                    </span>
                                    <span class="reference-id">
                                        #@movimiento.IdMovimiento
                                    </span>
                                </td>

                                <td>
                                    <span class="date-main">
                                        @movimiento.Fecha.ToString(
                                            "dd/MM/yyyy",
                                            CultureInfo.GetCultureInfo("es-CR"))
                                    </span>
                                    <span class="date-sub">
                                        @movimiento.Fecha.ToString("HH:mm")
                                    </span>
                                </td>

                                <td>
                                    <div class="product-cell">
                                        <div class="table-product-icon">
                                            <i class="bi bi-box-seam"></i>
                                        </div>
                                        <div>
                                            <div class="product-name">
                                                @movimiento.NombreProducto
                                            </div>
                                            <div class="product-code">
                                                @movimiento.Codigo
                                            </div>
                                        </div>
                                    </div>
                                </td>

                                <td>
                                    <span class="movement-badge @claseTipo">
                                        <i class="bi @iconoTipo"></i>
                                        @textoTipo
                                    </span>
                                    @if (tipo == "AJUSTE" &&
                                         !string.IsNullOrWhiteSpace(movimiento.Observaciones) &&
                                         movimiento.Observaciones.StartsWith("Dirección: SALIDA"))
                                    {
                                        <span class="direction-label">Salida</span>
                                    }
                                    else if (tipo == "AJUSTE" &&
                                             !string.IsNullOrWhiteSpace(movimiento.Observaciones) &&
                                             movimiento.Observaciones.StartsWith("Dirección: ENTRADA"))
                                    {
                                        <span class="direction-label">Entrada</span>
                                    }
                                </td>

                                <td>
                                    <span class="@claseCantidad">
                                        @movimiento.Cantidad.ToString("0.##")
                                    </span>
                                </td>

                                <td>
                                    @(string.IsNullOrWhiteSpace(movimiento.Observaciones)
                                        ? "Sin observaciones"
                                        : movimiento.Observaciones)
                                </td>

                                <td>
                                    @(string.IsNullOrWhiteSpace(movimiento.NombreUsuario)
                                        ? $"Usuario #{movimiento.IdUsuario}"
                                        : movimiento.NombreUsuario)
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7">
                                <div class="empty-state">
                                    <div class="empty-icon">
                                        <i class="bi bi-inbox"></i>
                                    </div>
                                    <h3>No se encontraron movimientos</h3>
                                    <p>
                                        No hay movimientos registrados que coincidan
                                        con los filtros seleccionados.
                                    </p>
                                    <a asp-action="Historial"
                                       class="btn btn-outline-dark mt-3">
                                        Limpiar filtros
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- PAGINACIÓN DEL SERVIDOR -->
        <div class="inventory-pagination">
            <span class="pagination-info">
                Mostrando @inicio–@fin de @Model.TotalRegistros movimiento(s)
            </span>

            <nav aria-label="Paginación de movimientos">
                <ul class="pagination pagination-sm mb-0">

                    <li class="page-item @(!Model.TienePaginaAnterior ? "disabled" : "")">
                        <a class="page-link"
                           asp-action="Historial"
                           asp-route-idProducto="@Model.IdProducto"
                           asp-route-tipoMovimiento="@Model.TipoMovimiento"
                           asp-route-fechaDesde="@Model.FechaDesde?.ToString("yyyy-MM-dd")"
                           asp-route-fechaHasta="@Model.FechaHasta?.ToString("yyyy-MM-dd")"
                           asp-route-pagina="@(Model.Pagina - 1)"
                           asp-route-tamanoPagina="@Model.TamanoPagina"
                           aria-label="Página anterior">
                            <i class="bi bi-chevron-left"></i>
                        </a>
                    </li>

                    @if (Model.TotalPaginas > 0)
                    {
                        for (var pagina = 1; pagina <= Model.TotalPaginas; pagina++)
                        {
                            <li class="page-item @(pagina == Model.Pagina ? "active" : "")">
                                <a class="page-link"
                                   asp-action="Historial"
                                   asp-route-idProducto="@Model.IdProducto"
                                   asp-route-tipoMovimiento="@Model.TipoMovimiento"
                                   asp-route-fechaDesde="@Model.FechaDesde?.ToString("yyyy-MM-dd")"
                                   asp-route-fechaHasta="@Model.FechaHasta?.ToString("yyyy-MM-dd")"
                                   asp-route-pagina="@pagina"
                                   asp-route-tamanoPagina="@Model.TamanoPagina">
                                    @pagina
                                </a>
                            </li>
                        }
                    }

                    <li class="page-item @(!Model.TienePaginaSiguiente ? "disabled" : "")">
                        <a class="page-link"
                           asp-action="Historial"
                           asp-route-idProducto="@Model.IdProducto"
                           asp-route-tipoMovimiento="@Model.TipoMovimiento"
                           asp-route-fechaDesde="@Model.FechaDesde?.ToString("yyyy-MM-dd")"
                           asp-route-fechaHasta="@Model.FechaHasta?.ToString("yyyy-MM-dd")"
                           asp-route-pagina="@(Model.Pagina + 1)"
                           asp-route-tamanoPagina="@Model.TamanoPagina"
                           aria-label="Página siguiente">
                            <i class="bi bi-chevron-right"></i>
                        </a>
                    </li>

                </ul>
            </nav>
        </div>

        <div class="table-footer">
            <span>
                <i class="bi bi-database me-1"></i>
                Datos obtenidos de PostgreSQL
            </span>
            <span>@Model.TamanoPagina movimientos por página</span>
        </div>

    </div>
</div>

<style>
    .inventory-page {
        max-width: 1450px;
        margin: 0 auto;
    }

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        margin-bottom: 28px;
    }

    .page-header-left, .section-heading {
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .page-icon {
        width: 49px;
        height: 49px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 12px;
        background: #111;
        color: #fff;
        font-size: 22px;
    }

    .page-header h1 {
        margin: 0;
        color: #111;
        font-size: 26px;
        font-weight: 700;
    }

    .page-header p, .section-heading p {
        margin: 5px 0 0;
        color: #777;
        font-size: 14px;
    }

    .page-header > .btn {
        border-radius: 9px;
        padding: 10px 15px;
        white-space: nowrap;
    }

    .summary-card {
        height: 100%;
        min-height: 128px;
        padding: 21px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        background: #fff;
        border: 1px solid #e8e8e8;
        border-radius: 14px;
        box-shadow: 0 3px 12px rgba(0,0,0,.025);
    }

    .summary-label {
        display: block;
        color: #666;
        font-size: 13px;
    }

    .summary-value {
        margin: 7px 0 3px;
        color: #111;
        font-size: 29px;
        font-weight: 700;
    }

    .summary-green { color: #23834b; }

    .summary-description {
        color: #929292;
        font-size: 12px;
    }

    .summary-icon {
        width: 46px;
        height: 46px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #f1f1f1;
        border-radius: 12px;
        color: #333;
        font-size: 21px;
    }

    .entry-icon {
        background: #eaf7ef;
        color: #23834b;
    }

    .adjustment-icon {
        background: #f0efff;
        color: #6554a4;
    }

    .content-card {
        overflow: hidden;
        background: #fff;
        border: 1px solid #e8e8e8;
        border-radius: 15px;
        box-shadow: 0 3px 14px rgba(0,0,0,.025);
    }

    .section-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 16px;
        padding: 24px 25px;
    }

    .section-icon {
        width: 42px;
        height: 42px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #f2f2f2;
        border-radius: 11px;
        color: #222;
        font-size: 19px;
    }

    .section-heading h2 {
        margin: 0;
        color: #171717;
        font-size: 17px;
        font-weight: 700;
    }

    .section-heading p { font-size: 13px; }

    .filters-panel { padding: 0 25px 22px; }

    .filter-label {
        display: block;
        margin-bottom: 8px;
        color: #333;
        font-size: 13px;
        font-weight: 600;
    }

    .form-control, .form-select {
        min-height: 43px;
        border-color: #dedede;
        border-radius: 9px;
        font-size: 13px;
        box-shadow: none;
    }

    .form-control:focus, .form-select:focus {
        border-color: #777;
        box-shadow: 0 0 0 3px rgba(0,0,0,.055);
    }

    .filter-submit {
        min-height: 43px;
        width: 100%;
        border-radius: 9px;
        background: #111;
    }

    .filter-actions {
        display: flex;
        justify-content: flex-end;
        margin-top: 14px;
    }

    .btn-filter-reset {
        border: 1px solid #ddd;
        border-radius: 9px;
        padding: 9px 13px;
        color: #444;
        background: #fff;
        font-size: 12px;
        text-decoration: none;
    }

    .btn-filter-reset:hover {
        background: #f5f5f5;
        color: #111;
    }

    .inventory-table { min-width: 1000px; }

    .inventory-table thead th {
        padding: 14px 16px;
        background: #f8f8f8;
        border-top: 1px solid #eee;
        border-bottom: 1px solid #e9e9e9;
        color: #666;
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .35px;
        white-space: nowrap;
    }

    .inventory-table tbody td {
        padding: 16px;
        border-bottom: 1px solid #f0f0f0;
        color: #444;
        font-size: 13px;
        vertical-align: middle;
    }

    .inventory-table tbody tr:last-child td { border-bottom: none; }
    .inventory-table tbody tr:hover { background: #fafafa; }

    .movement-reference {
        display: block;
        color: #333;
        font-weight: 700;
        overflow-wrap: anywhere;
    }

    .reference-id {
        display: block;
        margin-top: 4px;
        color: #999;
        font-size: 11px;
    }

    .date-main, .date-sub { display: block; white-space: nowrap; }
    .date-main { color: #333; font-weight: 500; }
    .date-sub { margin-top: 3px; color: #888; font-size: 12px; }

    .product-cell {
        display: flex;
        align-items: center;
        gap: 10px;
        min-width: 165px;
    }

    .table-product-icon {
        width: 37px;
        height: 37px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #f1f1f1;
        border-radius: 9px;
        color: #444;
        font-size: 17px;
    }

    .product-name { color: #222; font-weight: 600; }
    .product-code { margin-top: 3px; color: #888; font-size: 11px; }

    .movement-badge {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 6px 9px;
        border-radius: 7px;
        font-size: 11px;
        font-weight: 600;
        white-space: nowrap;
    }

    .badge-entry { background: #eaf7ef; color: #237b46; }
    .badge-exit { background: #fff0f0; color: #b52e37; }
    .badge-adjustment { background: #f0efff; color: #6554a4; }

    .direction-label {
        display: block;
        margin-top: 5px;
        color: #777;
        font-size: 11px;
    }

    .quantity-positive, .quantity-negative, .quantity-adjustment {
        font-size: 14px;
        font-weight: 700;
        white-space: nowrap;
    }

    .quantity-positive { color: #23834b; }
    .quantity-negative { color: #c03940; }
    .quantity-adjustment { color: #6554a4; }

    .inventory-pagination {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 16px;
        padding: 17px 22px;
        border-top: 1px solid #eee;
        background: #fcfcfc;
    }

    .pagination-info { color: #777; font-size: 12px; }

    .inventory-pagination .pagination {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 4px;
    }

    .inventory-pagination .page-link {
        min-width: 34px;
        height: 34px;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 1px solid #e1e1e1;
        border-radius: 8px !important;
        background: #fff;
        color: #444;
        font-size: 12px;
        box-shadow: none;
    }

    .inventory-pagination .page-link:hover {
        background: #f0f0f0;
        color: #111;
    }

    .inventory-pagination .page-item.active .page-link {
        border-color: #111;
        background: #111;
        color: #fff;
    }

    .inventory-pagination .page-item.disabled .page-link {
        background: #f7f7f7;
        color: #bbb;
        pointer-events: none;
    }

    .empty-state { padding: 45px 20px; text-align: center; }

    .empty-icon {
        width: 55px;
        height: 55px;
        margin: 0 auto 15px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #f4f4f4;
        border-radius: 15px;
        color: #777;
        font-size: 24px;
    }

    .empty-state h3 {
        color: #222;
        font-size: 16px;
        font-weight: 700;
    }

    .empty-state p {
        margin-bottom: 0;
        color: #888;
        font-size: 13px;
    }

    .table-footer {
        display: flex;
        justify-content: space-between;
        gap: 12px;
        padding: 15px 20px;
        background: #fcfcfc;
        border-top: 1px solid #eee;
        color: #888;
        font-size: 12px;
    }

    @@media (max-width: 767px) {
        .page-header {
            align-items: flex-start;
            flex-direction: column;
        }

        .page-header h1 { font-size: 22px; }
        .section-header { padding: 20px; }
        .filters-panel { padding: 0 20px 20px; }
        .inventory-pagination, .table-footer {
            align-items: flex-start;
            flex-direction: column;
        }
    }
</style>
