@section Scripts {
    <script>
        (() => {
            const deleteModalElement = document.getElementById('deleteProductModal');
            const deleteModal = bootstrap.Modal.getOrCreateInstance(deleteModalElement);
            const deleteForm = document.getElementById('deleteProductForm');
            const deleteButton = document.getElementById('confirmDeleteProduct');
            const resultModalElement = document.getElementById('deleteResultModal');
            if (resultModalElement) {
                bootstrap.Modal.getOrCreateInstance(resultModalElement).show();
            }

            document.querySelectorAll('.btn-delete-product').forEach(button => {
                button.addEventListener('click', () => {
                    document.getElementById('deleteProductId').value = button.dataset.productId;
                    document.getElementById('deleteProductName').textContent = button.dataset.productName;
                    document.getElementById('deleteProductNameInput').value = button.dataset.productName;
                    document.getElementById('deleteProductCode').textContent = `Código: ${button.dataset.productCode}`;
                    deleteModal.show();
                });
            });

            deleteForm.addEventListener('submit', () => {
                deleteButton.disabled = true;
                deleteButton.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Eliminando...';
            });

            const panelElement = document.getElementById('productEditorPanel');
            if (!panelElement || !window.bootstrap) return;

            const panel = bootstrap.Offcanvas.getOrCreateInstance(panelElement);
            const loading = document.getElementById('panelLoading');
            const content = document.getElementById('panelContent');
            const alertBox = document.getElementById('panelAlert');
            const movementAlert = document.getElementById('movementAlert');
            let currentProductState = false;
            let updatingState = false;

            const showAlert = (message, type = 'danger', target = alertBox) => {
                target.className = `alert alert-${type}`;
                target.textContent = message;
            };
            const clearAlert = (target = alertBox) => {
                target.className = 'alert d-none';
                target.textContent = '';
            };
            const antiforgery = form => form.querySelector('input[name="__RequestVerificationToken"]').value;

            async function readJsonResponse(response) {
                const raw = await response.text();

                if (!raw || !raw.trim()) {
                    throw new Error(`El servidor devolvió una respuesta vacía (HTTP ${response.status}).`);
                }

                try {
                    return JSON.parse(raw);
                } catch {
                    throw new Error(`El servidor no devolvió JSON válido (HTTP ${response.status}). Revisá la acción del controlador y la respuesta en Network.`);
                }
            }

            const currencyFormatter = new Intl.NumberFormat('es-CR', {
                minimumFractionDigits: 2,
                maximumFractionDigits: 2
            });

            function parseCurrency(value) {
                if (value === null || value === undefined || value === '') return 0;
                const normalized = String(value)
                    .replace(/[^0-9,.-]/g, '')
                    .replace(/\./g, '')
                    .replace(',', '.');
                const parsed = Number(normalized);
                return Number.isFinite(parsed) ? parsed : 0;
            }

            function setCurrencyField(displayId, hiddenId, value) {
                const numericValue = Number(value ?? 0);
                const safeValue = Number.isFinite(numericValue) ? numericValue : 0;
                document.getElementById(hiddenId).value = safeValue.toFixed(2).replace('.', ',');
                document.getElementById(displayId).value = currencyFormatter.format(safeValue);
            }

            function syncCurrencyFields() {
                const cost = parseCurrency(document.getElementById('editCostoDisplay').value);
                const salePrice = parseCurrency(document.getElementById('editPrecioVentaDisplay').value);
                document.getElementById('editCosto').value = cost.toFixed(2).replace('.', ',');
                document.getElementById('editPrecioVenta').value = salePrice.toFixed(2).replace('.', ',');
            }

            ['editCostoDisplay', 'editPrecioVentaDisplay'].forEach(id => {
                const input = document.getElementById(id);
                input.addEventListener('focus', () => {
                    const value = parseCurrency(input.value);
                    input.value = value ? String(value).replace('.', ',') : '';
                });
                input.addEventListener('blur', () => {
                    const hiddenId = id === 'editCostoDisplay' ? 'editCosto' : 'editPrecioVenta';
                    const value = parseCurrency(input.value);
                    document.getElementById(hiddenId).value = value.toFixed(2);
                    input.value = currencyFormatter.format(value);
                });
                input.addEventListener('input', () => {
                    const hiddenId = id === 'editCostoDisplay' ? 'editCosto' : 'editPrecioVenta';
                    document.getElementById(hiddenId).value = parseCurrency(input.value).toFixed(2);
                });
            });

            document.querySelectorAll('.btn-open-product').forEach(button => {
                button.addEventListener('click', async () => {
                    const id = button.dataset.productId;
                    clearAlert();
                    content.classList.add('d-none');
                    loading.classList.remove('d-none');
                    panel.show();
                    try {
                        const response = await fetch(`@Url.Action("ObtenerProducto", "Inventario")?id=${encodeURIComponent(id)}`);
                        const data = await readJsonResponse(response);
                        if (!response.ok || !data.success) throw new Error(data.message || 'No fue posible cargar el producto.');
                        const p = data.producto;

                        // Dapper puede serializar esta columna como IdProducto (PascalCase)
                        // o idProducto (camelCase), según la configuración JSON.
                        // Si no se contempla ambas variantes, el formulario envía "undefined".
                        // El DTO del controlador entrega propiedades camelCase.
                        // Se conservan fallbacks PascalCase para tolerar configuraciones JSON distintas.
                        const value = (camelName, pascalName = camelName) =>
                            p[camelName] ?? p[pascalName] ?? null;

                        const productId = value('idProducto', 'IdProducto') ?? id;
                        if (!productId || Number.isNaN(Number(productId))) {
                            throw new Error('El servidor no devolvió un identificador válido para el producto.');
                        }

                        const code = value('codigo', 'Codigo') ?? '';
                        const name = value('nombre', 'Nombre') ?? '';
                        const description = value('descripcion', 'Descripcion') ?? '';
                        const category = value('categoria', 'Categoria') ?? '';
                        const unit = value('unidadMedida', 'UnidadMedida') ?? '';
                        const cost = value('costo', 'Costo') ?? 0;
                        const salePrice = value('precioVenta', 'PrecioVenta') ?? 0;
                        const active = Boolean(value('estado', 'Estado'));
                        const stock = Number(value('stockActual', 'StockActual') ?? 0);

                        document.getElementById('editIdProducto').value = productId;
                        document.getElementById('movementIdProducto').value = productId;
                        document.getElementById('editCodigo').value = code;
                        document.getElementById('editNombre').value = name;
                        document.getElementById('editDescripcion').value = description;

                        const categorySelect = document.getElementById('editCategoria');
                        if (category && ![...categorySelect.options].some(option => option.value === category)) {
                            categorySelect.add(new Option(category, category));
                        }
                        categorySelect.value = category;

                        document.getElementById('editUnidadMedida').value = unit;
                        setCurrencyField('editCostoDisplay', 'editCosto', cost);
                        setCurrencyField('editPrecioVentaDisplay', 'editPrecioVenta', salePrice);
                        document.getElementById('editEstado').checked = active;
                        currentProductState = active;
                        document.getElementById('panelProductSubtitle').textContent = `${code} · ${name}`;

                        document.getElementById('movementCurrentStock').textContent = stock.toLocaleString('es-CR');
                        document.getElementById('movementUnitLabel').textContent = unit;

                        updateStateBadge();
                        document.getElementById('movementForm').reset();
                        document.getElementById('movementIdProducto').value = productId;
                        document.getElementById('movementType').value = 'ENTRADA';
                        clearAlert(movementAlert);
                        loading.classList.add('d-none');
                        content.classList.remove('d-none');
                    } catch (error) {
                        loading.classList.add('d-none');
                        showAlert(error.message);
                    }
                });
            });

            function updateStateBadge() {
                const badge = document.getElementById('panelStatusBadge');
                badge.textContent = currentProductState ? 'Activo' : 'Inactivo';
                badge.className = `badge rounded-pill ${currentProductState ? 'text-bg-success' : 'text-bg-secondary'}`;
            }

            document.getElementById('editEstado').addEventListener('change', async event => {
                if (updatingState) return;
                const desiredState = event.target.checked;
                const form = document.getElementById('editProductForm');
                const body = new FormData();
                body.append('idProducto', document.getElementById('editIdProducto').value);
                body.append('estado', desiredState);
                body.append('__RequestVerificationToken', antiforgery(form));
                updatingState = true;
                event.target.disabled = true;
                try {
                    const response = await fetch('@Url.Action("CambiarEstadoProducto", "Inventario")', { method: 'POST', body });
                    const data = await readJsonResponse(response);
                    if (!response.ok || !data.success) throw new Error(data.message || 'No fue posible cambiar el estado.');
                    currentProductState = desiredState;
                    updateStateBadge();
                    showAlert(data.message, 'success');
                } catch (error) {
                    event.target.checked = currentProductState;
                    showAlert(error.message);
                } finally {
                    event.target.disabled = false;
                    updatingState = false;
                }
            });

            async function submitPanelForm(form, button) {
                const isMovementForm = form.id === 'movementForm';
                const messageTarget = isMovementForm ? movementAlert : alertBox;

                clearAlert(messageTarget);
                if (!form.reportValidity()) return;

                button.disabled = true;
                if (form.id === 'editProductForm') {
                    syncCurrencyFields();
                }

                const original = button.innerHTML;
                button.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Procesando...';

                try {
                    const response = await fetch(form.action, {
                        method: 'POST',
                        body: new FormData(form)
                    });
                    const data = await readJsonResponse(response);

                    if (!response.ok || !data.success) {
                        throw new Error(data.message || 'No fue posible completar la operación.');
                    }

                    showAlert(data.message, 'success', messageTarget);

                    if (isMovementForm) {
                        // Limpiar solo los datos del movimiento y conservar el producto seleccionado.
                        const productId = document.getElementById('movementIdProducto').value;
                        document.getElementById('movementQuantity').value = '';
                        document.getElementById('movementReference').value = '';
                        document.getElementById('movementObservations').value = '';
                        document.getElementById('movementIdProducto').value = productId;
                        window.setTimeout(() => window.location.reload(), 1200);
                    } else {
                        window.setTimeout(() => window.location.reload(), 700);
                    }
                } catch (error) {
                    showAlert(error.message, 'danger', messageTarget);
                } finally {
                    button.disabled = false;
                    button.innerHTML = original;
                }
            }

            document.getElementById('editProductForm').addEventListener('submit', event => {
                event.preventDefault();
                submitPanelForm(event.currentTarget, document.getElementById('saveProductButton'));
            });
            const movementQuantity = document.getElementById('movementQuantity');
            movementQuantity.addEventListener('input', () => {
                movementQuantity.value = movementQuantity.value.replace(/\D/g, '');
            });

            document.getElementById('movementForm').addEventListener('submit', event => {
                event.preventDefault();
                if (!Number.isInteger(Number(movementQuantity.value)) || Number(movementQuantity.value) < 1) {
                    movementQuantity.setCustomValidity('La cantidad debe ser un número entero mayor que cero.');
                    movementQuantity.reportValidity();
                    movementQuantity.setCustomValidity('');
                    return;
                }
                submitPanelForm(event.currentTarget, document.getElementById('saveMovementButton'));
            });
        })();
    </script>

    <!-- Paginación del listado -->
<script>
    document.addEventListener("DOMContentLoaded", function () {
        const table = document.querySelector(".inventory-table");
        if (!table) return;

        const tbody = table.querySelector("tbody");
        const rows = Array.from(tbody.querySelectorAll("tr.inventory-data-row"));
        const pageSizeSelect = document.getElementById("inventoryPageSize");
        const paginationInfo = document.getElementById("inventoryPaginationInfo");
        const recordCount = document.getElementById("inventoryRecordCount");
        const buttonsContainer = document.getElementById("inventoryPaginationButtons");

        if (!pageSizeSelect || !paginationInfo || !buttonsContainer) return;

        let currentPage = 1;
        let pageSize = parseInt(pageSizeSelect.value, 10) || 10;

        function createPageButton(label, page, disabled, active, ariaLabel) {
            const li = document.createElement("li");
            li.className = "page-item" + (disabled ? " disabled" : "") + (active ? " active" : "");

            const button = document.createElement("button");
            button.type = "button";
            button.className = "page-link";
            button.textContent = label;
            if (ariaLabel) button.setAttribute("aria-label", ariaLabel);
            if (active) button.setAttribute("aria-current", "page");
            button.disabled = disabled;
            button.addEventListener("click", function () {
                currentPage = page;
                renderPagination();
            });

            li.appendChild(button);
            buttonsContainer.appendChild(li);
        }

        function renderPagination() {
            const total = rows.length;
            const totalPages = Math.max(1, Math.ceil(total / pageSize));
            currentPage = Math.min(Math.max(1, currentPage), totalPages);

            const startIndex = total === 0 ? 0 : (currentPage - 1) * pageSize;
            const endIndex = Math.min(startIndex + pageSize, total);

            rows.forEach(function (row, index) {
                row.style.display = index >= startIndex && index < endIndex ? "" : "none";
            });

            paginationInfo.textContent = total === 0
                ? "No hay productos para mostrar"
                : "Mostrando " + (startIndex + 1) + "–" + endIndex + " de " + total + " productos";

            if (recordCount) {
                recordCount.textContent = total + " producto(s) en esta consulta";
            }

            buttonsContainer.replaceChildren();
            createPageButton("«", Math.max(1, currentPage - 1), currentPage === 1, false, "Página anterior");

            const maxVisible = 5;
            let firstPage = Math.max(1, currentPage - Math.floor(maxVisible / 2));
            let lastPage = Math.min(totalPages, firstPage + maxVisible - 1);
            firstPage = Math.max(1, lastPage - maxVisible + 1);

            for (let page = firstPage; page <= lastPage; page++) {
                createPageButton(String(page), page, false, page === currentPage, "Página " + page);
            }

            createPageButton("»", Math.min(totalPages, currentPage + 1), currentPage === totalPages || total === 0, false, "Página siguiente");
        }

        pageSizeSelect.addEventListener("change", function () {
            pageSize = parseInt(this.value, 10) || 10;
            currentPage = 1;
            renderPagination();
        });

        renderPagination();
    });
</script>

}
