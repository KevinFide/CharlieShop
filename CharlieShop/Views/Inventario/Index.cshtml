@{
    ViewData["Title"] = "Inventario";
}

<div class="d-flex justify-content-between align-items-start mb-3">

    <div>

        <div class="page-title">
            Inventario
        </div>

        <div class="page-subtitle">
            Control de existencias y movimientos de productos.
        </div>

    </div>

    <div>

        <button class="btn btn-outline-primary me-2">
            <i class="bi bi-box-arrow-in-down me-1"></i>
            Entrada
        </button>

        <button class="btn btn-primary">
            <i class="bi bi-box-arrow-up me-1"></i>
            Salida
        </button>

    </div>

</div>


<!-- RESUMEN -->

<div class="row g-3 mb-4">

    <div class="col-md-4">

        <div class="card metric">

            <div class="label">
                Productos registrados
            </div>

            <div class="value">
                128
            </div>

        </div>

    </div>

    <div class="col-md-4">

        <div class="card metric">

            <div class="label">
                Stock bajo
            </div>

            <div class="value text-warning">
                5
            </div>

        </div>

    </div>

    <div class="col-md-4">

        <div class="card metric">

            <div class="label">
                Sin existencias
            </div>

            <div class="value text-danger">
                2
            </div>

        </div>

    </div>

</div>


<!-- TABLA -->

<div class="card p-4">

    <div class="row mb-3">

        <div class="col-md-5">

            <input type="text"
                   class="form-control"
                   placeholder="Buscar producto..." />

        </div>

        <div class="col-md-3">

            <select class="form-select">

                <option selected>
                    Todos los estados
                </option>

                <option>
                    Disponible
                </option>

                <option>
                    Stock bajo
                </option>

                <option>
                    Sin existencias
                </option>

            </select>

        </div>

    </div>


    <div class="table-responsive">

        <table class="table table-hover align-middle">

            <thead>

                <tr>

                    <th>Código</th>
                    <th>Producto</th>
                    <th>Stock actual</th>
                    <th>Stock mínimo</th>
                    <th>Estado</th>
                    <th>Acciones</th>

                </tr>

            </thead>

            <tbody>

                <tr>

                    <td>
                        P-001
                    </td>

                    <td>
                        Camisa básica
                    </td>

                    <td>
                        24
                    </td>

                    <td>
                        10
                    </td>

                    <td>

                        <span class="badge bg-success">
                            Disponible
                        </span>

                    </td>

                    <td>

                        <button class="btn btn-sm btn-outline-primary">

                            <i class="bi bi-eye"></i>

                        </button>

                    </td>

                </tr>


                <tr>

                    <td>
                        P-002
                    </td>

                    <td>
                        Pantalón jeans
                    </td>

                    <td>
                        8
                    </td>

                    <td>
                        10
                    </td>

                    <td>

                        <span class="badge bg-warning text-dark">
                            Stock bajo
                        </span>

                    </td>

                    <td>

                        <button class="btn btn-sm btn-outline-primary">

                            <i class="bi bi-eye"></i>

                        </button>

                    </td>

                </tr>


                <tr>

                    <td>
                        P-003
                    </td>

                    <td>
                        Gorra
                    </td>

                    <td>
                        4
                    </td>

                    <td>
                        8
                    </td>

                    <td>

                        <span class="badge bg-warning text-dark">
                            Stock bajo
                        </span>

                    </td>

                    <td>

                        <button class="btn btn-sm btn-outline-primary">

                            <i class="bi bi-eye"></i>

                        </button>

                    </td>

                </tr>


                <tr>

                    <td>
                        P-004
                    </td>

                    <td>
                        Zapatos deportivos
                    </td>

                    <td>
                        0
                    </td>

                    <td>
                        5
                    </td>

                    <td>

                        <span class="badge bg-danger">
                            Sin existencias
                        </span>

                    </td>

                    <td>

                        <button class="btn btn-sm btn-outline-primary">

                            <i class="bi bi-eye"></i>

                        </button>

                    </td>

                </tr>

            </tbody>

        </table>

    </div>

</div>