@model CharlieShop.Models.InventarioIndexViewModel

@{
    ViewData["Title"] = "Inventario";
    var estadoActual = string.IsNullOrWhiteSpace(Model.Estado)
        ? "TODOS"
        : Model.Estado;
    ViewData["Breadcrumbs"] = new List<(string Texto, string? Controlador, string? Accion)>
{
    ("Inventario", null, null)
};
}

<div class="inventory-page">

    <div class="inventory-header">
        <div class="inventory-header-info">
            <div class="inventory-page-icon">
                <i class="bi bi-boxes"></i>
            </div>
            <div>
                <h1>Inventario</h1>
                <p>Control de existencias y movimientos de productos.</p>
            </div>
        </div>

        <div class="inventory-header-actions">
            <a asp-action="Historial" class="btn btn-outline-dark">
                <i class="bi bi-clock-history me-1"></i> Historial de Movimientos
            </a>
            <a asp-controller="Inventario"
               asp-action="Crear"
               class="btn btn-dark">
                <i class="bi bi-plus-lg me-1"></i>
                Nuevo producto
            </a>
        </div>
    </div>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-warning">
            @foreach (var error in ViewData.ModelState.Values
                .SelectMany(v => v.Errors))
            {
                <div>@error.ErrorMessage</div>
            }
        </div>
    }

    <!-- RESUMEN -->
    <div class="row g-3 inventory-summary">
        <div class="col-xl-4 col-md-4">
            <div class="inventory-metric-card">
                <div>
                    <span class="metric-label">Productos registrados</span>
                    <h2 class="metric-value">@Model.TotalProductos</h2>
                    <span class="metric-description">
                        Productos activos en el catálogo
                    </span>
                </div>
                <div class="metric-icon metric-icon-dark">
                    <i class="bi bi-box-seam"></i>
                </div>
            </div>
        </div>

        <div class="col-xl-4 col-md-4">
            <div class="inventory-metric-card">
                <div>
                    <span class="metric-label">Stock bajo</span>
                    <h2 class="metric-value metric-warning">
                        @Model.TotalStockBajo
                    </h2>
                    <span class="metric-description">Requieren revisión</span>
                </div>
                <div class="metric-icon metric-icon-warning">
                    <i class="bi bi-exclamation-triangle"></i>
                </div>
            </div>
        </div>

        <div class="col-xl-4 col-md-4">
            <div class="inventory-metric-card">
                <div>
                    <span class="metric-label">Sin existencias</span>
                    <h2 class="metric-value metric-danger">
                        @Model.TotalAgotados
                    </h2>
                    <span class="metric-description">Stock en cero</span>
                </div>
                <div class="metric-icon metric-icon-danger">
                    <i class="bi bi-box-seam"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- LISTADO -->
    <div class="inventory-content-card">
        <div class="inventory-card-header">
            <div>
                <h2>Existencias de productos</h2>
                <p>Consulta el stock disponible y detecta necesidades de reposición.</p>
            </div>
            <span class="inventory-record-count" id="inventoryRecordCount">
                @(Model.Productos?.Count ?? 0) producto(s) en esta consulta
            </span>
        </div>

        <!-- BÚSQUEDA Y FILTROS -->
        <div class="inventory-filters">
            <form asp-action="Index" method="get">
                <div class="row g-3">
                    <div class="col-lg-5 col-md-6">
                        <label for="searchProduct" class="filter-label">
                            Buscar producto
                        </label>
                        <div class="inventory-search">
                            <i class="bi bi-search"></i>
                            <input id="searchProduct"
                                   name="busqueda"
                                   type="search"
                                   class="form-control"
                                   value="@Model.Busqueda"
                                   placeholder="Buscar por nombre o código..." />
                        </div>
                    </div>

                    <div class="col-lg-3 col-md-6">
                        <label for="filterStatus" class="filter-label">
                            Estado del inventario
                        </label>
                        <select id="filterStatus" name="estado"
                                class="form-select">
                            <option value="TODOS"
                                    selected="@(estadoActual == "TODOS")">
                                Todos los estados
                            </option>
                            <option value="NORMAL"
                                    selected="@(estadoActual == "NORMAL")">
                                Disponible
                            </option>
                            <option value="BAJO"
                                    selected="@(estadoActual == "BAJO")">
                                Stock bajo
                            </option>
                            <option value="AGOTADO"
                                    selected="@(estadoActual == "AGOTADO")">
                                Sin existencias
                            </option>
                        </select>
                    </div>

                    <div class="col-lg-4 d-flex align-items-end gap-2">
                        <button type="submit" class="btn btn-dark"
                                style="min-height:43px;border-radius:9px;">
                            <i class="bi bi-search me-1"></i> Buscar
                        </button>
                        <a asp-action="Index" class="btn btn-filter-reset">
                            <i class="bi bi-arrow-counterclockwise me-1"></i>
                            Limpiar filtros
                        </a>
                    </div>
                </div>
            </form>
        </div>

        <!-- TABLA -->
        <div class="table-responsive">
            <table class="table inventory-table align-middle mb-0">
                <thead>
                    <tr>
                        <th>Producto</th>
                        <th>Categoría</th>
                        <th>Precio de venta</th>
                        <th>Stock actual</th>
                        <th>Estado</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model.Productos != null && Model.Productos.Any())
                    {
                        foreach (var producto in Model.Productos)
                        {
                            var agotado = producto.StockActual <= 0;
                            var bajo = !agotado &&
                                producto.StockActual <= producto.StockMinimo;

                            var claseStock = agotado
                                ? "stock-number-danger"
                                : bajo ? "stock-number-warning" : "stock-number-normal";

                            var claseEstado = agotado
                                ? "status-out"
                                : bajo ? "status-low" : "status-available";

                            var textoEstado = agotado
                                ? "Sin existencias"
                                : bajo ? "Stock bajo" : "Disponible";

                            <tr class="inventory-data-row">
                                <td>
                                    <div class="inventory-product">
                                        <div class="product-icon">
                                            @if (!string.IsNullOrWhiteSpace(producto.ImagenUrl))
                                            {
                                                <img src="@producto.ImagenUrl"
                                                     alt="@producto.Nombre"
                                                     loading="lazy"
                                                     onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />
                                                <span class="product-image-fallback" style="display:none;">
                                                    <i class="bi bi-box-seam"></i>
                                                </span>
                                            }
                                            else
                                            {
                                                <i class="bi bi-box-seam"></i>
                                            }
                                        </div>
                                        <div>
                                            <div class="product-name">
                                                @producto.Nombre
                                            </div>
                                            <div class="product-code">
                                                @producto.Codigo
                                            </div>
                                        </div>
                                    </div>
                                </td>

                                <td>
                                    @(string.IsNullOrWhiteSpace(producto.Categoria)
                                        ? "Sin categoría"
                                        : producto.Categoria)
                                </td>

                                <td>
                                    <span class="inventory-price">
                                        ₡ @producto.PrecioVenta.ToString("#,##0.00", System.Globalization.CultureInfo.InvariantCulture)
                                    </span>
                                </td>

                                <td>
                                    <span class="stock-number @claseStock">
                                        @producto.StockActual.ToString("0.##")
                                    </span>
                                </td>

                                <td>
                                    <span class="inventory-status @claseEstado">
                                        <span class="status-dot"></span>
                                        @textoEstado
                                    </span>
                                </td>

                                <td>
                                    <div class="inventory-actions">
                                        <button type="button"
                                                class="action-button btn-open-product"
                                                data-product-id="@producto.IdProducto"
                                                title="Editar producto y registrar movimiento"
                                                aria-label="Editar producto y registrar movimiento">
                                            <i class="bi bi-pencil-square"></i>
                                        </button>

                                        <button type="button"
                                                class="action-button action-button-delete btn-delete-product"
                                                data-product-id="@producto.IdProducto"
                                                data-product-code="@producto.Codigo"
                                                data-product-name="@producto.Nombre"
                                                title="Eliminar producto"
                                                aria-label="Eliminar producto">
                                            <i class="bi bi-trash3"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6">
                                <div class="inventory-empty">
                                    <div class="empty-state-icon">
                                        <i class="bi bi-search"></i>
                                    </div>
                                    <h3>No se encontraron productos</h3>
                                    <p>
                                        Probá con otro nombre, código o estado
                                        del inventario.
                                    </p>
                                    <a asp-action="Index"
                                       class="btn btn-outline-dark mt-3">
                                        Limpiar filtros
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="inventory-pagination">
            <div class="pagination-info" id="inventoryPaginationInfo">
                Mostrando 0 productos
            </div>
            <div class="inventory-pagination-controls">
                <label for="inventoryPageSize">Mostrar</label>
                <select id="inventoryPageSize" class="form-select form-select-sm">
                    <option value="10" selected>10</option>
                    <option value="20">20</option>
                    <option value="50">50</option>
                </select>
                <span class="pagination-info">por página</span>
                <nav aria-label="Paginación de inventario">
                    <ul class="pagination pagination-sm mb-0" id="inventoryPaginationButtons"></ul>
                </nav>
            </div>
        </div>
    </div>
</div>

<!-- PANEL LATERAL: EDICIÓN Y MOVIMIENTOS -->
<div class="offcanvas offcanvas-end inventory-offcanvas" tabindex="-1" id="productEditorPanel"
     aria-labelledby="productEditorTitle" data-bs-backdrop="true" data-bs-scroll="false">
    <div class="offcanvas-header border-bottom">
        <div>
            <h5 class="offcanvas-title fw-bold" id="productEditorTitle">Editar producto</h5>
            <small class="text-muted" id="panelProductSubtitle">Información y movimientos de inventario</small>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Cerrar"></button>
    </div>

    <div class="offcanvas-body">
        <div id="panelAlert" class="alert d-none" role="alert"></div>
        <div id="panelLoading" class="text-center py-5">
            <div class="spinner-border spinner-border-sm" role="status"></div>
            <span class="ms-2">Cargando producto...</span>
        </div>

        <div id="panelContent" class="d-none">
            <section class="panel-section">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h6 class="fw-bold mb-0"><i class="bi bi-box-seam me-2"></i>Datos del producto</h6>
                    <span id="panelStatusBadge" class="badge rounded-pill"></span>
                </div>
                <form id="editProductForm" method="post" action="@Url.Action("GuardarEdicion", "Inventario")">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="IdProducto" id="editIdProducto" />
                    <div class="mb-3">
                        <label class="form-label" for="editCodigo">Código</label>
                        <input class="form-control" id="editCodigo" name="Codigo" maxlength="50" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="editNombre">Nombre del producto</label>
                        <input class="form-control" id="editNombre" name="Nombre" maxlength="150" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="editDescripcion">Descripción</label>
                        <textarea class="form-control" id="editDescripcion" name="Descripcion" rows="2"></textarea>
                    </div>
                    <div class="row g-3">
                        <div class="col-6 mb-3">
                            <label class="form-label" for="editCategoria">Categoría</label>
                            <select class="form-select" id="editCategoria" name="Categoria" required>
                                <option value="">Seleccionar categoría</option>
                                @foreach (var categoria in (Model.Productos ?? new List<CharlieShop.Models.InventarioItemViewModel>())
                                    .Select(p => p.Categoria)
                                    .Where(c => !string.IsNullOrWhiteSpace(c))
                                    .Distinct()
                                    .OrderBy(c => c))
                                {
                                    <option value="@categoria">@categoria</option>
                                }
                            </select>
                        </div>
                        <div class="col-6 mb-3">
                            <label class="form-label" for="editUnidadMedida">Unidad de medida</label>
                            <input class="form-control" id="editUnidadMedida" name="UnidadMedida" maxlength="20" />
                        </div>
                        <div class="col-6 mb-3">
                            <label class="form-label" for="editCostoDisplay">Costo</label>
                            <div class="input-group">
                                <span class="input-group-text">₡</span>
                                <input class="form-control currency-display" type="text" id="editCostoDisplay"
                                       inputmode="decimal" autocomplete="off" placeholder="0,00" />
                            </div>
                            <input type="hidden" id="editCosto" name="Costo" value="0" />
                        </div>
                        <div class="col-6 mb-3">
                            <label class="form-label" for="editPrecioVentaDisplay">Precio de venta</label>
                            <div class="input-group">
                                <span class="input-group-text">₡</span>
                                <input class="form-control currency-display" type="text" id="editPrecioVentaDisplay"
                                       inputmode="decimal" autocomplete="off" placeholder="0,00" required />
                            </div>
                            <input type="hidden" id="editPrecioVenta" name="PrecioVenta" value="0" />
                        </div>
                    </div>
                    <div class="d-flex align-items-center justify-content-between border rounded-3 p-3 mb-3">
                        <div>
                            <div class="fw-semibold small">Estado del producto</div>
                            <small class="text-muted">Activar o desactivar en el catálogo</small>
                        </div>
                        <div class="form-check form-switch mb-0">
                            <input class="form-check-input" type="checkbox" role="switch" id="editEstado" />
                        </div>
                    </div>
                    <button type="submit" class="btn btn-dark w-100" id="saveProductButton">
                        <i class="bi bi-check-lg me-1"></i> Guardar cambios
                    </button>
                </form>
            </section>

            <hr class="my-4" />

            <section class="panel-section">
                <h6 class="fw-bold mb-3"><i class="bi bi-arrow-left-right me-2"></i>Registrar movimiento</h6>

                <div class="d-flex align-items-center justify-content-between rounded-3 border bg-light px-3 py-2 mb-3">
                    <span class="small text-muted">Stock actual</span>
                    <div class="d-flex align-items-baseline gap-2">
                        <strong class="fs-5" id="movementCurrentStock">0</strong>
                        <span class="small text-muted" id="movementUnitLabel"></span>
                    </div>
                </div>

                <!-- Los mensajes de registrar movimiento se muestran aquí mismo. -->
                <div id="movementAlert" class="alert d-none" role="alert" aria-live="polite"></div>

                <form id="movementForm" method="post" action="@Url.Action("RegistrarMovimientoPanel", "Inventario")">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="IdProducto" id="movementIdProducto" />
                    <div class="mb-3">
                        <label class="form-label" for="movementType">Tipo de movimiento</label>
                        <select class="form-select" id="movementType" name="TipoMovimiento" required>
                            <option value="ENTRADA">Entrada</option>
                            <option value="SALIDA">Salida</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="movementQuantity">Cantidad</label>
                        <input class="form-control" type="number" id="movementQuantity" name="Cantidad" min="1" step="1" inputmode="numeric" required placeholder="0" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="movementReference">Referencia</label>
                        <input class="form-control" id="movementReference" name="Referencia" maxlength="100" placeholder="Compra, factura o pedido" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="movementObservations">Observaciones</label>
                        <textarea class="form-control" id="movementObservations" name="Observaciones" rows="2" placeholder="Detalles adicionales"></textarea>
                    </div>
                    <button type="submit" class="btn btn-outline-dark w-100" id="saveMovementButton">
                        <i class="bi bi-check-lg me-1"></i> Registrar movimiento
                    </button>
                </form>
            </section>
        </div>
    </div>
</div>



<!-- Modal de confirmación para eliminar producto -->
<div class="modal fade" id="deleteProductModal" tabindex="-1"
     aria-labelledby="deleteProductModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header">
                <h5 class="modal-title" id="deleteProductModalLabel">
                    <i class="bi bi-trash3 text-danger me-2"></i>Eliminar producto
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"
                        aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <p class="mb-2">¿Estás seguro de que deseas eliminar este producto?</p>
                <div class="rounded border bg-light p-3">
                    <div class="fw-semibold" id="deleteProductName"></div>
                    <small class="text-muted" id="deleteProductCode"></small>
                </div>
                <p class="text-muted small mt-3 mb-0">
                    Si el producto tiene ventas o movimientos de inventario asociados,
                    el sistema impedirá su eliminación.
                </p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">
                    Cancelar
                </button>
                <form asp-controller="Inventario" asp-action="EliminarProducto"
                      method="post" id="deleteProductForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" id="deleteProductId" />
                    <input type="hidden" name="nombreProducto" id="deleteProductNameInput" />
                    <button type="submit" class="btn btn-danger" id="confirmDeleteProduct">
                        <i class="bi bi-trash3 me-1"></i>Eliminar
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@{
    var deleteResultType = TempData["EliminarTipo"]?.ToString();
    var deleteResultMessage = TempData["EliminarMensaje"]?.ToString();
    var deleteResultName = TempData["EliminarNombre"]?.ToString();
    var hasDeleteResult = !string.IsNullOrWhiteSpace(deleteResultType);
    var deleteResultIsSuccess = deleteResultType == "success";
    var deleteResultIsWarning = deleteResultType == "warning";
}

@if (hasDeleteResult)
{
    <div class="modal fade" id="deleteResultModal" tabindex="-1"
         aria-labelledby="deleteResultModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow">
                <div class="modal-header">
                    <h5 class="modal-title" id="deleteResultModalLabel">
                        @if (deleteResultIsSuccess)
                        {
                            <i class="bi bi-check-circle-fill text-success me-2"></i>
                            <text>Producto eliminado</text>
                        }
                        else if (deleteResultIsWarning)
                        {
                            <i class="bi bi-exclamation-triangle-fill text-warning me-2"></i>
                            <text>No se puede eliminar</text>
                        }
                        else
                        {
                            <i class="bi bi-x-circle-fill text-danger me-2"></i>
                            <text>No fue posible eliminar</text>
                        }
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"
                            aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                    @if (!string.IsNullOrWhiteSpace(deleteResultName))
                    {
                        <p class="fw-semibold mb-2">@deleteResultName</p>
                    }
                    <p class="mb-0">@deleteResultMessage</p>
                    @if (deleteResultIsWarning)
                    {
                        <div class="alert alert-light border mt-3 mb-0">
                            <i class="bi bi-info-circle me-1"></i>
                            Podés conservar el historial y evitar que el producto siga
                            utilizándose desactivándolo desde la edición del producto.
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-dark" data-bs-dismiss="modal">
                        Entendido
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<style>
    .inventory-price {
        color: #222;
        font-size: 13px;
        font-weight: 600;
        white-space: nowrap;
        font-variant-numeric: tabular-nums;
    }

    .inventory-page {
        max-width: 1450px;
        margin: 0 auto;
    }

    .inventory-breadcrumb {
        display: block !important;
        width: 100%;
        margin: 0 0 22px;
        padding: 0 0 12px;
        border-bottom: 1px solid #e8e8e8;
    }

        .inventory-breadcrumb .breadcrumb {
            display: flex !important;
            align-items: center;
            margin: 0;
            padding: 0;
            background: transparent;
            font-size: 12px;
        }

        .inventory-breadcrumb .breadcrumb-item,
        .inventory-breadcrumb .breadcrumb-item a {
            color: #858585;
            text-decoration: none;
        }

            .inventory-breadcrumb .breadcrumb-item.active {
                color: #222;
                font-weight: 600;
            }

    .inventory-breadcrumb {
        margin-bottom: 18px;
    }

        .inventory-breadcrumb .breadcrumb {
            margin-bottom: 0;
            font-size: 12px;
            color: #888;
        }

        .inventory-breadcrumb .breadcrumb-item + .breadcrumb-item::before {
            color: #aaa;
        }

        .inventory-breadcrumb .breadcrumb-item.active {
            color: #333;
            font-weight: 600;
        }

    .inventory-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        margin-bottom: 28px;
    }

    .inventory-header-info {
        display: flex;
        align-items: center;
        gap: 15px;
    }

    .inventory-page-icon {
        width: 49px;
        height: 49px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 12px;
        background: #111;
        color: #fff;
        font-size: 22px;
    }

    .inventory-header h1 {
        margin: 0;
        color: #111;
        font-size: 26px;
        font-weight: 700;
    }

    .inventory-header p {
        margin: 5px 0 0;
        color: #777;
        font-size: 14px;
    }

    .inventory-header-actions {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 9px;
        flex-wrap: wrap;
    }

        .inventory-header-actions .btn {
            padding: 10px 14px;
            border-radius: 9px;
            font-size: 13px;
            font-weight: 600;
        }

        .inventory-header-actions .btn-dark {
            background: #111;
            border-color: #111;
        }

            .inventory-header-actions .btn-dark:hover {
                background: #303030;
                border-color: #303030;
            }

    .inventory-summary {
        margin-bottom: 25px;
    }

    .inventory-metric-card {
        height: 100%;
        min-height: 132px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 15px;
        padding: 22px;
        background: #fff;
        border: 1px solid #e8e8e8;
