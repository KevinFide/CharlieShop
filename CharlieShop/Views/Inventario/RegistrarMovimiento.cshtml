
@model CharlieShop.Models.RegistrarMovimientoViewModel

@{
    ViewData["Title"] = "Registrar movimiento";
}

<div class="inventory-form-page">
    <div class="page-header">
        <div class="page-heading">
            <div class="page-icon">
                <i class="bi bi-arrow-left-right"></i>
            </div>
            <div>
                <h1>Registrar movimiento</h1>
                <p>Registra las entradas y salidas de productos del inventario.</p>
            </div>
        </div>

        <a asp-action="Index" class="btn btn-outline-dark">
            <i class="bi bi-arrow-left me-1"></i> Volver al inventario
        </a>
    </div>

    @if (TempData["Exito"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show mb-3" role="alert">
            <i class="bi bi-check-circle me-2"></i>@TempData["Exito"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show mb-3" role="alert">
            <i class="bi bi-exclamation-circle me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
        </div>
    }

    <div class="form-card">
        <div class="form-card-header">
            <div>
                <h2>Información del movimiento</h2>
                <p>Seleccioná el tipo de operación y completá los datos del movimiento.</p>
            </div>
            <span class="form-tag" id="movementTag">
                <i class="bi bi-arrow-down-circle me-1" id="movementTagIcon"></i>
                <span id="movementTagText">Entrada de stock</span>
            </span>
        </div>

        <form asp-action="RegistrarMovimiento" method="post">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly"
                 class="validation-summary"></div>

            <div class="form-section">
                <h3>Tipo de movimiento, producto y cantidad</h3>

                <div class="row g-4">
                    <div class="col-md-4">
                        <label asp-for="TipoMovimiento" class="form-label">
                            Tipo de movimiento <span class="required">*</span>
                        </label>
                        <select asp-for="TipoMovimiento" class="form-select" id="TipoMovimiento" required>
                            <option value="ENTRADA">Entrada</option>
                            <option value="SALIDA">Salida</option>
                        </select>
                        <span asp-validation-for="TipoMovimiento" class="field-error"></span>
                    </div>

                    <div class="col-md-5">
                        <label asp-for="IdProducto" class="form-label">
                            Producto <span class="required">*</span>
                        </label>

                        <select asp-for="IdProducto"
                                class="form-select"
                                required>
                            <option value="">Seleccioná un producto</option>

                            @if (Model.Productos != null)
                            {
                                foreach (var producto in Model.Productos)
                                {
                                    <option value="@producto.IdProducto">
                                        @producto.Codigo - @producto.Nombre
                                    </option>
                                }
                            }
                        </select>

                        <span asp-validation-for="IdProducto"
                              class="field-error"></span>
                    </div>

                    <div class="col-md-3">
                        <label asp-for="Cantidad" class="form-label">
                            <span id="cantidadLabel">Cantidad que ingresa</span>
                            <span class="required">*</span>
                        </label>

                        <div class="input-group">
                            <input asp-for="Cantidad"
                                   type="number"
                                   class="form-control"
                                   min="0.01"
                                   step="0.01"
                                   placeholder="0.00"
                                   required />
                            <span class="input-group-text">Unidades</span>
                        </div>

                        <span asp-validation-for="Cantidad"
                              class="field-error"></span>
                    </div>
                </div>
            </div>

            <div class="form-section">
                <h3>Información adicional</h3>

                <div class="row g-4">
                    <div class="col-md-6">
                        <label asp-for="Referencia" class="form-label">
                            Referencia
                        </label>

                        <input asp-for="Referencia"
                               class="form-control"
                               maxlength="100"
                               placeholder="Ej. Compra, factura o pedido" />

                        <span asp-validation-for="Referencia"
                              class="field-error"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Observaciones" class="form-label">
                            Observaciones
                        </label>

                        <textarea asp-for="Observaciones"
                                  class="form-control"
                                  rows="3"
                                  placeholder="Detalles adicionales de la entrada"></textarea>

                        <span asp-validation-for="Observaciones"
                              class="field-error"></span>
                    </div>
                </div>
            </div>

            <div class="form-note">
                <i class="bi bi-info-circle"></i>
                <span>
                    Al confirmar, se actualizarán las existencias del producto
                    y se registrará el movimiento en el historial.
                </span>
            </div>

            <div class="form-actions">
                <a asp-action="Index" class="btn btn-light">
                    Cancelar
                </a>
                <button type="submit" class="btn btn-dark">
                    <i class="bi bi-check-lg me-1"></i>
                    Registrar movimiento
                </button>
            </div>
        </form>
    </div>
</div>

<style>
    .inventory-form-page {
        max-width: 1100px;
        margin: 0 auto;
    }

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        margin-bottom: 28px;
    }

    .page-heading {
        display: flex;
        align-items: center;
        gap: 15px;
    }

    .page-icon {
        width: 49px;
        height: 49px;
        display: flex;
        flex-shrink: 0;
        align-items: center;
        justify-content: center;
        border-radius: 12px;
        background: #111;
        color: white;
        font-size: 21px;
    }

    .page-heading h1 {
        margin: 0;
        font-size: 25px;
        font-weight: 700;
        color: #111;
    }

    .page-heading p {
        margin: 5px 0 0;
        color: #777;
        font-size: 14px;
    }

    .page-header > .btn {
        padding: 10px 14px;
        border-radius: 9px;
        font-size: 13px;
    }

    .form-card {
        overflow: hidden;
        background: #fff;
        border: 1px solid #e8e8e8;
        border-radius: 15px;
        box-shadow: 0 3px 14px rgba(0, 0, 0, .025);
    }

    .form-card-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 15px;
        padding: 25px;
        border-bottom: 1px solid #eee;
    }

    .form-card-header h2 {
        margin: 0;
        font-size: 17px;
        font-weight: 700;
        color: #171717;
    }

    .form-card-header p {
        margin: 5px 0 0;
        font-size: 13px;
        color: #858585;
    }

    .form-tag {
        padding: 8px 11px;
        border-radius: 8px;
        background: #eaf7ef;
        color: #267a48;
        font-size: 12px;
        font-weight: 600;
        white-space: nowrap;
    }

    .form-section {
        padding: 25px;
        border-bottom: 1px solid #eee;
    }

    .form-section h3 {
        margin: 0 0 22px;
        font-size: 14px;
        font-weight: 700;
        color: #222;
    }

    .form-label {
        margin-bottom: 8px;
        color: #444;
        font-size: 13px;
        font-weight: 600;
    }

    .required {
        color: #c83c43;
    }

    .form-control,
    .form-select,
    .input-group-text {
        min-height: 44px;
        border-color: #dedede;
        border-radius: 9px;
        font-size: 13px;
        box-shadow: none;
    }

    .input-group .form-control {
        border-radius: 9px 0 0 9px;
    }

    .input-group-text {
        display: flex;
        align-items: center;
        border-radius: 0 9px 9px 0;
        background: #f8f8f8;
        color: #666;
    }

    textarea.form-control {
        min-height: 95px;
    }

    .form-control:focus,
    .form-select:focus {
        border-color: #777;
        box-shadow: 0 0 0 3px rgba(0, 0, 0, .05);
    }

    .field-error {
        display: block;
        margin-top: 6px;
        color: #c83c43;
        font-size: 12px;
    }

    .validation-summary:empty {
        display: none;
    }

    .validation-summary:not(:empty) {
        margin: 20px 25px 0;
        padding: 12px;
        border-radius: 8px;
        background: #fff0f0;
        color: #b52e37;
        font-size: 13px;
    }

    .form-note {
        display: flex;
        align-items: flex-start;
        gap: 10px;
        margin: 22px 25px 0;
        padding: 14px;
        border: 1px solid #e7e7e7;
        border-radius: 9px;
        background: #fafafa;
        color: #666;
        font-size: 12px;
        line-height: 1.6;
    }

    .form-note i {
        color: #444;
        font-size: 16px;
    }

    .form-actions {
        display: flex;
        justify-content: flex-end;
        gap: 10px;
        padding: 22px 25px;
    }

    .form-actions .btn {
        min-height: 42px;
        padding: 10px 17px;
        border-radius: 9px;
        font-size: 13px;
        font-weight: 600;
    }

    .form-actions .btn-dark {
        background: #111;
        border-color: #111;
    }

    @@media (max-width: 767px) {
        .page-header {
            align-items: flex-start;
            flex-direction: column;
        }

        .form-card-header {
            align-items: flex-start;
            flex-direction: column;
        }

        .form-section {
            padding: 20px;
        }

        .form-actions {
            flex-direction: column-reverse;
            padding: 20px;
        }

        .form-actions .btn {
            width: 100%;
        }
    }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const tipoMovimiento = document.getElementById("TipoMovimiento");
            const cantidadLabel = document.getElementById("cantidadLabel");
            const movementTag = document.getElementById("movementTag");
            const movementTagIcon = document.getElementById("movementTagIcon");
            const movementTagText = document.getElementById("movementTagText");

            function actualizarTipoMovimiento() {
                const esEntrada = tipoMovimiento.value === "ENTRADA";

                cantidadLabel.textContent = esEntrada
                    ? "Cantidad que ingresa"
                    : "Cantidad que sale";

                movementTagText.textContent = esEntrada
                    ? "Entrada de stock"
                    : "Salida de stock";

                movementTagIcon.className = esEntrada
                    ? "bi bi-arrow-down-circle me-1"
                    : "bi bi-arrow-up-circle me-1";

                movementTag.style.background = esEntrada ? "#eaf7ef" : "#fff0f0";
                movementTag.style.color = esEntrada ? "#267a48" : "#b52e37";
            }

            tipoMovimiento.addEventListener("change", actualizarTipoMovimiento);
            actualizarTipoMovimiento();
        });
    </script>
}
