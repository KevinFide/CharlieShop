@model CharlieShop.Models.CrearProductoViewModel

@{
    ViewData["Title"] = "Registrar producto";

    ViewData["Breadcrumbs"] = new List<(string Texto, string? Controlador, string? Accion)>
    {
        ("Inventario", "Inventario", "Index"),
        ("Nuevo producto", null, null)
    };
}

<div class="product-create-page">
    <div class="page-heading">
        <div class="page-heading-main">
            <a asp-action="Index" class="back-link">
                <i class="bi bi-arrow-left"></i>
                <span>Volver a productos</span>
            </a>
            <div class="heading-title-row">
                <div class="heading-icon"><i class="bi bi-box-seam"></i></div>
                <div>
                    <h1>Registrar producto</h1>
                    <p>Incorporá un nuevo artículo al catálogo de Charlie Shop.</p>
                </div>
            </div>
        </div>
        <span class="heading-status"><span class="status-dot"></span> Nuevo registro</span>
    </div>

    <form asp-action="Crear" method="post" enctype="multipart/form-data" id="productCreateForm" novalidate>
        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

        <div class="form-layout">
            <main class="form-main">
                <section class="form-card">
                    <div class="section-heading">
                        <div class="section-heading-icon"><i class="bi bi-card-list"></i></div>
                        <div>
                            <h2>Información general</h2>
                            <p>Datos que identifican y describen el producto.</p>
                        </div>
                    </div>

                    <div class="form-grid">
                        <div class="field-group">
                            <label asp-for="Codigo" class="form-label">Código <span class="required">*</span></label>
                            <input asp-for="Codigo" class="form-control" placeholder="Ej. P-014" autocomplete="off" />
                            <span asp-validation-for="Codigo" class="field-error"></span>
                        </div>

                        <div class="field-group field-span-2">
                            <label asp-for="Nombre" class="form-label">Nombre del producto <span class="required">*</span></label>
                            <input asp-for="Nombre" class="form-control" placeholder="Ej. Bolso casual negro" />
                            <span asp-validation-for="Nombre" class="field-error"></span>
                        </div>

                        <div class="field-group">
                            <label asp-for="Categoria" class="form-label">Categoría</label>
                            <div class="field-with-icon">
                                <i class="bi bi-tag"></i>
                                <input asp-for="Categoria" class="form-control" placeholder="Ej. Accesorios" />
                            </div>
                            <span asp-validation-for="Categoria" class="field-error"></span>
                        </div>

                        <div class="field-group">
                            <label asp-for="UnidadMedida" class="form-label">Unidad de medida</label>
                            <div class="field-with-icon">
                                <i class="bi bi-rulers"></i>
                                <input asp-for="UnidadMedida" class="form-control" placeholder="Ej. Unidad, par" />
                            </div>
                            <span asp-validation-for="UnidadMedida" class="field-error"></span>
                        </div>

                        <div class="field-group field-span-2">
                            <label asp-for="Descripcion" class="form-label">Descripción</label>
                            <textarea asp-for="Descripcion" class="form-control description-input" rows="4"
                                      placeholder="Agregá detalles, características o información relevante del producto..."></textarea>
                            <span asp-validation-for="Descripcion" class="field-error"></span>
                            <small class="field-hint">Una descripción clara ayuda a identificar el producto en el catálogo.</small>
                        </div>
                    </div>
                </section>

                <section class="form-card">
                    <div class="section-heading">
                        <div class="section-heading-icon"><i class="bi bi-currency-exchange"></i></div>
                        <div>
                            <h2>Precios</h2>
                            <p>Definí el precio de venta y el costo del producto.</p>
                        </div>
                    </div>

                    <div class="form-grid price-grid">
                        <div class="field-group">
                            <label asp-for="PrecioVenta" class="form-label">Precio de venta <span class="required">*</span></label>
                            <div class="money-input">
                                <span>₡</span>
                                <input asp-for="PrecioVenta" class="form-control" type="number" min="0" step="0.01" placeholder="0.00" />
                            </div>
                            <span asp-validation-for="PrecioVenta" class="field-error"></span>
                            <small class="field-hint">Precio al que se ofrecerá al cliente.</small>
                        </div>

                        <div class="field-group">
                            <label asp-for="Costo" class="form-label">Costo del producto</label>
                            <div class="money-input">
                                <span>₡</span>
                                <input asp-for="Costo" class="form-control" type="number" min="0" step="0.01" placeholder="0.00" />
                            </div>
                            <span asp-validation-for="Costo" class="field-error"></span>
                            <small class="field-hint">Costo de adquisición del producto.</small>
                        </div>
                    </div>
                </section>

                <section class="form-card">
                    <div class="section-heading">
                        <div class="section-heading-icon"><i class="bi bi-boxes"></i></div>
                        <div>
                            <h2>Inventario inicial</h2>
                            <p>Definí las existencias con las que inicia el producto.</p>
                        </div>
                    </div>

                    <div class="field-group">
                        <label asp-for="StockInicial" class="form-label">Cantidad inicial</label>
                        <input asp-for="StockInicial"
                               class="form-control"
                               type="number"
                               min="0"
                               step="0.01"
                               placeholder="0" />
                        <span asp-validation-for="StockInicial" class="field-error"></span>
                        <small class="field-hint">
                            Podés registrar el producto sin existencias. Si ingresás una cantidad mayor que cero,
                            se guardará como una entrada inicial en el historial.
                        </small>
                    </div>
                </section>

            </main>

            <aside class="form-sidebar">
                <section class="form-card image-card">
                    <div class="section-heading">
                        <div class="section-heading-icon"><i class="bi bi-image"></i></div>
                        <div>
                            <h2>Imagen del producto</h2>
                            <p>Una fotografía ayuda a reconocerlo.</p>
                        </div>
                    </div>

                    <div class="image-preview" id="productImagePreview">
                        <div class="image-placeholder">
                            <i class="bi bi-image"></i>
                            <strong>Vista previa</strong>
                            <span>La imagen aparecerá aquí</span>
                        </div>
                    </div>

                    <div class="product-image-upload" id="productImageUpload">
                        <input type="file" id="ImagenArchivo" name="ImagenArchivo" class="product-image-input"
                               accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" />
                        <label for="ImagenArchivo" class="upload-button">
                            <i class="bi bi-cloud-arrow-up"></i>
                            <span>Seleccionar imagen</span>
                        </label>
                    </div>

                    <div class="image-file-info" id="productImageFileInfo" aria-live="polite">
                        No se ha seleccionado ninguna imagen.
                    </div>
                    <div class="image-error" id="productImageError" role="alert"></div>

                    <button type="button" class="remove-image-button" id="removeProductImage" hidden>
                        <i class="bi bi-trash3"></i> Quitar imagen
                    </button>

                    <div class="image-guidelines">
                        <i class="bi bi-info-circle"></i>
                        <span>Opcional · JPG, PNG o WEBP · Máximo 5 MB</span>
                    </div>
                </section>

                <div class="sidebar-tip">
                    <i class="bi bi-lightbulb"></i>
                    <div>
                        <strong>Antes de guardar</strong>
                        <p>Verificá el código, el nombre y los precios. Podés agregar una imagen ahora o hacerlo posteriormente.</p>
                    </div>
                </div>
            </aside>
        </div>

        <div class="form-footer">
            <div class="required-note"><span class="required">*</span> Campos obligatorios</div>
            <div class="form-actions">
                <a asp-action="Index" class="btn-cancel">Cancelar</a>
                <button type="submit" class="btn-submit">
                    <i class="bi bi-check2"></i>
                    Registrar producto
                </button>
            </div>
        </div>
    </form>
</div>

<style>
    .product-create-page {
        --ink: #20242b;
        --muted: #737b87;
        --line: #e8ebef;
        --surface: #ffffff;
        --soft: #f7f8fa;
        max-width: 1240px;
        margin: 0 auto;
        padding: 4px 0 30px;
        color: var(--ink);
    }

    .page-heading {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        gap: 20px;
        margin-bottom: 24px;
    }

    .back-link {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 15px;
        color: #737b87;
        font-size: 12px;
        font-weight: 600;
        text-decoration: none;
        transition: color .2s ease;
    }

    .back-link:hover { color: #17191d; }

    .heading-title-row {
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .heading-icon {
        display: grid;
        place-items: center;
        width: 48px;
        height: 48px;
        flex: 0 0 48px;
        border-radius: 13px;
        background: #20242b;
        color: #fff;
        font-size: 20px;
    }

    .heading-title-row h1 {
        margin: 0;
        color: #20242b;
        font-size: 25px;
        font-weight: 750;
        letter-spacing: -.6px;
    }

    .heading-title-row p {
        margin: 5px 0 0;
        color: var(--muted);
        font-size: 13px;
    }

    .heading-status {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 8px 12px;
        border: 1px solid var(--line);
        border-radius: 30px;
        background: #fff;
        color: #626a75;
        font-size: 11px;
        font-weight: 650;
        white-space: nowrap;
    }

    .status-dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: #2e9d68;
    }

    .form-layout {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 330px;
        align-items: start;
        gap: 20px;
    }

    .form-main, .form-sidebar {
        display: grid;
        gap: 20px;
        min-width: 0;
    }

    .form-card {
        padding: 24px;
        border: 1px solid var(--line);
        border-radius: 14px;
        background: var(--surface);
        box-shadow: 0 3px 12px rgba(25, 35, 50, .025);
    }

    .section-heading {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 23px;
    }

    .section-heading-icon {
        display: grid;
        place-items: center;
        width: 38px;
        height: 38px;
        flex: 0 0 38px;
        border-radius: 10px;
        background: #f1f3f5;
        color: #343a43;
        font-size: 16px;
    }

    .section-heading h2 {
        margin: 0;
        color: #252a32;
        font-size: 14px;
        font-weight: 750;
    }

    .section-heading p {
        margin: 4px 0 0;
        color: #858d98;
        font-size: 11px;
    }

    .form-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 19px 16px;
    }

    .field-group { min-width: 0; }
    .field-span-2 { grid-column: span 2; }

    .product-create-page .form-label {
        display: block;
        margin-bottom: 7px;
        color: #454c56;
        font-size: 11px;
        font-weight: 700;
    }

    .required { color: #d34c54; }

    .product-create-page .form-control {
        width: 100%;
        min-height: 43px;
        padding: 10px 12px;
        border: 1px solid #dfe3e8;
        border-radius: 8px;
        background: #fff;
        color: #252a32;
        font-size: 12px;
        box-shadow: none;
        transition: border-color .2s ease, box-shadow .2s ease;
    }

    .product-create-page .form-control::placeholder { color: #a5abb4; }

    .product-create-page .form-control:focus {
        border-color: #858d98;
        box-shadow: 0 0 0 3px rgba(50, 60, 75, .07);
    }

    .product-create-page textarea.form-control {
        min-height: 105px;
        resize: vertical;
        line-height: 1.55;
    }

    .field-with-icon { position: relative; }
    .field-with-icon > i {
        position: absolute;
        top: 50%;
        left: 12px;
        z-index: 1;
        transform: translateY(-50%);
        color: #9098a3;
        font-size: 13px;
        pointer-events: none;
    }
    .field-with-icon .form-control { padding-left: 35px; }

    .money-input {
        display: flex;
        align-items: stretch;
    }

    .money-input > span {
        display: grid;
        place-items: center;
        width: 42px;
        flex: 0 0 42px;
        border: 1px solid #dfe3e8;
        border-right: 0;
        border-radius: 8px 0 0 8px;
        background: #f7f8fa;
        color: #626a75;
        font-size: 13px;
        font-weight: 700;
    }

    .money-input .form-control { border-radius: 0 8px 8px 0; }

    .field-error {
        display: block;
        margin-top: 5px;
        color: #c83c43;
        font-size: 11px;
    }

    .field-hint {
        display: block;
        margin-top: 6px;
        color: #9299a3;
        font-size: 10px;
        line-height: 1.45;
    }

    .image-card .section-heading { margin-bottom: 17px; }

    .image-preview {
        display: grid;
        place-items: center;
        width: 100%;
        aspect-ratio: 1 / .82;
        overflow: hidden;
        border: 1px dashed #d9dee5;
        border-radius: 11px;
        background: #f8f9fb;
    }

    .image-preview img {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: contain;
    }

    .image-placeholder {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 7px;
        padding: 15px;
        color: #9aa1ab;
        text-align: center;
    }

    .image-placeholder i { font-size: 30px; }
    .image-placeholder strong { color: #68717d; font-size: 11px; }
    .image-placeholder span { font-size: 10px; }

    .product-image-upload { margin-top: 13px; }

    .product-image-input {
        position: absolute;
        width: 1px;
        height: 1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
    }

    .upload-button {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 8px;
        width: 100%;
        min-height: 42px;
        margin: 0;
        padding: 10px 12px;
        border: 1px solid #dfe3e8;
        border-radius: 8px;
        background: #fff;
        color: #343a43;
        font-size: 11px;
        font-weight: 700;
        cursor: pointer;
        transition: background .2s ease, border-color .2s ease;
    }

    .upload-button:hover {
        border-color: #aeb5bf;
        background: #f8f9fa;
    }

    .upload-button i { font-size: 15px; }

    .image-file-info {
        margin-top: 9px;
        color: #858d98;
        font-size: 10px;
        overflow-wrap: anywhere;
        line-height: 1.45;
    }

    .image-error {
        display: none;
        margin-top: 7px;
        color: #c83c43;
        font-size: 11px;
    }

    .remove-image-button {
        width: 100%;
        margin-top: 9px;
        padding: 8px;
        border: 1px solid #f0d8da;
        border-radius: 8px;
        background: #fffafa;
        color: #b34249;
        font-size: 10px;
        font-weight: 650;
    }

    .remove-image-button:hover { background: #fff1f2; }

    .image-guidelines {
        display: flex;
        align-items: flex-start;
        gap: 7px;
        margin-top: 15px;
        padding-top: 13px;
        border-top: 1px solid #edf0f3;
        color: #9299a3;
        font-size: 10px;
        line-height: 1.5;
    }

    .image-guidelines i { color: #707985; }

    .sidebar-tip {
        display: flex;
        gap: 11px;
        padding: 15px;
        border: 1px solid #e8ebef;
        border-radius: 12px;
        background: #f8f9fb;
        color: #69717c;
    }

    .sidebar-tip > i {
        margin-top: 1px;
        color: #515a66;
        font-size: 16px;
    }

    .sidebar-tip strong {
        display: block;
        margin-bottom: 5px;
        color: #3e4650;
        font-size: 11px;
    }

    .sidebar-tip p {
        margin: 0;
        font-size: 10px;
        line-height: 1.55;
    }

    .form-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 15px;
        margin-top: 20px;
        padding: 17px 20px;
        border: 1px solid var(--line);
        border-radius: 12px;
        background: #fff;
    }

    .required-note {
        color: #858d98;
        font-size: 10px;
    }

    .form-actions {
        display: flex;
        align-items: center;
        gap: 9px;
    }

    .btn-cancel, .btn-submit {
        display: inline-flex;
        justify-content: center;
        align-items: center;
        gap: 8px;
        min-height: 40px;
        padding: 9px 16px;
        border-radius: 8px;
        font-size: 11px;
        font-weight: 700;
        text-decoration: none;
        transition: background .2s ease, border-color .2s ease;
    }

    .btn-cancel {
        border: 1px solid #dfe3e8;
        background: #fff;
        color: #555e69;
    }

    .btn-cancel:hover { background: #f7f8fa; color: #252a32; }

    .btn-submit {
        border: 1px solid #20242b;
        background: #20242b;
        color: #fff;
        cursor: pointer;
    }

    .btn-submit:hover {
        border-color: #3a414b;
        background: #3a414b;
        color: #fff;
    }

    .validation-summary:empty { display: none; }

    .validation-summary:not(:empty) {
        margin-bottom: 16px;
        padding: 12px 14px;
        border: 1px solid #f0cfd1;
        border-radius: 9px;
        background: #fff6f6;
        color: #b83d45;
        font-size: 12px;
    }

    .validation-summary ul { margin: 0; padding-left: 18px; }

    @@media (max-width: 991px) {
        .form-layout { grid-template-columns: minmax(0, 1fr) 290px; gap: 15px; }
        .form-card { padding: 20px; }
    }

    @@media (max-width: 767px) {
        .page-heading { align-items: flex-start; flex-direction: column; }
        .heading-status { margin-left: 62px; }
        .heading-title-row h1 { font-size: 22px; }
        .form-layout { grid-template-columns: 1fr; }
        .form-sidebar { grid-row: 1; }
        .image-preview { aspect-ratio: 16 / 9; }
        .form-grid { gap: 16px 12px; }
        .form-footer { align-items: stretch; flex-direction: column; }
        .form-actions { flex-direction: column-reverse; }
        .btn-cancel, .btn-submit { width: 100%; }
    }

    @@media (max-width: 480px) {
        .form-grid { grid-template-columns: 1fr; }
        .field-span-2 { grid-column: span 1; }
        .form-card { padding: 17px; }
        .heading-title-row { align-items: flex-start; }
        .heading-title-row h1 { font-size: 20px; }
        .heading-title-row p { max-width: 250px; line-height: 1.45; }
    }
</style>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        (function () {
            const input = document.getElementById("ImagenArchivo");
            const preview = document.getElementById("productImagePreview");
            const fileInfo = document.getElementById("productImageFileInfo");
            const error = document.getElementById("productImageError");
            const removeButton = document.getElementById("removeProductImage");
            const form = document.getElementById("productCreateForm");
            const maxBytes = 5 * 1024 * 1024;
            const allowedTypes = ["image/jpeg", "image/png", "image/webp"];
            let currentUrl = null;

            function showError(message) {
                error.textContent = message || "";
                error.style.display = message ? "block" : "none";
            }

            function clearPreview() {
                if (currentUrl) {
                    URL.revokeObjectURL(currentUrl);
                    currentUrl = null;
                }

                preview.innerHTML = '<div class="image-placeholder"><i class="bi bi-image"></i><strong>Vista previa</strong><span>La imagen aparecerá aquí</span></div>';
                fileInfo.textContent = "No se ha seleccionado ninguna imagen.";
                removeButton.hidden = true;
            }

            input.addEventListener("change", function () {
                showError("");
                const file = input.files && input.files[0];

                if (!file) {
                    clearPreview();
                    return;
                }

                if (!allowedTypes.includes(file.type)) {
                    input.value = "";
                    clearPreview();
                    showError("Formato no válido. Seleccioná una imagen JPG, PNG o WEBP.");
                    return;
                }

                if (file.size > maxBytes) {
                    input.value = "";
                    clearPreview();
                    showError("La imagen supera los 5 MB permitidos.");
                    return;
                }

                if (currentUrl) URL.revokeObjectURL(currentUrl);
                currentUrl = URL.createObjectURL(file);

                const image = document.createElement("img");
                image.src = currentUrl;
                image.alt = "Vista previa de la imagen del producto";
                preview.replaceChildren(image);

                fileInfo.textContent = file.name + " · " + (file.size / (1024 * 1024)).toFixed(2) + " MB";
                removeButton.hidden = false;
            });

            removeButton.addEventListener("click", function () {
                input.value = "";
                showError("");
                clearPreview();
            });

            form.addEventListener("submit", function (event) {
                const file = input.files && input.files[0];

                if (!file) return;

                if (!allowedTypes.includes(file.type) || file.size > maxBytes) {
                    event.preventDefault();
                    showError("Revisá el formato y el tamaño de la imagen antes de continuar.");
                    input.focus();
                }
            });

            window.addEventListener("beforeunload", function () {
                if (currentUrl) URL.revokeObjectURL(currentUrl);
            });
        })();
    </script>
}
